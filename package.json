{
  "name": "pupwiki",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run hero:audit && npm run images:hero:ci && npm run awin:sync:ci && npm run partners:check && npm run content:normalize:check && npm run content:refresh:check && npm run content:inventory && npm run faq:generate:ci && npm run content:audit:public && npm run images:content:ci && npm run images:enrich:ci && npm run sitemap:generate",
    "build": "node --max-old-space-size=4096 ./node_modules/astro/astro.js build",
    "build:fast": "node --max-old-space-size=4096 ./node_modules/astro/astro.js build",
    "build:ci": "node --max-old-space-size=4096 ./node_modules/astro/astro.js build",
    "build:prod": "npm run build",
    "build:with-images": "npm run images:hero && npm run images:content && npm run images:enrich:force && astro build",
    "build:with-amazon": "npm run build:ci",
    "preview": "astro preview",
    "astro": "astro",
    "hero:audit": "node scripts/audit-hero-system.mjs",
    "awin:sync": "node scripts/sync-awin.mjs",
    "awin:sync:local": "node scripts/sync-awin.mjs",
    "awin:sync:strict": "node scripts/sync-awin.mjs --strict",
    "awin:sync:ci": "node scripts/sync-awin.mjs || echo \"AWIN sync failed or skipped; continuing build with existing AWIN data\"",
    "awin:audit": "node scripts/audit-awin.mjs",
    "awin:audit:strict": "node scripts/audit-awin.mjs --strict",
    "partners:generate": "node scripts/content/generate-awin-partner-pages.mjs --apply",
    "partners:check": "node scripts/content/generate-awin-partner-pages.mjs --check",
    "amazon:audit": "node scripts/audit-amazon-products.mjs",
    "content:clean": "node scripts/content/clean-generated-content.mjs",
    "content:clean:ci": "node scripts/content/clean-generated-content.mjs --ci",
    "content:clean:dry": "node scripts/content/clean-generated-content.mjs --dry-run",
    "content:refresh": "node scripts/content/refresh-generated-posts.mjs --apply",
    "content:refresh:check": "node scripts/content/refresh-generated-posts.mjs",
    "content:normalize": "node scripts/content/normalize-generated-frontmatter.mjs --apply",
    "content:normalize:check": "node scripts/content/normalize-generated-frontmatter.mjs",
    "content:audit:pseo": "node scripts/content/audit-pseo-copy.mjs",
    "content:audit:public": "node scripts/content/audit-public-copy.mjs --strict",
    "content:audit:public:ci": "node scripts/content/audit-public-copy.mjs --ci",
    "design:audit:inline": "node scripts/audit-inline-design.mjs",
    "seo:audit": "node scripts/audit-seo-quality.mjs",
    "seo:audit:json": "node scripts/audit-seo-quality.mjs --json",
    "seo:audit:ci": "node scripts/audit-seo-quality.mjs --json --threshold 300 || true",
    "content:status:sync": "node scripts/content/sync-content-status.mjs --apply --report",
    "content:status:check": "node scripts/content/sync-content-status.mjs --report",
    "content:inventory": "node scripts/content/audit-content-inventory.mjs",
    "content:opportunities": "node scripts/content/audit-content-inventory.mjs",
    "faq:generate": "node scripts/content/generate-faq-pages.mjs --apply",
    "faq:generate:check": "node scripts/content/generate-faq-pages.mjs",
    "faq:generate:ci": "node scripts/content/generate-faq-pages.mjs --apply || echo \"FAQ generation failed or skipped; continuing build with existing FAQ data\"",
    "editorial:generate": "node scripts/content/generate-editorial-posts.mjs --apply",
    "editorial:generate:check": "node scripts/content/generate-editorial-posts.mjs",
    "editorial:generate:force": "node scripts/content/generate-editorial-posts.mjs --apply --force",
    "editorial:import": "node scripts/content/generate-editorial-posts.mjs --apply --only-existing",
    "editorial:scaffold": "node scripts/content/generate-editorial-posts.mjs --apply --only-scaffold",
    "content:generate:pseo:check": "node scripts/content/generate-pseo-opportunity-pages.mjs --mode=clusters --limit=20",
    "content:generate:pseo:ci": "node scripts/content/generate-pseo-opportunity-pages.mjs --mode=all --limit=100 --cluster-limit=20 --breed-limit=400 --apply || echo \"PSEO generation paused/skipped; continuing build with existing reviewed content\"",
    "content:generate:pseo:clusters": "node scripts/content/generate-pseo-opportunity-pages.mjs --mode=clusters --limit=20 --apply",
    "content:generate:pseo:breed-pages": "node scripts/content/generate-pseo-opportunity-pages.mjs --mode=breed-pages --limit=3000 --apply",
    "content:generate:pseo": "node scripts/content/generate-pseo-opportunity-pages.mjs --mode=all --limit=1000 --apply",
    "analytics:audit": "node scripts/analytics/audit-traffic.mjs --all",
    "analytics:audit:cf": "node scripts/analytics/audit-traffic.mjs --cloudflare",
    "analytics:audit:ga4": "node scripts/analytics/audit-traffic.mjs --ga4",
    "sitemap:generate": "node generate-sitemap.mjs",
    "affiliate:sync": "npm run awin:sync && npm run partners:generate",
    "images:hero": "node scripts/enrich-home-hero-images.mjs",
    "images:hero:ci": "node scripts/enrich-home-hero-images.mjs || echo \"Homepage hero image enrichment failed or skipped; continuing build with existing hero images\"",
    "images:content": "node scripts/enrich-content-images.mjs --apply --limit 120",
    "images:content:force": "node scripts/enrich-content-images.mjs --apply --force --limit 120",
    "images:content:ci": "node scripts/enrich-content-images.mjs --apply --limit 200 || echo \"Pexels content image enrichment failed or skipped; continuing build with existing images\"",
    "images:enrich": "node scripts/enrich-breed-image-gallery.mjs --force --count 5",
    "images:enrich:ci": "node scripts/enrich-breed-image-gallery.mjs --count 5 || echo \"Image enrichment failed; continuing build with existing image data\"",
    "images:enrich:breeds": "node scripts/enrich-breed-image-gallery.mjs --target breeds --force --count 5",
    "images:enrich:crossbreeds": "node scripts/enrich-breed-image-gallery.mjs --target crossbreeds --force --count 5",
    "images:enrich:pexels-only": "node scripts/enrich-breed-image-gallery.mjs --force --count 5 --pexels-only",
    "images:enrich:dogceo-only": "node scripts/enrich-breed-image-gallery.mjs --force --count 5 --dogceo-only",
    "images:enrich:mixed": "node scripts/enrich-breed-image-gallery.mjs --target crossbreeds --force --count 5",
    "images:enrich:slug": "node scripts/enrich-breed-image-gallery.mjs --force --count 5 --slug"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.7",
    "@astrojs/sitemap": "^3.1.6",
    "@astrojs/tailwind": "^5.1.0",
    "astro": "^4.15.0",
    "tailwindcss": "^3.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.9.3"
  }
}
