---
import { SITE_LOGO, SITE_NAME, SITE_NAV_TAGLINE } from '../../lib/site-config';
import { MOBILE_NAV_GROUPS, PRIMARY_CTA } from '../../lib/navigation/siteMap';

const currentPath = Astro.url.pathname;

const primaryNav = [
  { label: 'All Breeds', href: '/breeds' },
  { label: 'Dog Names',  href: '/dog-names' },
  { label: 'Guides',     href: '/guides' },
  { label: 'Reviews',    href: '/reviews' },
  { label: 'FAQ',        href: '/faq' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<header class="site-header" data-header-version="2026-refactor-a2">
  <div class="container">
    <div class="site-header__inner">

      <!-- Brand -->
      <a href="/" class="site-brand" aria-label={`${SITE_NAME} home`}>
        <img
          src={SITE_LOGO}
          alt={SITE_NAME}
          class="site-brand__logo"
          loading="eager"
          decoding="async"
          width="288"
          height="88"
        />
      </a>

      <!-- Desktop navigation -->
      <nav class="site-nav" aria-label="Main navigation">
        {primaryNav.map(link => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class="site-nav__link"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Desktop CTA -->
      <div class="site-header__actions">
        <a
          href={PRIMARY_CTA.href}
          aria-current={isActive(PRIMARY_CTA.href) ? 'page' : undefined}
          class="btn btn--primary btn--sm"
        >
          {PRIMARY_CTA.label}
        </a>
      </div>

      <!-- Mobile toggle -->
      <button
        type="button"
        class="site-header__toggle"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-nav-toggle
      >
        <svg
          class="nav-icon nav-icon--open"
          data-icon-open
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6"  x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg
          class="nav-icon nav-icon--close hidden"
          data-icon-close
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="6" y1="6"  x2="18" y2="18" />
          <line x1="18" y1="6" x2="6"  y2="18" />
        </svg>
        <span class="site-header__toggle-label">Menu</span>
      </button>

    </div>
  </div>

  <!-- Mobile panel -->
  <div id="mobile-nav" class="mobile-panel hidden" data-mobile-nav>
    <div class="container">
      <div class="mobile-panel__inner">

        <div class="mobile-panel__brand-note">
          <p class="mobile-panel__brand-label">{SITE_NAME}</p>
          <p class="mobile-panel__brand-sub">{SITE_NAV_TAGLINE}</p>
        </div>

        <nav class="mobile-panel__nav" aria-label="Mobile navigation">
          {MOBILE_NAV_GROUPS.map(group => (
            <div class="mobile-panel__group">
              <p class="mobile-panel__group-label">{group.label}</p>
              <div class="mobile-panel__group-links">
                {group.links.map(link => (
                  <a
                    href={link.href}
                    aria-current={isActive(link.href) ? 'page' : undefined}
                    class="mobile-panel__link"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </nav>

        <div class="mobile-panel__cta">
          <a href={PRIMARY_CTA.href} class="btn btn--primary mobile-panel__cta-btn">
            {PRIMARY_CTA.label}
          </a>
          <a href="/contact" class="btn btn--outline mobile-panel__cta-btn">
            Contact
          </a>
        </div>

        <div class="mobile-panel__legal">
          <a href="/disclosure">Disclosure</a>
          <a href="/privacy">Privacy</a>
          <a href="/methodology">Methodology</a>
        </div>

      </div>
    </div>
  </div>
</header>

<script>
  const toggle    = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav       = document.querySelector<HTMLElement>('[data-mobile-nav]');
  const iconOpen  = document.querySelector<SVGElement>('[data-icon-open]');
  const iconClose = document.querySelector<SVGElement>('[data-icon-close]');

  if (toggle && nav && iconOpen && iconClose) {
    const closeMenu = () => {
      nav.classList.add('hidden');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation menu');
      document.body.classList.remove('overflow-hidden');
    };

    const openMenu = () => {
      nav.classList.remove('hidden');
      iconOpen.classList.add('hidden');
      iconClose.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close navigation menu');
      document.body.classList.add('overflow-hidden');
    };

    toggle.addEventListener('click', () => {
      nav.classList.contains('hidden') ? openMenu() : closeMenu();
    });

    nav.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !nav.classList.contains('hidden')) closeMenu();
    });
  }
</script>
