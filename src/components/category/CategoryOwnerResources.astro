---
import type { CategoryLink, CategoryMeta } from '../../lib/categories/categoryConfig';

export interface Props {
  meta: CategoryMeta;
  categorySlug: string;
  links: CategoryLink[];
  tags: string[];
}

const { meta, links } = Astro.props;
---

<section id="owner-resources" class="category-hub__section category-hub__section--soft">
  <div class="category-hub__container">
    <div class="category-hub__section-header">
      <p class="category-hub__eyebrow">Planning resources</p>
      <h2>Research tools for {meta.title.toLowerCase()} decisions</h2>
      <p>
        Use these tools and guides to move from broad {meta.title.toLowerCase()} research
        to breed-specific decisions and confident ownership planning.
      </p>
    </div>

    {links.length > 0 && (
      <div class="category-hub__link-grid">
        {links.map((item) => (
          <a href={item.href} class="category-hub__link-card">
            <span aria-hidden="true">{item.icon}</span>
            <strong>{item.title}</strong>
            <p>{item.desc}</p>
          </a>
        ))}
      </div>
    )}
  </div>
</section>
