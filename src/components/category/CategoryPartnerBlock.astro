---
import CommercePlacement from '../commerce/CommercePlacement.astro';
import type { CategoryMeta } from '../../lib/categories/categoryConfig';

export interface Props {
  meta: CategoryMeta;
  categorySlug: string;
  tags: string[];
}

const { meta, categorySlug, tags } = Astro.props;
---

<section id="partner-resource" class="category-hub__section category-hub__section--partner">
  <div class="category-hub__container">
    <CommercePlacement
      pageType="category"
      placement="category-primary"
      context={{ category: categorySlug, title: meta.title, tags }}
      title={`Helpful ${meta.title.toLowerCase()} products`}
      eyebrow="Partner picks"
      limit={4}
    />
  </div>
</section>
