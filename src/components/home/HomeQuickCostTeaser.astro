---
export interface CostBreed {
  slug: string;
  href: string;
  name: string;
  imageUrl: string;
  imageAlt: string;
  annualFoodCost: number;
  lifetimeCost: number;
  size: string;
}

export interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  ctaHref?: string;
  ctaLabel?: string;
  breeds?: CostBreed[];
}

const {
  id = 'home-quick-cost-teaser',
  eyebrow = 'Real ownership costs',
  title = 'What does a dog actually cost?',
  subtitle = 'Annual food, vet, grooming and gear — estimated by breed. Use the calculator for a full breakdown.',
  ctaHref = '/cost-calculator',
  ctaLabel = 'Open the cost calculator',
  breeds = [],
} = Astro.props;

const formatCurrency = (n: number) =>
  n ? `$${n.toLocaleString('en-US')}` : '';
---

{breeds.length > 0 && (
  <section id={id} class="pw-cost-teaser">
    <div class="pw-cost-teaser__shell">

      <div class="pw-cost-teaser__head">
        <div>
          <p class="pw-cost-teaser__eyebrow">{eyebrow}</p>
          <h2 class="pw-cost-teaser__title">{title}</h2>
          <p class="pw-cost-teaser__subtitle">{subtitle}</p>
        </div>
        <a href={ctaHref} class="pw-cost-teaser__cta">
          {ctaLabel}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      </div>

      <div class="pw-cost-teaser__grid">
        {breeds.map((breed) => (
          <a href={breed.href} class="pw-cost-teaser__card">
            <div class="pw-cost-teaser__img-wrap">
              {breed.imageUrl ? (
                <img
                  src={breed.imageUrl}
                  alt={breed.imageAlt}
                  class="pw-cost-teaser__img"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="pw-cost-teaser__img-placeholder" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32" opacity="0.35">
                    <path d="M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                    <path d="M3 21v-2a7 7 0 0 1 7-7h4a7 7 0 0 1 7 7v2"/>
                  </svg>
                </div>
              )}
              <span class="pw-cost-teaser__size-chip">{breed.size}</span>
            </div>

            <div class="pw-cost-teaser__card-body">
              <h3 class="pw-cost-teaser__breed-name">{breed.name}</h3>

              <div class="pw-cost-teaser__stats">
                <div class="pw-cost-teaser__stat">
                  <span class="pw-cost-teaser__stat-value">{formatCurrency(breed.annualFoodCost)}</span>
                  <span class="pw-cost-teaser__stat-label">/ yr food est.</span>
                </div>
                <div class="pw-cost-teaser__stat pw-cost-teaser__stat--muted">
                  <span class="pw-cost-teaser__stat-value">{formatCurrency(breed.lifetimeCost)}</span>
                  <span class="pw-cost-teaser__stat-label">lifetime est.</span>
                </div>
              </div>

              <span class="pw-cost-teaser__link">
                Calculate full costs
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="12" height="12" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>
)}

<style>
  .pw-cost-teaser {
    background: var(--color-surface-navy);
    padding: var(--section-padding-sm) var(--content-padding-mobile);
  }

  .pw-cost-teaser__shell {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .pw-cost-teaser__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .pw-cost-teaser__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .pw-cost-teaser__title {
    margin: 0 0 var(--space-3);
    color: var(--color-text-inverse);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-tight);
  }

  .pw-cost-teaser__subtitle {
    margin: 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    max-width: 44rem;
  }

  .pw-cost-teaser__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: var(--color-cta);
    border-radius: var(--radius-xl);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-decoration: none;
    align-self: flex-start;
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .pw-cost-teaser__cta:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  .pw-cost-teaser__grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  .pw-cost-teaser__card {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: var(--transition-smooth);
  }

  .pw-cost-teaser__card:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.18);
    transform: translateY(-2px);
  }

  .pw-cost-teaser__img-wrap {
    position: relative;
    height: 11rem;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.05);
  }

  .pw-cost-teaser__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .pw-cost-teaser__card:hover .pw-cost-teaser__img {
    transform: scale(1.03);
  }

  .pw-cost-teaser__img-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: rgba(255, 255, 255, 0.35);
  }

  .pw-cost-teaser__size-chip {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    background: rgba(0, 0, 0, 0.52);
    border-radius: var(--radius-full);
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--text-xs);
    font-weight: var(--weight-semi);
    letter-spacing: 0.04em;
    padding: var(--space-1) var(--space-3);
    text-transform: capitalize;
  }

  .pw-cost-teaser__card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .pw-cost-teaser__breed-name {
    margin: 0;
    color: var(--color-text-inverse);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-snug);
  }

  .pw-cost-teaser__stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .pw-cost-teaser__stat {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .pw-cost-teaser__stat-value {
    color: var(--color-accent);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    line-height: 1;
  }

  .pw-cost-teaser__stat--muted .pw-cost-teaser__stat-value {
    color: rgba(255, 255, 255, 0.55);
    font-size: var(--text-base);
  }

  .pw-cost-teaser__stat-label {
    color: rgba(255, 255, 255, 0.5);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  .pw-cost-teaser__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    margin-top: auto;
    color: rgba(255, 255, 255, 0.7);
    font-size: var(--text-sm);
    font-weight: var(--weight-semi);
    transition: color var(--transition-base), gap var(--transition-base);
  }

  .pw-cost-teaser__card:hover .pw-cost-teaser__link {
    color: var(--color-accent);
    gap: var(--space-2);
  }

  @media (min-width: 640px) {
    .pw-cost-teaser {
      padding-inline: var(--content-padding);
    }

    .pw-cost-teaser__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .pw-cost-teaser__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .pw-cost-teaser {
      padding-inline: var(--content-padding-wide);
    }
  }
</style>
