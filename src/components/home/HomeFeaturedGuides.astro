---
export interface FeaturedGuide {
  category: string;
  title: string;
  description: string;
  href: string;
  imageUrl?: string;
  imageAlt?: string;
}

export interface Props {
  eyebrow?: string;
  title?: string;
  items?: FeaturedGuide[];
  viewAllHref?: string;
  viewAllLabel?: string;
}

const {
  eyebrow = 'Featured guides',
  title = 'Practical reads worth bookmarking',
  items = [],
  viewAllHref = '/guides',
  viewAllLabel = 'Browse all guides',
} = Astro.props;

const CATEGORY_COLORS: Record<string, { bg: string; text: string; border: string }> = {
  'first-dog guide': { bg: 'var(--color-pill-health-bg)', text: 'var(--color-pill-health-text)', border: 'var(--color-pill-health-border)' },
  'comparison': { bg: 'var(--color-pill-toys-bg)', text: 'var(--color-pill-toys-text)', border: 'var(--color-pill-toys-border)' },
  'food review': { bg: 'var(--color-pill-food-bg)', text: 'var(--color-pill-food-text)', border: 'var(--color-pill-food-border)' },
  'cost guide': { bg: 'var(--color-pill-gold-bg)', text: 'var(--color-pill-gold-text)', border: 'var(--color-pill-gold-border)' },
  'health': { bg: 'var(--color-pill-health-bg)', text: 'var(--color-pill-health-text)', border: 'var(--color-pill-health-border)' },
  'training': { bg: 'var(--color-pill-training-bg)', text: 'var(--color-pill-training-text)', border: 'var(--color-pill-training-border)' },
  'grooming': { bg: 'var(--color-pill-grooming-bg)', text: 'var(--color-pill-grooming-text)', border: 'var(--color-pill-grooming-border)' },
  'guide': { bg: 'var(--color-pill-supplements-bg)', text: 'var(--color-pill-supplements-text)', border: 'var(--color-pill-supplements-border)' },
};

const DEFAULT_COLORS = { bg: 'var(--color-bg-soft)', text: 'var(--color-muted)', border: 'var(--color-border)' };

function getCategoryColors(category: string) {
  const key = category.toLowerCase().trim();
  return CATEGORY_COLORS[key] || DEFAULT_COLORS;
}
---

{items.length > 0 && (
  <section class="pw-featured-guides" aria-label="Featured guides">
    <div class="pw-featured-guides__shell">

      <div class="pw-featured-guides__header">
        <div>
          {eyebrow && <p class="pw-featured-guides__eyebrow">{eyebrow}</p>}
          <h2 class="pw-featured-guides__title">{title}</h2>
        </div>
        <a href={viewAllHref} class="pw-featured-guides__view-all">
          {viewAllLabel} →
        </a>
      </div>

      <ul class="pw-featured-guides__grid" role="list">
        {items.map((guide) => {
          const colors = getCategoryColors(guide.category);
          return (
            <li>
              <article class="pw-featured-guides__card">
                {guide.imageUrl && (
                  <div class="pw-featured-guides__card-media">
                    <img
                      src={guide.imageUrl}
                      alt={guide.imageAlt || guide.title}
                      class="pw-featured-guides__card-img"
                      loading="lazy"
                      decoding="async"
                      width="600"
                      height="338"
                    />
                  </div>
                )}
                <div class="pw-featured-guides__card-body">
                  <span
                    class="pw-featured-guides__category"
                    style={`background: ${colors.bg}; color: ${colors.text}; border-color: ${colors.border};`}
                  >
                    {guide.category}
                  </span>
                  <h3 class="pw-featured-guides__card-title">
                    <a href={guide.href} class="pw-featured-guides__card-link">
                      {guide.title}
                    </a>
                  </h3>
                  <p class="pw-featured-guides__card-desc">{guide.description}</p>
                </div>
                <div class="pw-featured-guides__card-footer">
                  <a href={guide.href} class="pw-featured-guides__read-link">
                    Read guide →
                  </a>
                </div>
              </article>
            </li>
          );
        })}
      </ul>

      <div class="pw-featured-guides__footer">
        <a href={viewAllHref} class="btn btn--outline">
          {viewAllLabel}
        </a>
      </div>

    </div>
  </section>
)}

<style>
  .pw-featured-guides {
    background: var(--color-bg-soft);
    padding-block: var(--section-padding);
    padding-inline: var(--content-padding-mobile);
  }

  .pw-featured-guides__shell {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  /* Header */
  .pw-featured-guides__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .pw-featured-guides__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-semi);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .pw-featured-guides__title {
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
    color: var(--color-heading);
    margin: 0;
  }

  .pw-featured-guides__view-all {
    font-size: var(--text-sm);
    font-weight: var(--weight-semi);
    color: var(--color-primary);
    text-decoration: none;
    align-self: flex-start;
    white-space: nowrap;
  }

  .pw-featured-guides__view-all:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* Grid */
  .pw-featured-guides__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Cards */
  .pw-featured-guides__card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    height: 100%;
    transition: var(--transition-hover);
  }

  .pw-featured-guides__card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-3px);
    border-color: var(--color-border-primary);
  }

  .pw-featured-guides__card-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-soft);
  }

  .pw-featured-guides__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .pw-featured-guides__card:hover .pw-featured-guides__card-img {
    transform: scale(1.03);
  }

  .pw-featured-guides__card-body {
    padding: var(--space-5);
    flex: 1;
  }

  .pw-featured-guides__category {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semi);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    padding: 2px var(--space-2);
    margin-bottom: var(--space-3);
  }

  .pw-featured-guides__card-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semi);
    color: var(--color-heading);
    line-height: var(--leading-snug);
    margin: 0 0 var(--space-3);
  }

  .pw-featured-guides__card-link {
    color: inherit;
    text-decoration: none;
  }

  .pw-featured-guides__card-link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .pw-featured-guides__card-desc {
    font-size: var(--text-sm);
    color: var(--color-body-soft);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .pw-featured-guides__card-footer {
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid var(--color-border-soft);
    margin-top: auto;
  }

  .pw-featured-guides__read-link {
    font-size: var(--text-sm);
    font-weight: var(--weight-semi);
    color: var(--color-primary);
    text-decoration: none;
  }

  .pw-featured-guides__read-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* Footer */
  .pw-featured-guides__footer {
    margin-top: var(--space-10);
    text-align: center;
  }

  /* Responsive */
  @media (min-width: 640px) {
    .pw-featured-guides {
      padding-inline: var(--content-padding);
    }

    .pw-featured-guides__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .pw-featured-guides__header {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }

    .pw-featured-guides__view-all {
      margin-top: var(--space-8);
    }

    .pw-featured-guides__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .pw-featured-guides {
      padding-inline: var(--content-padding-wide);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pw-featured-guides__card,
    .pw-featured-guides__card-img {
      transition: none;
    }

    .pw-featured-guides__card:hover {
      transform: none;
    }

    .pw-featured-guides__card:hover .pw-featured-guides__card-img {
      transform: none;
    }
  }
</style>
