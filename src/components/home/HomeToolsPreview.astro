---
export interface LiveTool {
  name: string;
  href: string;
  description: string;
}

export interface ComingSoonTool {
  name: string;
}

export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  live?: LiveTool[];
  comingSoon?: ComingSoonTool[];
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  eyebrow = 'Planning tools',
  title = 'Free tools for every stage',
  subtitle = 'Whether you\'re still deciding on a breed or already caring for a dog — PupWiki\'s tools use real breed data and transparent assumptions.',
  live = [],
  comingSoon = [],
  ctaHref = '/tools',
  ctaLabel = 'Explore all tools',
} = Astro.props;
---

<section class="pw-tools-preview" aria-label="PupWiki planning tools">
  <div class="pw-tools-preview__shell">

    <div class="pw-tools-preview__header">
      <div class="pw-tools-preview__header-text">
        {eyebrow && <p class="pw-tools-preview__eyebrow">{eyebrow}</p>}
        <h2 class="pw-tools-preview__title">{title}</h2>
        {subtitle && <p class="pw-tools-preview__subtitle">{subtitle}</p>}
      </div>
      <a href={ctaHref} class="pw-tools-preview__header-cta">
        {ctaLabel} →
      </a>
    </div>

    {live.length > 0 && (
      <div class="pw-tools-preview__live-section">
        <ul class="pw-tools-preview__live-grid" role="list">
          {live.map((tool) => (
            <li>
              <article class="pw-tools-preview__card">
                <div class="pw-tools-preview__card-body">
                  <span class="pw-tools-preview__badge pw-tools-preview__badge--live">Available</span>
                  <h3 class="pw-tools-preview__card-title">
                    <a href={tool.href} class="pw-tools-preview__card-link">
                      {tool.name}
                    </a>
                  </h3>
                  <p class="pw-tools-preview__card-desc">{tool.description}</p>
                </div>
                <a href={tool.href} class="pw-tools-preview__use-btn" aria-label={`Use ${tool.name}`}>
                  Use tool →
                </a>
              </article>
            </li>
          ))}
        </ul>
      </div>
    )}

    {comingSoon.length > 0 && (
      <div class="pw-tools-preview__soon-section">
        <p class="pw-tools-preview__soon-label">Coming soon</p>
        <ul class="pw-tools-preview__soon-row" role="list">
          {comingSoon.map((tool) => (
            <li>
              <div class="pw-tools-preview__card pw-tools-preview__card--soon" aria-label={`${tool.name} — coming soon`}>
                <div class="pw-tools-preview__card-body">
                  <span class="pw-tools-preview__badge pw-tools-preview__badge--soon">Soon</span>
                  <p class="pw-tools-preview__card-title pw-tools-preview__card-title--soon">{tool.name}</p>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="pw-tools-preview__footer">
      <a href={ctaHref} class="btn btn--outline pw-tools-preview__footer-cta">
        {ctaLabel}
      </a>
    </div>

  </div>
</section>

<style>
  .pw-tools-preview {
    background: var(--color-bg);
    padding-block: var(--section-padding);
    padding-inline: var(--content-padding-mobile);
    border-top: 1px solid var(--color-border-soft);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .pw-tools-preview__shell {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  /* Header */
  .pw-tools-preview__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .pw-tools-preview__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-semi);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .pw-tools-preview__title {
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
    color: var(--color-heading);
    margin: 0 0 var(--space-3);
  }

  .pw-tools-preview__subtitle {
    font-size: var(--text-base);
    color: var(--color-body-soft);
    line-height: var(--leading-normal);
    max-width: 62ch;
    margin: 0;
  }

  .pw-tools-preview__header-cta {
    display: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-semi);
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
    align-self: flex-start;
  }

  .pw-tools-preview__header-cta:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* Live tools grid */
  .pw-tools-preview__live-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Cards */
  .pw-tools-preview__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-xs);
    height: 100%;
  }

  .pw-tools-preview__card:not(.pw-tools-preview__card--soon) {
    transition: var(--transition-hover);
  }

  .pw-tools-preview__card:not(.pw-tools-preview__card--soon):hover {
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-border-primary);
    transform: translateY(-2px);
  }

  .pw-tools-preview__card--soon {
    opacity: 0.65;
    cursor: default;
    background: var(--color-bg-muted);
  }

  .pw-tools-preview__card-body {
    flex: 1;
  }

  .pw-tools-preview__badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semi);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    border-radius: var(--radius-full);
    padding: 2px var(--space-2);
    margin-bottom: var(--space-3);
  }

  .pw-tools-preview__badge--live {
    background: var(--color-success-light);
    color: var(--color-success-dark);
  }

  .pw-tools-preview__badge--soon {
    background: var(--color-bg-muted);
    color: var(--color-muted);
    border: 1px solid var(--color-border);
  }

  .pw-tools-preview__card-title {
    font-size: var(--text-base);
    font-weight: var(--weight-semi);
    color: var(--color-heading);
    margin: 0 0 var(--space-2);
    line-height: var(--leading-snug);
  }

  .pw-tools-preview__card-title--soon {
    color: var(--color-muted);
  }

  .pw-tools-preview__card-link {
    color: inherit;
    text-decoration: none;
  }

  .pw-tools-preview__card-link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .pw-tools-preview__card-desc {
    font-size: var(--text-sm);
    color: var(--color-body-soft);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .pw-tools-preview__use-btn {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: var(--weight-semi);
    color: var(--color-primary);
    text-decoration: none;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-lg);
    transition: var(--transition-base);
    align-self: flex-start;
  }

  .pw-tools-preview__use-btn:hover {
    background: var(--color-primary-subtle);
    border-color: var(--color-primary);
  }

  /* Coming soon section */
  .pw-tools-preview__soon-section {
    margin-top: var(--space-8);
  }

  .pw-tools-preview__soon-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semi);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: var(--space-3);
  }

  .pw-tools-preview__soon-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pw-tools-preview__soon-row .pw-tools-preview__card {
    min-width: 160px;
    flex: 1;
    max-width: 240px;
  }

  /* Footer CTA */
  .pw-tools-preview__footer {
    margin-top: var(--space-10);
    text-align: center;
  }

  /* Responsive */
  @media (min-width: 640px) {
    .pw-tools-preview {
      padding-inline: var(--content-padding);
    }

    .pw-tools-preview__live-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .pw-tools-preview__header {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }

    .pw-tools-preview__header-cta {
      display: inline;
      margin-top: var(--space-8);
    }

    .pw-tools-preview__live-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .pw-tools-preview {
      padding-inline: var(--content-padding-wide);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pw-tools-preview__card,
    .pw-tools-preview__use-btn {
      transition: none;
    }

    .pw-tools-preview__card:hover {
      transform: none;
    }
  }
</style>
