---
/**
 * Primary journey cards — redesigned with colored SVG icon containers.
 */

export interface JourneyItem {
  title: string;
  description: string;
  href: string;
  eyebrow?: string;
  icon?: string;
  iconHtml?: string;
  color?: string;
}

export interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  items?: JourneyItem[];
}

const svgIcons: Record<string, string> = {
  breed: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.8 7.6c.8-.9 1.9-1.4 3.2-1.4s2.4.5 3.2 1.4"/><path d="M7.5 9.2c-1.5-.5-2.7.2-3.1 1.5-.5 1.6.4 3.2 2 3.7"/><path d="M16.5 9.2c1.5-.5 2.7.2 3.1 1.5.5 1.6-.4 3.2-2 3.7"/><path d="M8 14.5c.8 2 2.1 3 4 3s3.2-1 4-3"/><circle cx="10" cy="11" r="0.5" fill="currentColor"/><circle cx="14" cy="11" r="0.5" fill="currentColor"/></svg>`,
  cost: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v10"/><path d="M15 9.2c-.7-.8-1.7-1.2-3-1.2-1.5 0-2.5.8-2.5 2s.9 1.7 2.7 2.1c1.9.4 2.8 1.1 2.8 2.4S13.8 17 12.1 17c-1.4 0-2.6-.5-3.4-1.4"/></svg>`,
  mixed: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3C8 3 5 6 5 10c0 5 7 11 7 11s7-6 7-11c0-4-3-7-7-7z"/><path d="M12 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/></svg>`,
  names: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>`,
};

const journeyColors = [
  { bg: 'var(--color-primary)', light: 'var(--color-primary-subtle)', text: 'var(--color-primary)' },
  { bg: 'var(--color-cta)', light: 'var(--color-accent-subtle)', text: 'var(--color-cta)' },
  { bg: 'var(--color-success)', light: 'var(--color-success-light)', text: 'var(--color-success)' },
  { bg: 'var(--color-info)', light: 'var(--color-info-light)', text: 'var(--color-info)' },
];

const iconKeys = ['breed', 'cost', 'mixed', 'names'];

const defaultItems: JourneyItem[] = [
  {
    title: 'Find the right breed',
    description: 'Explore 277 breed profiles, compare temperament, size, and care needs to find the best match for your lifestyle.',
    href: '/breeds',
    eyebrow: 'Start here',
  },
  {
    title: 'Plan the real cost',
    description: 'Estimate ownership costs by breed and size — food, vet care, grooming, and more — before you commit.',
    href: '/cost-calculator',
    eyebrow: 'Decision support',
  },
  {
    title: 'Explore mixed breeds',
    description: 'Discover popular mixed-breed dogs, likely inherited traits, and practical care guidance based on parent breeds.',
    href: '/breeds',
    eyebrow: 'Mixed breeds',
  },
  {
    title: 'Choose a great name',
    description: 'Browse 5,000+ dog names filtered by breed personality, style, gender, and popularity.',
    href: '/dog-names',
    eyebrow: 'Fun + useful',
  },
];

const {
  id = 'home-primary-journeys',
  eyebrow = 'Where would you like to start?',
  title = 'The main ways dog parents use PupWiki',
  subtitle = 'Pick the journey that matches where you are right now.',
  items = defaultItems,
} = Astro.props;
---

<section id={id} class="pw-journeys">
  <div class="pw-journeys__shell">
    <header class="pw-journeys__header">
      <p class="pw-journeys__eyebrow">{eyebrow}</p>
      <h2 class="pw-journeys__title">{title}</h2>
      <p class="pw-journeys__subtitle">{subtitle}</p>
    </header>

    <div class="pw-journeys__grid">
      {items.map((item, i) => {
        const color = journeyColors[i % journeyColors.length];
        const iconKey = iconKeys[i % iconKeys.length];
        return (
          <a href={item.href} class="pw-journeys__card" style={`--card-color: ${color.bg}; --card-light: ${color.light}; --card-text: ${color.text};`}>
            <div class="pw-journeys__icon-wrap" aria-hidden="true">
              <span class="pw-journeys__icon" set:html={svgIcons[iconKey]} />
            </div>

            <div class="pw-journeys__body">
              {item.eyebrow && (
                <p class="pw-journeys__card-eyebrow">{item.eyebrow}</p>
              )}
              <h3 class="pw-journeys__card-title">{item.title}</h3>
              <p class="pw-journeys__card-desc">{item.description}</p>
            </div>

            <span class="pw-journeys__cta" aria-hidden="true">
              Explore
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </span>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .pw-journeys {
    background: var(--color-bg);
    padding: var(--section-padding) var(--content-padding-mobile);
  }

  .pw-journeys__shell {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .pw-journeys__header {
    max-width: 48ch;
    margin-bottom: var(--space-10);
  }

  .pw-journeys__eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .pw-journeys__title {
    margin: 0 0 var(--space-3);
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-tight);
  }

  .pw-journeys__subtitle {
    margin: 0;
    color: var(--color-body-soft);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .pw-journeys__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .pw-journeys__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    box-shadow: var(--card-shadow);
    text-decoration: none;
    color: inherit;
    transition: var(--transition-smooth);
    position: relative;
  }

  .pw-journeys__card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    border-radius: var(--card-radius) var(--card-radius) 0 0;
    background: var(--card-color);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .pw-journeys__card:hover {
    transform: translateY(-4px);
    border-color: var(--card-color, var(--color-border-strong));
    box-shadow: var(--card-shadow-hover);
  }

  .pw-journeys__card:hover::before {
    opacity: 1;
  }

  .pw-journeys__icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-xl);
    background: var(--card-light);
    color: var(--card-color);
    flex-shrink: 0;
  }

  .pw-journeys__icon {
    display: contents;
  }

  .pw-journeys__icon :global(svg) {
    width: 28px;
    height: 28px;
  }

  .pw-journeys__body {
    flex: 1;
  }

  .pw-journeys__card-eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--card-text);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .pw-journeys__card-title {
    margin: 0 0 var(--space-2);
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
  }

  .pw-journeys__card-desc {
    margin: 0;
    color: var(--color-body-soft);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .pw-journeys__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--card-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    transition: gap var(--transition-base);
  }

  .pw-journeys__cta svg {
    transition: transform var(--transition-base);
  }

  .pw-journeys__card:hover .pw-journeys__cta svg {
    transform: translateX(3px);
  }

  @media (min-width: 640px) {
    .pw-journeys {
      padding-inline: var(--content-padding);
    }

    .pw-journeys__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .pw-journeys {
      padding-inline: var(--content-padding-wide);
    }

    .pw-journeys__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pw-journeys__card {
      transition: none;
    }

    .pw-journeys__card:hover {
      transform: none;
    }

    .pw-journeys__cta svg {
      transition: none;
    }
  }
</style>
