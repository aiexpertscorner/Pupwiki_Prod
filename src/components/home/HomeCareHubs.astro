---
export interface CareHub {
  title: string;
  description: string;
  href: string;
  accentVar?: string;
  bgVar?: string;
  borderVar?: string;
  textVar?: string;
}

export interface Props {
  eyebrow?: string;
  title?: string;
  items?: CareHub[];
}

const {
  eyebrow = 'Care guidance',
  title = 'Practical guidance for every area of dog care',
  items = [],
} = Astro.props;
---

{items.length > 0 && (
  <section class="pw-care-hubs" aria-label="Dog care guidance hubs">
    <div class="pw-care-hubs__shell">

      <div class="pw-care-hubs__header">
        {eyebrow && <p class="pw-care-hubs__eyebrow">{eyebrow}</p>}
        <h2 class="pw-care-hubs__title">{title}</h2>
      </div>

      <ul class="pw-care-hubs__grid" role="list">
        {items.map((hub) => (
          <li>
            <a
              href={hub.href}
              class="pw-care-hubs__card"
              style={[
                hub.accentVar ? `--hub-accent: var(${hub.accentVar})` : '',
                hub.bgVar ? `--hub-bg: var(${hub.bgVar})` : '',
                hub.borderVar ? `--hub-border: var(${hub.borderVar})` : '',
                hub.textVar ? `--hub-text: var(${hub.textVar})` : '',
              ].filter(Boolean).join('; ')}
            >
              <div class="pw-care-hubs__card-inner">
                <h3 class="pw-care-hubs__card-title">{hub.title}</h3>
                <p class="pw-care-hubs__card-desc">{hub.description}</p>
              </div>
              <span class="pw-care-hubs__card-cta" aria-hidden="true">
                Explore →
              </span>
            </a>
          </li>
        ))}
      </ul>

    </div>
  </section>
)}

<style>
  .pw-care-hubs {
    background: var(--color-bg-cool);
    padding-block: var(--section-padding);
    padding-inline: var(--content-padding-mobile);
  }

  .pw-care-hubs__shell {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .pw-care-hubs__header {
    margin-bottom: var(--space-10);
  }

  .pw-care-hubs__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-semi);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }

  .pw-care-hubs__title {
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
    color: var(--color-heading);
    margin: 0;
    max-width: 42ch;
  }

  /* Grid */
  .pw-care-hubs__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Cards */
  .pw-care-hubs__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--hub-bg, var(--color-surface));
    border: 1px solid var(--hub-border, var(--color-border));
    border-left: 4px solid var(--hub-accent, var(--color-primary));
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-xs);
    text-decoration: none;
    color: inherit;
    height: 100%;
    transition: var(--transition-hover);
  }

  .pw-care-hubs__card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-3px);
    border-left-width: 6px;
  }

  .pw-care-hubs__card-inner {
    flex: 1;
  }

  .pw-care-hubs__card-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semi);
    color: var(--hub-text, var(--color-heading));
    margin: 0 0 var(--space-3);
    line-height: var(--leading-snug);
  }

  .pw-care-hubs__card-desc {
    font-size: var(--text-sm);
    color: var(--color-body-soft);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .pw-care-hubs__card-cta {
    font-size: var(--text-sm);
    font-weight: var(--weight-semi);
    color: var(--hub-accent, var(--color-primary));
    margin-top: auto;
  }

  /* Responsive */
  @media (min-width: 640px) {
    .pw-care-hubs {
      padding-inline: var(--content-padding);
    }

    .pw-care-hubs__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .pw-care-hubs__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .pw-care-hubs {
      padding-inline: var(--content-padding-wide);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pw-care-hubs__card {
      transition: none;
    }

    .pw-care-hubs__card:hover {
      transform: none;
    }
  }
</style>
