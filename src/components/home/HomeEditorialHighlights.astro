---
export interface EditorialCard {
  category?: string;
  title: string;
  description: string;
  href: string;
  image?: string;
  readTime?: string;
  date?: string;
}

export interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  viewAllHref?: string;
  viewAllLabel?: string;
  items?: EditorialCard[];
}

const CATEGORY_COLORS: Record<string, { bg: string; text: string }> = {
  health:     { bg: 'var(--cat-health-bg)',    text: 'var(--cat-health-text)' },
  training:   { bg: 'var(--cat-training-bg)',  text: 'var(--cat-training-text)' },
  food:       { bg: 'var(--cat-food-bg)',      text: 'var(--cat-food-text)' },
  nutrition:  { bg: 'var(--cat-food-bg)',      text: 'var(--cat-food-text)' },
  lifestyle:  { bg: 'var(--color-success-light)', text: 'var(--color-success)' },
  breed:      { bg: 'var(--color-primary-subtle)', text: 'var(--color-primary)' },
  breeds:     { bg: 'var(--color-primary-subtle)', text: 'var(--color-primary)' },
  names:      { bg: 'var(--color-info-light)',  text: 'var(--color-info)' },
  cost:       { bg: 'var(--color-accent-subtle)', text: 'var(--color-cta)' },
};

const getCategoryStyle = (cat?: string) => {
  if (!cat) return { bg: 'var(--color-bg-cool)', text: 'var(--color-body-soft)' };
  return CATEGORY_COLORS[cat.toLowerCase()] ?? { bg: 'var(--color-bg-cool)', text: 'var(--color-body-soft)' };
};

const {
  id = 'home-editorial-highlights',
  eyebrow = 'From the guides',
  title = 'Practical reads for dog owners',
  subtitle = 'Guides, comparisons, and how-to content — curated from the PupWiki editorial team.',
  viewAllHref = '/blog',
  viewAllLabel = 'View all guides',
  items = [],
} = Astro.props;
---

{items.length > 0 && (
  <section id={id} class="pw-editorial">
    <div class="pw-editorial__shell">

      <div class="pw-editorial__head">
        <div class="pw-editorial__head-text">
          <p class="pw-editorial__eyebrow">{eyebrow}</p>
          <h2 class="pw-editorial__title">{title}</h2>
          <p class="pw-editorial__subtitle">{subtitle}</p>
        </div>
        <a href={viewAllHref} class="pw-editorial__view-all">
          {viewAllLabel}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      </div>

      <div class="pw-editorial__grid">
        {items.map((item) => {
          const catStyle = getCategoryStyle(item.category);
          return (
            <a href={item.href} class="pw-editorial__card">
              <div class="pw-editorial__card-img-wrap">
                {item.image ? (
                  <img
                    src={item.image}
                    alt={item.title}
                    class="pw-editorial__card-img"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="pw-editorial__card-img-placeholder" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" width="40" height="40" opacity="0.25">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                      <polyline points="14,2 14,8 20,8"/>
                      <line x1="16" y1="13" x2="8" y2="13"/>
                      <line x1="16" y1="17" x2="8" y2="17"/>
                      <polyline points="10,9 9,9 8,9"/>
                    </svg>
                  </div>
                )}
              </div>

              <div class="pw-editorial__card-body">
                {item.category && (
                  <span
                    class="pw-editorial__category-pill"
                    style={`background: ${catStyle.bg}; color: ${catStyle.text};`}
                  >
                    {item.category}
                  </span>
                )}

                <h3 class="pw-editorial__card-title">{item.title}</h3>
                <p class="pw-editorial__card-desc">{item.description}</p>

                <div class="pw-editorial__card-footer">
                  {(item.readTime || item.date) && (
                    <span class="pw-editorial__card-meta">
                      {item.readTime && <span>{item.readTime}</span>}
                      {item.readTime && item.date && <span aria-hidden="true">·</span>}
                      {item.date && <span>{item.date}</span>}
                    </span>
                  )}
                  <span class="pw-editorial__card-cta" aria-hidden="true">
                    Read more
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
                      <path d="M5 12h14M13 6l6 6-6 6"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <div class="pw-editorial__bottom-cta">
        <a href={viewAllHref} class="pw-editorial__bottom-link">
          {viewAllLabel} →
        </a>
      </div>

    </div>
  </section>
)}

<style>
  .pw-editorial {
    background: var(--color-bg);
    padding: var(--section-padding) var(--content-padding-mobile);
  }

  .pw-editorial__shell {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  /* ── Head ─────────────────────────────────── */
  .pw-editorial__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-10);
  }

  .pw-editorial__eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .pw-editorial__title {
    margin: 0 0 var(--space-3);
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-tight);
    max-width: 48ch;
  }

  .pw-editorial__subtitle {
    margin: 0;
    color: var(--color-body-soft);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    max-width: 52ch;
  }

  .pw-editorial__view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-decoration: none;
    white-space: nowrap;
  }

  .pw-editorial__view-all:hover {
    text-decoration: underline;
  }

  /* ── Grid ─────────────────────────────────── */
  .pw-editorial__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  /* ── Card ─────────────────────────────────── */
  .pw-editorial__card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-card);
    transition: var(--transition-smooth);
  }

  .pw-editorial__card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-border-strong);
  }

  .pw-editorial__card-img-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-cool);
    flex-shrink: 0;
  }

  .pw-editorial__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .pw-editorial__card:hover .pw-editorial__card-img {
    transform: scale(1.04);
  }

  .pw-editorial__card-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-bg-cool) 0%, var(--color-border) 100%);
    color: var(--color-border-strong);
  }

  .pw-editorial__card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    flex: 1;
  }

  .pw-editorial__category-pill {
    display: inline-block;
    align-self: flex-start;
    padding: 2px var(--space-2-5);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1.6;
  }

  .pw-editorial__card-title {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pw-editorial__card-desc {
    margin: 0;
    flex: 1;
    color: var(--color-body-soft);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pw-editorial__card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .pw-editorial__card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-body-muted);
    font-size: var(--text-xs);
  }

  .pw-editorial__card-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    flex-shrink: 0;
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    white-space: nowrap;
  }

  .pw-editorial__card-cta svg {
    transition: transform var(--transition-base);
  }

  .pw-editorial__card:hover .pw-editorial__card-cta svg {
    transform: translateX(3px);
  }

  /* ── Bottom CTA ───────────────────────────── */
  .pw-editorial__bottom-cta {
    margin-top: var(--space-10);
    text-align: center;
  }

  .pw-editorial__bottom-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-decoration: none;
  }

  .pw-editorial__bottom-link:hover {
    text-decoration: underline;
  }

  /* ── Responsive ───────────────────────────── */
  @media (min-width: 640px) {
    .pw-editorial {
      padding-inline: var(--content-padding);
    }

    .pw-editorial__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .pw-editorial__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .pw-editorial__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .pw-editorial {
      padding-inline: var(--content-padding-wide);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pw-editorial__card {
      transition: none;
    }

    .pw-editorial__card:hover {
      transform: none;
    }

    .pw-editorial__card-img {
      transition: none;
    }
  }
</style>
