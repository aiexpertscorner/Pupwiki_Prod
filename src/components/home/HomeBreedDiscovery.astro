---
/**
 * Breed discovery grid.
 */

export interface BreedCard {
  slug: string;
  name: string;
  imageUrl?: string;
  img?: string;
  subtitle?: string;
  tags?: string[];
  href?: string;
  size?: string;
  energy?: string;
  trainability?: string;
}

export interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  viewAllHref?: string;
  viewAllLabel?: string;
  routePrefix?: string;
  breeds?: BreedCard[];
}

const {
  id = 'home-breed-discovery',
  eyebrow = 'Popular breeds',
  title = 'Explore top dog breeds',
  subtitle = 'Start with familiar favorites, then branch into breed guides that match your lifestyle, experience, and care expectations.',
  viewAllHref = '/breeds',
  viewAllLabel = 'View all breeds',
  routePrefix = '/breeds',
  breeds = [],
} = Astro.props;

const sizeChip: Record<string, { bg: string; text: string }> = {
  large:  { bg: 'var(--color-primary-subtle)',  text: 'var(--color-primary)' },
  medium: { bg: 'var(--color-bg-cool)',          text: 'var(--color-body)' },
  small:  { bg: 'var(--color-accent-subtle)',    text: 'var(--color-accent-hover)' },
};

const energyChip: Record<string, { bg: string; text: string }> = {
  active:  { bg: 'var(--color-success-light)', text: 'var(--color-success)' },
  regular: { bg: 'var(--color-bg-muted)',       text: 'var(--color-body-soft)' },
  calm:    { bg: 'var(--color-info-light)',     text: 'var(--color-info)' },
};

const trainingChip: Record<string, { bg: string; text: string }> = {
  easy:     { bg: 'var(--color-success-light)', text: 'var(--color-success)' },
  moderate: { bg: 'var(--color-bg-muted)',       text: 'var(--color-body-soft)' },
  difficult:{ bg: 'var(--color-warning-light, var(--color-accent-light))',  text: 'var(--color-warning, var(--color-accent-hover))' },
};
---

<section id={id} class="py-12 sm:py-14 lg:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-5 lg:px-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-primary)]">
          {eyebrow}
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-[var(--color-heading)] sm:text-4xl">
          {title}
        </h2>
        <p class="mt-3 text-base leading-7 text-[var(--color-body-soft)]">
          {subtitle}
        </p>
      </div>

      <a
        href={viewAllHref}
        class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-primary)] transition hover:text-[var(--color-primary-hover)]"
      >
        {viewAllLabel}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {breeds.map((breed) => {
        const href = breed.href ?? `${routePrefix}/${breed.slug}`;
        const image = breed.imageUrl ?? breed.img ?? '';
        const sizeStyle = sizeChip[breed.size ?? ''] ?? { bg: 'var(--color-bg-muted)', text: 'var(--color-body)' };
        const energyStyle = energyChip[breed.energy ?? ''] ?? { bg: 'var(--color-bg-muted)', text: 'var(--color-body-soft)' };
        const trainStyle = trainingChip[breed.trainability ?? ''] ?? { bg: 'var(--color-bg-muted)', text: 'var(--color-body-soft)' };
        return (
          <a
            href={href}
            class="group overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] shadow-sm transition hover:-translate-y-[3px] hover:border-[var(--color-border-strong)] hover:shadow-[var(--shadow-card-hover)]"
          >
            <div class="relative h-52 overflow-hidden bg-[var(--color-bg-muted)]">
              {image ? (
                <img
                  src={image}
                  alt={breed.name}
                  class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.04]"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center text-[var(--color-muted)]">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="40" height="40" opacity="0.35" aria-hidden="true">
                    <path d="M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M3 21v-2a7 7 0 0 1 7-7h4a7 7 0 0 1 7 7v2"/>
                  </svg>
                </div>
              )}
            </div>

            <div class="p-5">
              <h3 class="text-lg font-bold text-[var(--color-heading)] leading-snug">
                {breed.name}
              </h3>

              {breed.subtitle && (
                <p class="mt-2 line-clamp-2 text-sm leading-6 text-[var(--color-body-soft)]">
                  {breed.subtitle}
                </p>
              )}

              <div class="mt-4 flex flex-wrap gap-1.5">
                {breed.size && (
                  <span style={`background:${sizeStyle.bg};color:${sizeStyle.text}`} class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold capitalize">
                    {breed.size}
                  </span>
                )}
                {breed.energy && (
                  <span style={`background:${energyStyle.bg};color:${energyStyle.text}`} class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold capitalize">
                    {breed.energy} energy
                  </span>
                )}
                {breed.trainability && (
                  <span style={`background:${trainStyle.bg};color:${trainStyle.text}`} class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold capitalize">
                    {breed.trainability} training
                  </span>
                )}
              </div>

              <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-primary)] transition group-hover:translate-x-[3px]">
                View breed guide
                <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
