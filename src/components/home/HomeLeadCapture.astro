---
export interface HiddenField {
  name: string;
  value: string;
}

export interface LinkItem {
  label: string;
  href: string;
}

export interface Props {
  id?: string;
  title?: string;
  description?: string;
  formAction?: string;
  method?: 'POST' | 'GET';
  emailPlaceholder?: string;
  buttonLabel?: string;
  hiddenFields?: HiddenField[];
  fallbackPrimary?: LinkItem;
  fallbackSecondary?: LinkItem;
  disclaimer?: string;
}

const {
  id = 'home-lead-capture',
  title = 'Better care starts here.',
  description = 'Get practical breed guides, care tips, and product recommendations — straight to your inbox. No fluff.',
  formAction = '',
  method = 'POST',
  emailPlaceholder = 'your@email.com',
  buttonLabel = 'Subscribe free',
  hiddenFields = [],
  fallbackPrimary = { label: 'Explore Breeds', href: '/breeds' },
  fallbackSecondary = { label: 'Read the Blog', href: '/blog' },
  disclaimer = 'No spam. Only practical dog guidance and occasional curated recommendations.',
} = Astro.props;

const hasLiveForm = typeof formAction === 'string' && formAction.trim().length > 0;
---

<section id={id} class="pw-capture">
  <div class="pw-capture__shell">
    <div class="pw-capture__inner">

      <!-- Decorative paw mark -->
      <div class="pw-capture__deco" aria-hidden="true">
        <svg viewBox="0 0 64 64" fill="currentColor" width="64" height="64" opacity="0.08">
          <ellipse cx="20" cy="14" rx="7" ry="9"/>
          <ellipse cx="44" cy="14" rx="7" ry="9"/>
          <ellipse cx="10" cy="30" rx="6" ry="8"/>
          <ellipse cx="54" cy="30" rx="6" ry="8"/>
          <path d="M32 22c-10 0-18 8-16 20 1 7 7 12 16 12s15-5 16-12c2-12-6-20-16-20z"/>
        </svg>
      </div>

      <div class="pw-capture__content">
        <p class="pw-capture__eyebrow">Stay updated</p>
        <h2 class="pw-capture__title">{title}</h2>
        <p class="pw-capture__desc">{description}</p>

        {hasLiveForm ? (
          <form action={formAction} method={method} class="pw-capture__form">
            {hiddenFields.map((field) => (
              <input type="hidden" name={field.name} value={field.value} />
            ))}
            <div class="pw-capture__form-row">
              <input
                type="email"
                name="email"
                required
                placeholder={emailPlaceholder}
                class="pw-capture__email-input"
                autocomplete="email"
              />
              <button type="submit" class="pw-capture__submit">{buttonLabel}</button>
            </div>
          </form>
        ) : (
          <div class="pw-capture__cta-row">
            <a href={fallbackPrimary.href} class="pw-capture__cta-primary">
              {fallbackPrimary.label}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </a>
            <a href={fallbackSecondary.href} class="pw-capture__cta-secondary">
              {fallbackSecondary.label}
            </a>
          </div>
        )}

        <p class="pw-capture__disclaimer">{disclaimer}</p>
      </div>

    </div>
  </div>
</section>

<style>
  .pw-capture {
    background: var(--color-bg);
    padding: var(--section-padding) var(--content-padding-mobile);
  }

  .pw-capture__shell {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .pw-capture__inner {
    position: relative;
    overflow: hidden;
    background: var(--color-surface-navy);
    border-radius: var(--radius-3xl, 2rem);
    padding: var(--space-12) var(--space-8);
    text-align: center;
  }

  .pw-capture__deco {
    position: absolute;
    top: -12px;
    right: -12px;
    color: #fff;
    width: 120px;
    height: 120px;
    transform: rotate(15deg);
    pointer-events: none;
  }

  .pw-capture__deco svg {
    width: 100%;
    height: 100%;
  }

  .pw-capture__content {
    position: relative;
    max-width: 560px;
    margin-inline: auto;
  }

  .pw-capture__eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-cta);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .pw-capture__title {
    margin: 0 0 var(--space-4);
    color: var(--color-text-inverse);
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-tight);
  }

  .pw-capture__desc {
    margin: 0 0 var(--space-8);
    color: rgba(255, 255, 255, 0.72);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  /* ── Form ─────────────────────────────────── */
  .pw-capture__form {
    margin-bottom: var(--space-4);
  }

  .pw-capture__form-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .pw-capture__email-input {
    flex: 1;
    padding: var(--space-3-5) var(--space-5);
    background: rgba(255, 255, 255, 0.08);
    border: 1.5px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-xl);
    color: var(--color-text-inverse);
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    outline: none;
    transition: border-color var(--transition-base), background var(--transition-base);
  }

  .pw-capture__email-input::placeholder {
    color: rgba(255, 255, 255, 0.38);
  }

  .pw-capture__email-input:focus {
    border-color: var(--color-cta);
    background: rgba(255, 255, 255, 0.12);
  }

  .pw-capture__submit {
    padding: var(--space-3-5) var(--space-8);
    background: var(--color-cta);
    border: none;
    border-radius: var(--radius-xl);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    font-family: var(--font-sans);
    cursor: pointer;
    transition: opacity var(--transition-base), transform var(--transition-base);
    white-space: nowrap;
  }

  .pw-capture__submit:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  /* ── Fallback CTAs ────────────────────────── */
  .pw-capture__cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .pw-capture__cta-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-7);
    background: var(--color-cta);
    border-radius: var(--radius-xl);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-decoration: none;
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .pw-capture__cta-primary:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }

  .pw-capture__cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-7);
    background: rgba(255, 255, 255, 0.08);
    border: 1.5px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-xl);
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: background var(--transition-base), border-color var(--transition-base);
  }

  .pw-capture__cta-secondary:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.28);
  }

  .pw-capture__disclaimer {
    margin: var(--space-4) 0 0;
    color: rgba(255, 255, 255, 0.4);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
  }

  /* ── Responsive ───────────────────────────── */
  @media (min-width: 640px) {
    .pw-capture {
      padding-inline: var(--content-padding);
    }

    .pw-capture__inner {
      padding: var(--space-16) var(--space-12);
    }

    .pw-capture__form-row {
      flex-direction: row;
    }
  }

  @media (min-width: 1280px) {
    .pw-capture {
      padding-inline: var(--content-padding-wide);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pw-capture__submit,
    .pw-capture__cta-primary {
      transition: none;
    }

    .pw-capture__submit:hover,
    .pw-capture__cta-primary:hover {
      transform: none;
    }
  }
</style>
