---
export interface PathItem {
  title: string;
  description: string;
  href: string;
  icon?: string;
  status?: 'live' | 'coming_soon';
}

export interface Props {
  eyebrow?: string;
  title?: string;
  items?: PathItem[];
}

const {
  eyebrow = 'Where do you want to start?',
  title = 'Dog decisions made easier',
  items = [],
} = Astro.props;

const ACCENT_COLORS = [
  { bg: '--color-primary-subtle', border: '--color-primary-light', icon: '--color-primary' },
  { bg: '--color-accent-subtle', border: '--color-accent-light', icon: '--color-accent' },
  { bg: '--color-success-bg', border: '--color-success-light', icon: '--color-success' },
  { bg: '--color-bg-cool', border: '--color-primary-light', icon: '--color-info' },
];

const liveItems = items.filter((item) => item.status !== 'coming_soon');
---

{liveItems.length > 0 && (
  <section class="pw-decision-paths" aria-label="Decision paths">
    <div class="pw-decision-paths__shell">
      <div class="pw-decision-paths__header">
        {eyebrow && <p class="pw-decision-paths__eyebrow">{eyebrow}</p>}
        <h2 class="pw-decision-paths__title">{title}</h2>
      </div>

      <ul class="pw-decision-paths__grid" role="list">
        {liveItems.map((item, i) => {
          const colors = ACCENT_COLORS[i % ACCENT_COLORS.length];
          return (
            <li>
              <a
                href={item.href}
                class="pw-decision-paths__card"
                style={`--card-accent-bg: var(${colors.bg}); --card-accent-border: var(${colors.border}); --card-accent-icon: var(${colors.icon});`}
              >
                {item.icon && (
                  <div class="pw-decision-paths__icon" aria-hidden="true">
                    {item.icon}
                  </div>
                )}
                <div class="pw-decision-paths__body">
                  <h3 class="pw-decision-paths__card-title">{item.title}</h3>
                  <p class="pw-decision-paths__card-desc">{item.description}</p>
                </div>
                <span class="pw-decision-paths__cta" aria-hidden="true">
                  Start →
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}

<style>
  .pw-decision-paths {
    background: var(--color-bg-soft);
    padding-block: var(--section-padding);
    padding-inline: var(--content-padding-mobile);
  }

  .pw-decision-paths__shell {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .pw-decision-paths__header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .pw-decision-paths__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-semi);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }

  .pw-decision-paths__title {
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
    color: var(--color-heading);
    margin: 0;
  }

  .pw-decision-paths__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pw-decision-paths__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--card-accent-icon, var(--color-primary));
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: inherit;
    transition: var(--transition-hover);
    height: 100%;
  }

  .pw-decision-paths__card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-4px);
    border-color: var(--card-accent-border, var(--color-border-strong));
  }

  .pw-decision-paths__icon {
    font-size: 1.75rem;
    line-height: 1;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--card-accent-bg, var(--color-primary-subtle));
    border-radius: var(--radius-lg);
    flex-shrink: 0;
  }

  .pw-decision-paths__body {
    flex: 1;
  }

  .pw-decision-paths__card-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semi);
    color: var(--color-heading);
    margin-bottom: var(--space-2);
    line-height: var(--leading-snug);
  }

  .pw-decision-paths__card-desc {
    font-size: var(--text-sm);
    color: var(--color-body-soft);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .pw-decision-paths__cta {
    font-size: var(--text-sm);
    font-weight: var(--weight-semi);
    color: var(--card-accent-icon, var(--color-primary));
    margin-top: auto;
  }

  /* Responsive */
  @media (min-width: 640px) {
    .pw-decision-paths {
      padding-inline: var(--content-padding);
    }

    .pw-decision-paths__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .pw-decision-paths__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .pw-decision-paths {
      padding-inline: var(--content-padding-wide);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pw-decision-paths__card {
      transition: none;
    }

    .pw-decision-paths__card:hover {
      transform: none;
    }
  }
</style>
