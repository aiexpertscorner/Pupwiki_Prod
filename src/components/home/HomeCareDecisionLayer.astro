---
/**
 * Care decision layer — redesigned with colored left-border cards on cool bg.
 */

export interface CareCard {
  title: string;
  description: string;
  href: string;
  icon?: string;
  iconHtml?: string;
  eyebrow?: string;
}

export interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  cards?: CareCard[];
}

const svgIcons: Record<string, string> = {
  health: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
  training: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
  food: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l19-9-9 19-2-8-8-2z"/></svg>`,
  lifestyle: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>`,
};

const cardMeta = [
  { key: 'health', color: 'var(--cat-health-accent)', bg: 'var(--cat-health-bg)', border: 'var(--cat-health-border)', text: 'var(--cat-health-text)' },
  { key: 'training', color: 'var(--cat-training-accent)', bg: 'var(--cat-training-bg)', border: 'var(--cat-training-border)', text: 'var(--cat-training-text)' },
  { key: 'food', color: 'var(--cat-food-accent)', bg: 'var(--cat-food-bg)', border: 'var(--cat-food-border)', text: 'var(--cat-food-text)' },
  { key: 'lifestyle', color: 'var(--color-success)', bg: 'var(--color-success-light)', border: 'var(--color-success-light)', text: 'var(--color-success)' },
];

const defaultCards: CareCard[] = [
  {
    title: 'Health & vet care',
    description: 'Understand breed-linked health patterns, common conditions, and practical guidance for every life stage.',
    href: '/categories/health',
    eyebrow: 'Care',
  },
  {
    title: 'Training & behavior',
    description: 'Explore trainability scores, behavior patterns, and routine-building strategies for better day-to-day life.',
    href: '/categories/training',
    eyebrow: 'Behavior',
  },
  {
    title: 'Nutrition & feeding',
    description: 'Compare feeding approaches, food guidance, and practical nutrition considerations by breed size and lifestyle.',
    href: '/categories/dog-food',
    eyebrow: 'Food',
  },
  {
    title: 'Lifestyle & gear',
    description: 'Practical product and lifestyle guidance for sleep, travel, play, safety, and daily routines.',
    href: '/categories/lifestyle',
    eyebrow: 'Lifestyle',
  },
];

const {
  id = 'home-care-decision-layer',
  eyebrow = 'Care decisions',
  title = 'The practical side of dog ownership',
  subtitle = 'Move from curiosity to confident action with care, training, health, and lifestyle guidance built around real breeds.',
  cards = defaultCards,
} = Astro.props;
---

<section id={id} class="pw-care">
  <div class="pw-care__shell">
    <header class="pw-care__header">
      <p class="pw-care__eyebrow">{eyebrow}</p>
      <h2 class="pw-care__title">{title}</h2>
      <p class="pw-care__subtitle">{subtitle}</p>
    </header>

    <div class="pw-care__grid">
      {cards.map((card, i) => {
        const meta = cardMeta[i % cardMeta.length];
        const iconKey = meta.key;
        return (
          <a
            href={card.href}
            class="pw-care__card"
            style={`--care-color: ${meta.color}; --care-bg: ${meta.bg}; --care-border: ${meta.border}; --care-text: ${meta.text};`}
          >
            <div class="pw-care__card-top">
              <div class="pw-care__icon-wrap" aria-hidden="true">
                <span class="pw-care__icon" set:html={svgIcons[iconKey]} />
              </div>
              {card.eyebrow && (
                <span class="pw-care__card-eyebrow">{card.eyebrow}</span>
              )}
            </div>

            <h3 class="pw-care__card-title">{card.title}</h3>
            <p class="pw-care__card-desc">{card.description}</p>

            <span class="pw-care__card-cta" aria-hidden="true">
              Explore guides
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </span>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .pw-care {
    background: var(--color-bg-cool);
    padding: var(--section-padding) var(--content-padding-mobile);
  }

  .pw-care__shell {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .pw-care__header {
    max-width: 52ch;
    margin-bottom: var(--space-10);
  }

  .pw-care__eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .pw-care__title {
    margin: 0 0 var(--space-3);
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-tight);
  }

  .pw-care__subtitle {
    margin: 0;
    color: var(--color-body-soft);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .pw-care__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .pw-care__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--care-color);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: inherit;
    transition: var(--transition-smooth);
  }

  .pw-care__card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--care-color);
    border-left-color: var(--care-color);
    background: var(--care-bg);
  }

  .pw-care__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .pw-care__icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--care-bg);
    border: 1px solid var(--care-border);
    border-radius: var(--radius-lg);
    color: var(--care-color);
    flex-shrink: 0;
    transition: background var(--transition-base);
  }

  .pw-care__card:hover .pw-care__icon-wrap {
    background: var(--color-bg);
  }

  .pw-care__icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .pw-care__card-eyebrow {
    padding: var(--space-1) var(--space-3);
    background: var(--care-bg);
    border: 1px solid var(--care-border);
    border-radius: var(--radius-full);
    color: var(--care-text);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .pw-care__card-title {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
  }

  .pw-care__card-desc {
    margin: 0;
    flex: 1;
    color: var(--color-body-soft);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .pw-care__card-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--care-color);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    margin-top: var(--space-1);
  }

  .pw-care__card-cta svg {
    transition: transform var(--transition-base);
  }

  .pw-care__card:hover .pw-care__card-cta svg {
    transform: translateX(3px);
  }

  @media (min-width: 640px) {
    .pw-care {
      padding-inline: var(--content-padding);
    }

    .pw-care__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .pw-care {
      padding-inline: var(--content-padding-wide);
    }

    .pw-care__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pw-care__card,
    .pw-care__card-cta svg {
      transition: none;
    }

    .pw-care__card:hover {
      transform: none;
    }
  }
</style>
