---
/**
 * HomeHeroClean.astro — PupWiki homepage hero v4
 * Full-bleed photo background with dark navy overlay, serif headline,
 * orange accent, CTA pair, trust badges, and floating search card.
 */

export interface Cta {
  label: string;
  href: string;
  ariaLabel?: string;
}

export interface Props {
  id?: string;
  title?: string;
  accent?: string;
  subtitle?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  trustItems?: string[];
  [key: string]: unknown;
}

const {
  id = 'home-hero',
  title = 'Find the right dog.',
  accent = 'Plan what comes next.',
  subtitle = 'Browse breed and mixed-breed guides, compare ownership costs, find name ideas, and get clear help with health, training, food, grooming and everyday care.',
  primaryCta = { label: 'Browse Breeds', href: '/breeds', ariaLabel: 'Browse dog breed and mixed-breed guides on PupWiki' },
  secondaryCta = { label: 'Estimate Costs', href: '/cost-calculator', ariaLabel: 'Open the PupWiki dog cost calculator' },
  trustItems = ['352 breed & mix guides', '75 mixed breeds', '5,000+ dog names', 'Cost & care tools'],
} = Astro.props;

const trustBadges = trustItems;

const quickLinkIcons: Record<string, string> = {
  breeds: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="15" height="15"><path d="M8.8 7.6c.8-.9 1.9-1.4 3.2-1.4s2.4.5 3.2 1.4"/><path d="M7.5 9.2c-1.5-.5-2.7.2-3.1 1.5-.5 1.6.4 3.2 2 3.7"/><path d="M16.5 9.2c1.5-.5 2.7.2 3.1 1.5.5 1.6-.4 3.2-2 3.7"/><path d="M8 14.5c.8 2 2.1 3 4 3s3.2-1 4-3"/><circle cx="10" cy="11" r="0.5" fill="currentColor"/><circle cx="14" cy="11" r="0.5" fill="currentColor"/></svg>`,
  cost: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="15" height="15"><circle cx="12" cy="12" r="9"/><path d="M12 7v10"/><path d="M15 9.2c-.7-.8-1.7-1.2-3-1.2-1.5 0-2.5.8-2.5 2s.9 1.7 2.7 2.1c1.9.4 2.8 1.1 2.8 2.4S13.8 17 12.1 17c-1.4 0-2.6-.5-3.4-1.4"/></svg>`,
  names: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="15" height="15"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>`,
  health: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="15" height="15"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
};

const quickLinks = [
  { label: 'Breed Guides', href: '/breeds', iconKey: 'breeds' },
  { label: 'Cost Calculator', href: '/cost-calculator', iconKey: 'cost' },
  { label: 'Dog Names', href: '/dog-names', iconKey: 'names' },
  { label: 'Health & Care', href: '/categories/health', iconKey: 'health' },
];
---

<section id={id} class="pw-hero" aria-labelledby={`${id}-heading`}>
  <!-- Full-bleed background photo + overlay -->
  <div class="pw-hero__bg" aria-hidden="true">
    <img
      src="/hero/dog-owner-hero.jpg"
      alt=""
      class="pw-hero__photo"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      width="1920"
      height="1080"
    />
    <div class="pw-hero__overlay"></div>
  </div>

  <div class="pw-hero__shell">
    <!-- Left: headline + CTAs + trust -->
    <div class="pw-hero__content">
      <span class="pw-hero__eyebrow">Dog breeds, costs, names and care</span>

      <h1 id={`${id}-heading`} class="pw-hero__title">
        {title}
        <em class="pw-hero__accent">{accent}</em>
      </h1>

      <p class="pw-hero__subtitle">{subtitle}</p>

      <div class="pw-hero__actions" aria-label="Main actions">
        <a
          href={primaryCta.href}
          class="pw-hero__btn pw-hero__btn--primary"
          aria-label={primaryCta.ariaLabel || primaryCta.label}
        >
          {primaryCta.label}
          <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
        <a
          href={secondaryCta.href}
          class="pw-hero__btn pw-hero__btn--outline"
          aria-label={secondaryCta.ariaLabel || secondaryCta.label}
        >
          {secondaryCta.label}
        </a>
      </div>

      <div class="pw-hero__trust" role="list" aria-label="PupWiki at a glance">
        {trustBadges.map((badge, i) => (
          <Fragment>
            <span role="listitem" class="pw-hero__trust-badge">{badge}</span>
            {i < trustBadges.length - 1 && <span class="pw-hero__trust-sep" aria-hidden="true">·</span>}
          </Fragment>
        ))}
      </div>
    </div>

    <!-- Right: floating search + quick links card -->
    <aside class="pw-hero__card" aria-label="Find a dog breed">
      <p class="pw-hero__card-heading">Find a dog breed</p>

      <form action="/breeds" method="GET" class="pw-hero__search-form" role="search">
        <label for={`${id}-search`} class="pw-hero__sr-only">Search dog breeds and mixes</label>
        <div class="pw-hero__search-wrap">
          <svg class="pw-hero__search-icon" viewBox="0 0 24 24" aria-hidden="true" width="16" height="16">
            <circle cx="11" cy="11" r="7"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
          <input
            id={`${id}-search`}
            type="search"
            name="q"
            placeholder="Search breeds and mixes…"
            class="pw-hero__search-input"
            autocomplete="off"
          />
        </div>
        <button type="submit" class="pw-hero__search-btn">Search</button>
      </form>

      <div class="pw-hero__card-divider" aria-hidden="true"></div>

      <p class="pw-hero__card-nav-label">Start here</p>
      <nav class="pw-hero__card-nav" aria-label="Quick navigation">
        {quickLinks.map((link) => (
          <a href={link.href} class="pw-hero__card-link">
            <span class="pw-hero__card-link-icon" aria-hidden="true">
              <Fragment set:html={quickLinkIcons[link.iconKey]} />
            </span>
            <span>{link.label}</span>
            <svg class="pw-hero__card-link-arrow" viewBox="0 0 24 24" aria-hidden="true" width="14" height="14">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
        ))}
      </nav>
    </aside>
  </div>
</section>

<style>
  /* ── Base ── */
  .pw-hero {
    position: relative;
    isolation: isolate;
    min-height: min(88vh, 720px);
    display: flex;
    align-items: center;
    color: var(--color-text-inverse);
    overflow: hidden;
  }

  /* ── Background ── */
  .pw-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .pw-hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
  }

  .pw-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      108deg,
      rgba(11, 31, 54, 0.95) 0%,
      rgba(11, 31, 54, 0.85) 32%,
      rgba(11, 31, 54, 0.6) 55%,
      rgba(11, 31, 54, 0.25) 75%,
      rgba(11, 31, 54, 0.08) 100%
    );
  }

  /* ── Shell (two-col layout) ── */
  .pw-hero__shell {
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding: var(--space-14) var(--content-padding-mobile) var(--space-12);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  /* ── Content column ── */
  .pw-hero__content {
    max-width: 52ch;
  }

  .pw-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    padding: var(--space-1) var(--space-4);
    background: rgba(255, 122, 0, 0.16);
    border: 1px solid rgba(255, 122, 0, 0.32);
    border-radius: var(--radius-full);
    color: var(--color-accent-light);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .pw-hero__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 8vw, 5rem);
    font-weight: var(--weight-bold);
    line-height: 1.06;
    letter-spacing: var(--tracking-snug);
    color: var(--color-text-inverse);
    text-wrap: balance;
  }

  .pw-hero__accent {
    display: block;
    font-style: normal;
    color: var(--color-accent);
    margin-top: 0.06em;
  }

  .pw-hero__subtitle {
    margin: var(--space-5) 0 0;
    max-width: 44ch;
    color: rgba(255, 255, 255, 0.80);
    font-size: clamp(var(--text-base), 1.8vw, var(--text-lg));
    line-height: var(--leading-relaxed);
  }

  /* ── CTAs ── */
  .pw-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .pw-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-lg);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    line-height: 1;
    text-decoration: none;
    transition: var(--transition-smooth);
    white-space: nowrap;
  }

  .pw-hero__btn svg {
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pw-hero__btn--primary {
    background: var(--color-cta);
    color: var(--color-text-inverse);
    box-shadow: var(--shadow-cta);
    border: 1.5px solid transparent;
  }

  .pw-hero__btn--primary:hover {
    background: var(--color-cta-hover);
    transform: translateY(-2px);
    box-shadow: 0 16px 32px rgba(234, 106, 0, 0.42);
  }

  .pw-hero__btn--outline {
    background: rgba(255, 255, 255, 0.10);
    color: var(--color-text-inverse);
    border: 1.5px solid rgba(255, 255, 255, 0.40);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .pw-hero__btn--outline:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.60);
    transform: translateY(-2px);
  }

  /* ── Trust badges ── */
  .pw-hero__trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-7);
  }

  .pw-hero__trust-badge {
    color: rgba(255, 255, 255, 0.70);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .pw-hero__trust-sep {
    color: rgba(255, 255, 255, 0.28);
    font-size: var(--text-sm);
  }

  /* ── Floating search card ── */
  .pw-hero__card {
    background: var(--color-bg);
    border-radius: var(--radius-2xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-xl);
    border: 1px solid rgba(255, 255, 255, 0.9);
  }

  .pw-hero__card-heading {
    margin: 0 0 var(--space-4);
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-snug);
  }

  /* ── Search form ── */
  .pw-hero__search-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .pw-hero__search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .pw-hero__search-icon {
    position: absolute;
    left: var(--space-3);
    flex-shrink: 0;
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
    z-index: 1;
  }

  .pw-hero__search-input {
    width: 100%;
    padding: var(--space-3) var(--space-3) var(--space-3) calc(var(--space-3) + 1.6rem);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    color: var(--color-heading);
    background: var(--color-bg-muted);
    outline: none;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
    -webkit-appearance: none;
    appearance: none;
  }

  .pw-hero__search-input:focus {
    border-color: var(--color-primary);
    background: var(--color-bg);
    box-shadow: var(--ring-primary);
  }

  .pw-hero__search-input::placeholder {
    color: var(--color-placeholder);
  }

  .pw-hero__search-btn {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--color-primary);
    color: var(--color-text-inverse);
    border: none;
    border-radius: var(--radius-lg);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    cursor: pointer;
    transition: background var(--transition-base), transform var(--transition-base);
  }

  .pw-hero__search-btn:hover {
    background: var(--color-primary-hover);
    transform: translateY(-1px);
  }

  /* ── Card nav ── */
  .pw-hero__card-divider {
    height: 1px;
    background: var(--color-border-soft);
    margin: var(--space-5) 0 var(--space-4);
  }

  .pw-hero__card-nav-label {
    margin: 0 0 var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .pw-hero__card-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }

  .pw-hero__card-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg-muted);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-md);
    color: var(--color-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition: var(--transition-base);
  }

  .pw-hero__card-link:hover {
    background: var(--color-primary-subtle);
    border-color: rgba(21, 54, 95, 0.18);
    color: var(--color-primary);
  }

  .pw-hero__card-link-icon {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .pw-hero__card-link-icon svg {
    display: block;
  }

  .pw-hero__card-link-arrow {
    margin-left: auto;
    flex-shrink: 0;
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .pw-hero__card-link:hover .pw-hero__card-link-arrow {
    opacity: 1;
    transform: translateX(2px);
  }

  /* ── Accessibility ── */
  .pw-hero__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Responsive ── */
  @media (min-width: 640px) {
    .pw-hero__shell {
      padding-inline: var(--content-padding);
    }

    .pw-hero__actions {
      flex-wrap: nowrap;
    }
  }

  @media (min-width: 1024px) {
    .pw-hero__shell {
      grid-template-columns: 1fr min(420px, 40%);
      gap: var(--space-16);
      padding-inline: var(--content-padding-wide);
      padding-block: var(--space-24) var(--space-20);
    }

    .pw-hero__overlay {
      background: linear-gradient(
        108deg,
        rgba(11, 31, 54, 0.96) 0%,
        rgba(11, 31, 54, 0.88) 28%,
        rgba(11, 31, 54, 0.62) 52%,
        rgba(11, 31, 54, 0.28) 72%,
        rgba(11, 31, 54, 0.06) 100%
      );
    }
  }

  @media (min-width: 1280px) {
    .pw-hero__title {
      font-size: clamp(3.8rem, 5.2vw, 5.2rem);
    }
  }

  @media (max-width: 480px) {
    .pw-hero {
      min-height: min(80vh, 680px);
    }

    .pw-hero__shell {
      padding-block: var(--space-10) var(--space-8);
      padding-inline: var(--space-5);
    }

    .pw-hero__title {
      font-size: clamp(2rem, 11vw, 3rem);
    }

    .pw-hero__subtitle {
      font-size: var(--text-base);
    }

    .pw-hero__trust-badge {
      font-size: var(--text-xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pw-hero__btn,
    .pw-hero__card-link,
    .pw-hero__search-btn {
      transition: none;
    }

    .pw-hero__btn:hover,
    .pw-hero__card-link:hover,
    .pw-hero__search-btn:hover {
      transform: none;
    }
  }
</style>