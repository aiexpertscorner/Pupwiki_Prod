---
export interface GoalItem {
  label: string;
  href: string;
}

export interface GoalCard {
  title: string;
  items: GoalItem[];
}

export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  goalCard?: GoalCard;
  trustItems?: string[];
}

const {
  eyebrow = 'Dog breed, cost and care tools',
  title = 'Choose the right dog. Plan the real cost. Care with confidence.',
  subtitle = 'Compare breeds, estimate ownership costs, build puppy checklists, and explore practical care guidance from PupWiki’s dog decision tools.',
  primaryCta = { label: 'Find my breed match', href: '/tools/breed-match' },
  secondaryCta = { label: 'Estimate dog costs', href: '/cost-calculator' },
  goalCard = {
    title: 'Start with your goal',
    items: [
      { label: 'I’m choosing a dog', href: '/tools/breed-match' },
      { label: 'I’m comparing breeds', href: '/tools/compare' },
      { label: 'I’m planning a puppy', href: '/tools/puppy-cost' },
      { label: 'I already have a dog', href: '/guides' },
    ],
  },
  trustItems = ['277+ breed guides', '75 mixed breeds', '5,000+ dog names', 'Free to use'],
} = Astro.props;
---

<section class="pw-home-hero" aria-label="PupWiki — dog decision tools">
  <div class="pw-home-hero__shell">
    <div class="pw-home-hero__grid">

      <!-- Left: headline + CTAs -->
      <div class="pw-home-hero__content">
        <p class="pw-home-hero__eyebrow">{eyebrow}</p>

        <h1 class="pw-home-hero__title">{title}</h1>

        <p class="pw-home-hero__subtitle">{subtitle}</p>

        <div class="pw-home-hero__actions">
          <a href={primaryCta.href} class="btn btn--primary pw-home-hero__btn-primary">
            {primaryCta.label}
          </a>
          <a href={secondaryCta.href} class="btn btn--outline pw-home-hero__btn-secondary">
            {secondaryCta.label}
          </a>
        </div>

        {trustItems && trustItems.length > 0 && (
          <ul class="pw-home-hero__trust" aria-label="PupWiki at a glance">
            {trustItems.map((item, i) => (
              <li class="pw-home-hero__trust-item">
                {i > 0 && <span class="pw-home-hero__trust-dot" aria-hidden="true">·</span>}
                {item}
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- Right: goal card -->
      <div class="pw-home-hero__aside">
        <div class="pw-home-hero__goal-card">
          <p class="pw-home-hero__goal-title">{goalCard.title}</p>
          <ul class="pw-home-hero__goal-list">
            {goalCard.items.map((item) => (
              <li>
                <a href={item.href} class="pw-home-hero__goal-link">
                  <span class="pw-home-hero__goal-arrow" aria-hidden="true">→</span>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
          <p class="pw-home-hero__goal-note">
            Free to use — no account required.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .pw-home-hero {
    background: var(--hero-bg);
    padding-block: var(--section-padding);
    padding-inline: var(--content-padding-mobile);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .pw-home-hero__shell {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .pw-home-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  .pw-home-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-semi);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .pw-home-hero__eyebrow::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .pw-home-hero__title {
    font-family: var(--font-serif);
    font-size: var(--text-h1);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-snug);
    color: var(--color-heading);
    margin-bottom: var(--space-5);
  }

  .pw-home-hero__subtitle {
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--color-body-soft);
    max-width: 58ch;
    margin-bottom: var(--space-8);
  }

  .pw-home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }

  .pw-home-hero__btn-primary {
    flex-shrink: 0;
  }

  .pw-home-hero__btn-secondary {
    flex-shrink: 0;
  }

  .pw-home-hero__trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pw-home-hero__trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .pw-home-hero__trust-dot {
    color: var(--color-border-strong);
    user-select: none;
  }

  /* Goal card */
  .pw-home-hero__goal-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-card);
    padding: var(--space-6);
  }

  .pw-home-hero__goal-title {
    font-size: var(--text-base);
    font-weight: var(--weight-semi);
    color: var(--color-heading);
    margin-bottom: var(--space-4);
  }

  .pw-home-hero__goal-list {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .pw-home-hero__goal-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-soft);
    background: var(--color-bg-soft);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-primary);
    text-decoration: none;
    transition: var(--transition-base);
  }

  .pw-home-hero__goal-link:hover {
    border-color: var(--color-border-primary);
    background: var(--color-primary-subtle);
    color: var(--color-primary-hover);
    transform: translateX(2px);
  }

  .pw-home-hero__goal-arrow {
    color: var(--color-accent);
    font-size: var(--text-base);
    flex-shrink: 0;
  }

  .pw-home-hero__goal-note {
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-align: center;
    margin: 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-soft);
  }

  /* Responsive */
  @media (min-width: 640px) {
    .pw-home-hero {
      padding-inline: var(--content-padding);
    }
  }

  @media (min-width: 960px) {
    .pw-home-hero__grid {
      grid-template-columns: 1fr 380px;
      gap: var(--space-16);
      align-items: center;
    }
  }

  @media (min-width: 1200px) {
    .pw-home-hero {
      padding-inline: var(--content-padding-wide);
    }

    .pw-home-hero__grid {
      grid-template-columns: 1fr 420px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pw-home-hero__goal-link {
      transition: none;
    }
  }
</style>
