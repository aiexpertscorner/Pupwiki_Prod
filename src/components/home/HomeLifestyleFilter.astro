---
export interface LifestyleItem {
  label: string;
  description: string;
  href: string;
  colorVar?: string;
}

export interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  items?: LifestyleItem[];
}

const {
  id = 'home-lifestyle-filter',
  eyebrow = 'Find your match',
  title = 'What kind of dog fits you?',
  subtitle = 'Start with your lifestyle — then explore breeds that actually match.',
  items = [],
} = Astro.props;

const svgIcons: Record<string, string> = {
  'Apartment Friendly': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 22V10l9-7 9 7v12"/><path d="M9 22v-6h6v6"/><rect x="9" y="10" width="6" height="5" rx="1"/></svg>`,
  'Active & Outdoorsy': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 17 4-8 4 4 3-6 4 4 3-6"/><circle cx="12" cy="5" r="1" fill="currentColor"/></svg>`,
  'Family with Kids': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  'Low-Shedding': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a10 10 0 0 1 10 10c0 5.52-4.48 10-10 10S2 17.52 2 12c0-2.76 1.12-5.26 2.93-7.07"/><path d="M8 10c0 2.21 1.79 4 4 4s4-1.79 4-4-1.79-4-4-4"/><path d="M12 6V2"/></svg>`,
  'Easy to Train': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
  'Calm Companion': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>`,
};

const defaultColorVar = '--color-primary';
---

<section id={id} class="pw-lifestyle">
  <div class="pw-lifestyle__shell">

    <div class="pw-lifestyle__head">
      <p class="pw-lifestyle__eyebrow">{eyebrow}</p>
      <h2 class="pw-lifestyle__title">{title}</h2>
      <p class="pw-lifestyle__subtitle">{subtitle}</p>
    </div>

    {items.length > 0 && (
      <div class="pw-lifestyle__grid">
        {items.map((item) => {
          const colorVar = item.colorVar || defaultColorVar;
          const icon = svgIcons[item.label];
          return (
            <a href={item.href} class="pw-lifestyle__card">
              <div
                class="pw-lifestyle__icon"
                style={`--card-color: var(${colorVar}); --card-color-bg: color-mix(in srgb, var(${colorVar}) 12%, transparent);`}
              >
                {icon && <Fragment set:html={icon} />}
              </div>
              <div class="pw-lifestyle__card-body">
                <p class="pw-lifestyle__card-label">{item.label}</p>
                <p class="pw-lifestyle__card-desc">{item.description}</p>
              </div>
              <span class="pw-lifestyle__arrow" aria-hidden="true">→</span>
            </a>
          );
        })}
      </div>
    )}

  </div>
</section>

<style>
  .pw-lifestyle {
    background: var(--color-bg-soft);
    padding: var(--section-padding-sm) var(--content-padding-mobile);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .pw-lifestyle__shell {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .pw-lifestyle__head {
    max-width: 44rem;
    margin-bottom: var(--space-8);
  }

  .pw-lifestyle__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .pw-lifestyle__title {
    margin: 0 0 var(--space-3);
    color: var(--color-heading);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-tight);
  }

  .pw-lifestyle__subtitle {
    margin: 0;
    color: var(--color-body-soft);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }

  .pw-lifestyle__grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }

  @media (min-width: 480px) {
    .pw-lifestyle__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .pw-lifestyle__card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xs);
    text-decoration: none;
    color: inherit;
    transition: var(--transition-smooth);
    position: relative;
  }

  .pw-lifestyle__card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-card-hover);
  }

  .pw-lifestyle__icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-lg);
    background: var(--card-color-bg, var(--color-primary-subtle));
    color: var(--card-color, var(--color-primary));
  }

  .pw-lifestyle__icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .pw-lifestyle__card-body {
    flex: 1;
    min-width: 0;
  }

  .pw-lifestyle__card-label {
    margin: 0 0 var(--space-1);
    color: var(--color-heading);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
  }

  .pw-lifestyle__card-desc {
    margin: 0;
    color: var(--color-body-soft);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  .pw-lifestyle__arrow {
    flex-shrink: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
    transition: transform var(--transition-base);
  }

  .pw-lifestyle__card:hover .pw-lifestyle__arrow {
    transform: translateX(3px);
    color: var(--color-primary);
  }

  @media (min-width: 640px) {
    .pw-lifestyle {
      padding-inline: var(--content-padding);
    }

    .pw-lifestyle__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .pw-lifestyle__card {
      padding: var(--space-5);
    }
  }

  @media (min-width: 1024px) {
    .pw-lifestyle__grid {
      grid-template-columns: repeat(6, 1fr);
    }

    .pw-lifestyle__card {
      flex-direction: column;
      gap: var(--space-3);
    }

    .pw-lifestyle__arrow {
      display: none;
    }
  }

  @media (min-width: 1280px) {
    .pw-lifestyle {
      padding-inline: var(--content-padding-wide);
    }
  }
</style>
