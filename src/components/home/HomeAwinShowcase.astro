---
import awinProgramsData from '../../data/awin-programs.json';
import affiliateProducts from '../../data/affiliate-products.json';
import awinProducts from '../../data/awin-products.json';
import staticConfigRaw from '../../data/awin-program-config.json';

const staticConfig: any = staticConfigRaw;

// ── Programs ──────────────────────────────────────────────────────────────────
const joinedPrograms: any[] = (awinProgramsData as any).programs.filter(
  (p: any) => p.relationship === 'joined'
);

const scMap: Record<string, any> = {};
for (const p of staticConfig.programs || []) scMap[p.id] = p;

const PROGRAM_DESCRIPTIONS: Record<string, string> = {
  'brutus-broth':   'Premium bone broth supplements — nutrition, hydration, and picky-eater support',
  'radiofence-com': 'Pet containment systems, invisible fences, and smart training gear',
  'petmate':        'Everyday dog essentials — beds, crates, travel carriers, and feeders',
  'mypetdmv-the-original-pet-drivers-license': 'Fun custom pet ID licenses and novelty gifts for dog lovers',
};

function formatCommission(range: any[]): string {
  if (!Array.isArray(range) || !range.length) return '';
  const pct = range.find((r: any) => r.type === 'percentage');
  if (!pct) return '';
  const max = Number(pct.max ?? pct.min ?? 0);
  const min = Number(pct.min ?? 0);
  if (max <= 0) return '';
  return min > 0 && min < max ? `${min}–${max}%` : `Up to ${max}%`;
}

const enrichedPrograms = joinedPrograms
  .map((p: any) => {
    const sc = scMap[p.key] || {};
    const deeplink = p.configuredDeeplink || p.deeplink || '#';
    const commission = formatCommission(p.commissionRange || []);
    const convPct = Number(p.kpi?.conversionRate ?? 0).toFixed(1);
    const epc = Number(p.kpi?.epc ?? sc.epc ?? 0);
    const description =
      sc.description ||
      PROGRAM_DESCRIPTIONS[p.key] ||
      `${p.primarySector} partner`;
    return {
      key: p.key,
      name: (sc.label || p.name || '').replace(/\s*-\s*The original.*$/i, ''),
      logoUrl: p.logoUrl,
      deeplink,
      commission,
      convPct,
      epc,
      description,
      priority: sc.priority ?? p.priority ?? 50,
      hasTidd: deeplink.includes('tidd.ly'),
      sector: p.primarySector || 'Pets & Pet Care',
      topicTags: p.topicTags || [],
      cta: sc.cta || `Visit ${(sc.label || p.name || '').split(' ')[0]}`,
    };
  })
  .sort((a: any, b: any) => b.priority - a.priority);

// ── Carousel products ─────────────────────────────────────────────────────────
const afMerchantKeys = new Set(
  (affiliateProducts as any[]).map((p: any) =>
    String(p.merchant || '').toLowerCase().replace(/[^a-z]/g, '')
  )
);

const supplemental = (Array.isArray(awinProducts) ? (awinProducts as any[]) : []).filter(
  (p: any) => {
    const mk = String(p.merchant || '').toLowerCase().replace(/[^a-z]/g, '');
    return !afMerchantKeys.has(mk) && p.url;
  }
);

// Enrich supplemental products with short names and descriptions
const SUPPLEMENTAL_OVERRIDES: Record<string, { name: string; description: string; image?: string }> = {
  'brutus-broth-partner-offer': {
    name: 'Brutus Broth Dog Supplements',
    description: 'All-natural bone broth for dogs — great for picky eaters and digestion support.',
  },
  'radiofence-com-partner-offer': {
    name: 'RadioFence Pet Containment',
    description: 'Smart pet fencing and containment systems trusted by dog trainers.',
  },
  'petmate-partner-offer': {
    name: 'Petmate Pet Essentials',
    description: 'Quality beds, crates, carriers, and feeders for everyday dog life.',
  },
  'mypetdmv-the-original-pet-drivers-license-partner-offer': {
    name: 'MyPetDMV Custom Pet ID',
    description: 'Fun novelty pet drivers license and custom ID gifts for dog lovers.',
  },
};

const carouselProducts: any[] = [
  ...(affiliateProducts as any[]),
  ...supplemental.map((p: any) => ({
    ...p,
    ...(SUPPLEMENTAL_OVERRIDES[p.id] || {}),
  })),
];

// ── Logo strip ────────────────────────────────────────────────────────────────
const logoPrograms = enrichedPrograms.filter((p: any) => p.logoUrl);
// Duplicate for seamless loop
const logoRow1 = [...logoPrograms, ...logoPrograms];
const logoRow2 = [...logoPrograms, ...logoPrograms].reverse();

const truncate = (s: string, n: number) =>
  s && s.length > n ? s.slice(0, n).replace(/\s\S+$/, '') + '…' : (s || '');
---

<section id="home-awin-showcase" class="pw-awin">
  <div class="pw-awin__shell">

    <!-- ── Header ──────────────────────────────────────────────── -->
    <header class="pw-awin__header">
      <p class="pw-awin__eyebrow">Partner recommendations</p>
      <h2 class="pw-awin__title">Products dog owners actually buy</h2>
      <p class="pw-awin__subtitle">
        Hand-picked from our {enrichedPrograms.length} active affiliate partners — reader-supported, editorially independent.
      </p>
    </header>

    <!-- ── Logo strip (infinite scroll) ───────────────────────── -->
    <div class="pw-awin__logo-strip" aria-hidden="true">
      <div class="pw-awin__logo-track pw-awin__logo-track--fwd">
        {logoRow1.map(p => (
          <a href={p.deeplink} rel="nofollow sponsored" target="_blank" class="pw-awin__logo-item" title={p.name}>
            <img src={p.logoUrl} alt={p.name} width="80" height="40" loading="lazy" decoding="async" class="pw-awin__logo-img" />
          </a>
        ))}
      </div>
      <div class="pw-awin__logo-track pw-awin__logo-track--rev">
        {logoRow2.map(p => (
          <a href={p.deeplink} rel="nofollow sponsored" target="_blank" class="pw-awin__logo-item" title={p.name}>
            <img src={p.logoUrl} alt={p.name} width="80" height="40" loading="lazy" decoding="async" class="pw-awin__logo-img" />
          </a>
        ))}
      </div>
    </div>

    <!-- ── Product carousel ────────────────────────────────────── -->
    <div class="pw-awin__carousel-section">
      <div class="pw-awin__carousel-head">
        <h3 class="pw-awin__carousel-title">Featured products</h3>
        <div class="pw-awin__carousel-nav">
          <button id="awin-prev" class="pw-awin__nav-btn" aria-label="Previous products">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button id="awin-next" class="pw-awin__nav-btn" aria-label="Next products">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <div id="awin-carousel" class="pw-awin__carousel" role="region" aria-label="Partner product showcase">
        {carouselProducts.map((product: any) => {
          const hasImage = product.image && String(product.image).startsWith('http');
          const prog = enrichedPrograms.find((p: any) =>
            String(p.name).toLowerCase().includes(
              String(product.merchant || '').toLowerCase().split(' ')[0].toLowerCase()
            )
          );
          const deeplink = product.url || prog?.deeplink || '#';
          const price = Number(product.price) > 0 ? `$${Number(product.price).toFixed(2)}` : null;

          return (
            <a
              href={deeplink}
              rel="nofollow sponsored"
              target="_blank"
              class="pw-awin__product-card"
              data-affiliate-merchant={product.merchant}
              data-affiliate-product={product.id}
              data-affiliate-placement="homepage-showcase-carousel"
            >
              <div class="pw-awin__product-img-wrap">
                {hasImage ? (
                  <img
                    src={product.image}
                    alt={product.name}
                    class="pw-awin__product-img"
                    loading="lazy"
                    decoding="async"
                  />
                ) : prog?.logoUrl ? (
                  <div class="pw-awin__product-logo-fallback">
                    <img
                      src={prog.logoUrl}
                      alt={product.merchant}
                      class="pw-awin__product-logo-img"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ) : (
                  <div class="pw-awin__product-placeholder" aria-hidden="true">🐾</div>
                )}
                <span class="pw-awin__merchant-badge">{product.merchant?.split(' ')[0]}</span>
              </div>

              <div class="pw-awin__product-body">
                <h4 class="pw-awin__product-name">{truncate(product.name, 52)}</h4>
                <p class="pw-awin__product-desc">{truncate(product.description || '', 80)}</p>
                <div class="pw-awin__product-footer">
                  <span class="pw-awin__product-price">
                    {price || <span class="pw-awin__partner-tag">Partner offer</span>}
                  </span>
                  <span class="pw-awin__product-cta">
                    Shop now
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="13" height="13" aria-hidden="true">
                      <path d="M5 12h14M13 6l6 6-6 6"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <!-- Dot indicators (JS fills these) -->
      <div id="awin-dots" class="pw-awin__dots" role="tablist" aria-label="Product carousel position"></div>
    </div>

    <!-- ── Partner programs grid ───────────────────────────────── -->
    <div class="pw-awin__partners">
      <h3 class="pw-awin__partners-title">All our active partners</h3>
      <div class="pw-awin__partners-grid">
        {enrichedPrograms.map((prog: any) => (
          <a
            href={prog.deeplink}
            rel="nofollow sponsored"
            target="_blank"
            class={`pw-awin__partner-card${prog.hasTidd ? ' pw-awin__partner-card--featured' : ''}`}
            data-affiliate-merchant={prog.key}
            data-affiliate-placement="homepage-partner-grid"
          >
            <div class="pw-awin__partner-head">
              <div class="pw-awin__partner-logo-wrap">
                {prog.logoUrl ? (
                  <img
                    src={prog.logoUrl}
                    alt={prog.name}
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                    class="pw-awin__partner-logo"
                  />
                ) : (
                  <span class="pw-awin__partner-logo-placeholder">🐾</span>
                )}
              </div>
              <div class="pw-awin__partner-meta">
                <h4 class="pw-awin__partner-name">{prog.name}</h4>
                <span class="pw-awin__partner-sector">{prog.sector}</span>
              </div>
            </div>

            <p class="pw-awin__partner-desc">{prog.description}</p>

            {prog.topicTags.length > 0 && (
              <div class="pw-awin__partner-tags">
                {prog.topicTags.slice(0, 3).map((tag: string) => (
                  <span class="pw-awin__partner-tag">{String(tag).replace(/-/g, ' ')}</span>
                ))}
              </div>
            )}

            <span class="pw-awin__partner-cta">
              {prog.cta}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="13" height="13" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- ── Disclosure ───────────────────────────────────────────── -->
    <p class="pw-awin__disclosure">
      Reader-supported links — we earn a commission at no extra cost to you.
      <a href="/disclosure" class="pw-awin__disclosure-link">See full disclosure →</a>
    </p>

  </div>
</section>

<style>
  /* ── Section ───────────────────────────────────────── */
  .pw-awin {
    background: var(--color-bg-soft);
    padding: var(--section-padding) var(--content-padding-mobile);
    overflow: hidden;
  }

  .pw-awin__shell {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  /* ── Header ────────────────────────────────────────── */
  .pw-awin__header {
    max-width: 52ch;
    margin-bottom: var(--space-10);
  }

  .pw-awin__eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-cta);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .pw-awin__title {
    margin: 0 0 var(--space-3);
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-tight);
  }

  .pw-awin__subtitle {
    margin: 0;
    color: var(--color-body-soft);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  /* ── Logo strip ────────────────────────────────────── */
  .pw-awin__logo-strip {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    overflow: hidden;
    padding: var(--space-4) 0;
    margin-bottom: var(--space-12);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .pw-awin__logo-track {
    display: flex;
    gap: var(--space-6);
    will-change: transform;
  }

  .pw-awin__logo-track--fwd {
    animation: logoScrollFwd 22s linear infinite;
  }

  .pw-awin__logo-track--rev {
    animation: logoScrollRev 28s linear infinite;
  }

  @keyframes logoScrollFwd {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @keyframes logoScrollRev {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0); }
  }

  .pw-awin__logo-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 120px;
    height: 48px;
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-base);
  }

  .pw-awin__logo-item:hover {
    border-color: var(--color-primary);
  }

  .pw-awin__logo-img {
    max-width: 80px;
    max-height: 32px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(0.3);
    transition: filter var(--transition-base);
  }

  .pw-awin__logo-item:hover .pw-awin__logo-img {
    filter: grayscale(0);
  }

  /* ── Carousel section ──────────────────────────────── */
  .pw-awin__carousel-section {
    margin-bottom: var(--space-14);
  }

  .pw-awin__carousel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-5);
  }

  .pw-awin__carousel-title {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-snug);
  }

  .pw-awin__carousel-nav {
    display: flex;
    gap: var(--space-2);
  }

  .pw-awin__nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-body);
    cursor: pointer;
    transition: var(--transition-base);
  }

  .pw-awin__nav-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    box-shadow: var(--shadow-card);
  }

  /* ── Carousel track ────────────────────────────────── */
  .pw-awin__carousel {
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: var(--space-3);
    -webkit-overflow-scrolling: touch;
    /* hide scrollbar */
    scrollbar-width: none;
  }

  .pw-awin__carousel::-webkit-scrollbar {
    display: none;
  }

  /* ── Product cards ─────────────────────────────────── */
  .pw-awin__product-card {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    width: 260px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-card);
    scroll-snap-align: start;
    transition: var(--transition-smooth);
  }

  .pw-awin__product-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-cta);
  }

  .pw-awin__product-img-wrap {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg-cool);
    flex-shrink: 0;
  }

  .pw-awin__product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .pw-awin__product-card:hover .pw-awin__product-img {
    transform: scale(1.06);
  }

  .pw-awin__product-logo-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-bg-cool) 0%, var(--color-border) 100%);
    padding: var(--space-6);
  }

  .pw-awin__product-logo-img {
    max-width: 100px;
    max-height: 50px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(0.1);
  }

  .pw-awin__product-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    background: var(--color-bg-cool);
  }

  .pw-awin__merchant-badge {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    padding: 2px var(--space-2);
    background: var(--color-cta);
    border-radius: var(--radius-md);
    color: var(--color-text-inverse);
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.6;
  }

  .pw-awin__product-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    flex: 1;
  }

  .pw-awin__product-name {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
  }

  .pw-awin__product-desc {
    margin: 0;
    flex: 1;
    color: var(--color-body-soft);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
  }

  .pw-awin__product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .pw-awin__product-price {
    color: var(--color-heading);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    line-height: 1;
  }

  .pw-awin__partner-tag {
    color: var(--color-body-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  .pw-awin__product-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    flex-shrink: 0;
    padding: var(--space-2) var(--space-3);
    background: var(--color-cta);
    border-radius: var(--radius-lg);
    color: var(--color-text-inverse);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    white-space: nowrap;
    transition: opacity var(--transition-base);
  }

  .pw-awin__product-card:hover .pw-awin__product-cta {
    opacity: 0.88;
  }

  /* ── Dots ──────────────────────────────────────────── */
  .pw-awin__dots {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .pw-awin__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--color-border-strong);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background var(--transition-base), transform var(--transition-base);
  }

  .pw-awin__dot--active {
    background: var(--color-cta);
    transform: scale(1.3);
  }

  /* ── Partners grid ─────────────────────────────────── */
  .pw-awin__partners {
    margin-bottom: var(--space-6);
  }

  .pw-awin__partners-title {
    margin: 0 0 var(--space-6);
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-snug);
  }

  .pw-awin__partners-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .pw-awin__partner-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-card);
    transition: var(--transition-smooth);
  }

  .pw-awin__partner-card--featured {
    border-color: var(--color-primary);
  }

  .pw-awin__partner-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-primary);
  }

  .pw-awin__partner-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .pw-awin__partner-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    overflow: hidden;
    padding: var(--space-1-5);
  }

  .pw-awin__partner-logo {
    max-width: 40px;
    max-height: 32px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .pw-awin__partner-logo-placeholder {
    font-size: 1.5rem;
