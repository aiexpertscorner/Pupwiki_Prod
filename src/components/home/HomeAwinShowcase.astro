<script is:inline>
(function () {
  var carousel = document.getElementById('awin-carousel');
  var dotsContainer = document.getElementById('awin-dots');
  var prevBtn = document.getElementById('awin-prev');
  var nextBtn = document.getElementById('awin-next');
  if (!carousel) return;

  var cards = Array.prototype.slice.call(
    carousel.querySelectorAll('.pw-awin__product-card')
  );
  var CARD_W = 0; // measured after layout

  // Shuffle on page load for variety
  cards.sort(function () { return Math.random() - 0.5; }).forEach(function (c) {
    carousel.appendChild(c);
  });

  // Measure card width after it's in the DOM
  function measureCard() {
    var first = carousel.querySelector('.pw-awin__product-card');
    if (!first) return 284;
    var style = window.getComputedStyle(carousel);
    var gap = parseFloat(style.gap) || parseFloat(style.columnGap) || 16;
    return first.getBoundingClientRect().width + gap;
  }

  // Build dot indicators (one per visible "page")
  function buildDots() {
    dotsContainer.innerHTML = '';
    CARD_W = measureCard();
    var pageCount = Math.ceil(cards.length / Math.max(1, Math.round(carousel.clientWidth / CARD_W)));
    for (var i = 0; i < Math.min(pageCount, 12); i++) {
      var dot = document.createElement('button');
      dot.className = 'pw-awin__dot' + (i === 0 ? ' pw-awin__dot--active' : '');
      dot.setAttribute('aria-label', 'Go to page ' + (i + 1));
      dot.setAttribute('role', 'tab');
      (function (idx) {
        dot.addEventListener('click', function () {
          stopAuto();
          carousel.scrollTo({ left: idx * CARD_W * Math.round(carousel.clientWidth / CARD_W), behavior: 'smooth' });
          startAuto();
        });
      })(i);
      dotsContainer.appendChild(dot);
    }
  }

  function updateDots() {
    var dots = dotsContainer.querySelectorAll('.pw-awin__dot');
    if (!dots.length) return;
    var perPage = Math.max(1, Math.round(carousel.clientWidth / CARD_W));
    var pageIdx = Math.round(carousel.scrollLeft / (CARD_W * perPage));
    dots.forEach(function (d, i) {
      d.classList.toggle('pw-awin__dot--active', i === pageIdx % dots.length);
    });
  }

  var scrollNext = function () {
    var cl = carousel.scrollLeft;
    var sw = carousel.scrollWidth;
    var cw = carousel.clientWidth;
    if (cl + cw >= sw - 20) {
      carousel.scrollTo({ left: 0, behavior: 'smooth' });
    } else {
      carousel.scrollBy({ left: CARD_W, behavior: 'smooth' });
    }
  };

  var scrollPrev = function () {
    carousel.scrollBy({ left: -CARD_W, behavior: 'smooth' });
  };

  var autoTimer;
  var startAuto = function () { autoTimer = setInterval(scrollNext, 5000); };
  var stopAuto  = function () { clearInterval(autoTimer); };

  carousel.addEventListener('mouseenter', stopAuto);
  carousel.addEventListener('mouseleave', startAuto);
  carousel.addEventListener('touchstart', stopAuto, { passive: true });
  carousel.addEventListener('touchend', startAuto, { passive: true });

  if (prevBtn) {
    prevBtn.addEventListener('click', function () { stopAuto(); scrollPrev(); startAuto(); });
  }
  if (nextBtn) {
    nextBtn.addEventListener('click', function () { stopAuto(); scrollNext(); startAuto(); });
  }

  var scrollDebounce;
  carousel.addEventListener('scroll', function () {
    clearTimeout(scrollDebounce);
    scrollDebounce = setTimeout(updateDots, 80);
  });

  // Init
  buildDots();
  startAuto();

  // Rebuild dots on resize
  var resizeTimer;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () { CARD_W = measureCard(); buildDots(); }, 200);
  });
})();
</script>
