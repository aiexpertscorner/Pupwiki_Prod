---
import type { HomepageBreedCard } from '../../lib/homepage/getHomepageData';

export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  breeds?: HomepageBreedCard[];
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  mixedBreedsLink?: { label: string; href: string };
}

const {
  eyebrow = 'Breed guides',
  title = 'Explore popular breeds',
  subtitle = 'Start with familiar favorites, then explore the full directory to find breeds that match your lifestyle.',
  breeds = [],
  primaryCta = { label: 'Browse all breed guides', href: '/breeds' },
  secondaryCta = { label: 'Compare breeds', href: '/tools/compare' },
  mixedBreedsLink = { label: 'Also: mixed breed guides →', href: '/breeds' },
} = Astro.props;

function breedHref(slug: string): string {
  return `/breeds/${slug}`;
}

function tagLabel(breed: HomepageBreedCard): string {
  const parts: string[] = [];
  if (breed.size) parts.push(breed.size.charAt(0).toUpperCase() + breed.size.slice(1));
  if (breed.energy) parts.push(breed.energy.charAt(0).toUpperCase() + breed.energy.slice(1) + ' energy');
  if (parts.length === 0 && breed.tags.length > 0) return breed.tags.slice(0, 2).join(' · ');
  return parts.join(' · ');
}
---

{breeds.length > 0 && (
  <section class="pw-breed-starter" aria-label="Popular breeds">
    <div class="pw-breed-starter__shell">

      <div class="pw-breed-starter__header">
        <div>
          {eyebrow && <p class="pw-breed-starter__eyebrow">{eyebrow}</p>}
          <h2 class="pw-breed-starter__title">{title}</h2>
          {subtitle && <p class="pw-breed-starter__subtitle">{subtitle}</p>}
        </div>
        <div class="pw-breed-starter__header-ctas">
          <a href={primaryCta.href} class="btn btn--primary btn--sm">{primaryCta.label}</a>
          {secondaryCta && (
            <a href={secondaryCta.href} class="btn btn--outline btn--sm">{secondaryCta.label}</a>
          )}
        </div>
      </div>

      <ul class="pw-breed-starter__grid" role="list">
        {breeds.map((breed) => (
          <li>
            <a href={breedHref(breed.slug)} class="pw-breed-starter__card">
              {breed.imageUrl ? (
                <div class="pw-breed-starter__card-media">
                  <img
                    src={breed.imageUrl}
                    alt={breed.imageAlt || `${breed.name} dog`}
                    class="pw-breed-starter__card-img"
                    loading="lazy"
                    decoding="async"
                    width="400"
                    height="300"
                  />
                </div>
              ) : (
                <div class="pw-breed-starter__card-media pw-breed-starter__card-media--placeholder">
                  <span class="pw-breed-starter__card-placeholder" aria-hidden="true">🐕</span>
                </div>
              )}
              <div class="pw-breed-starter__card-body">
                <h3 class="pw-breed-starter__card-name">{breed.name}</h3>
                <p class="pw-breed-starter__card-tag">{tagLabel(breed)}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <div class="pw-breed-starter__footer">
        <a href={primaryCta.href} class="pw-breed-starter__footer-link">
          {primaryCta.label}
        </a>
        {mixedBreedsLink && (
          <a href={mixedBreedsLink.href} class="pw-breed-starter__footer-link pw-breed-starter__footer-link--secondary">
            {mixedBreedsLink.label}
          </a>
        )}
      </div>

    </div>
  </section>
)}

<style>
  .pw-breed-starter {
    background: var(--color-bg);
    padding-block: var(--section-padding);
    padding-inline: var(--content-padding-mobile);
  }

  .pw-breed-starter__shell {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  /* Header */
  .pw-breed-starter__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  .pw-breed-starter__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-semi);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .pw-breed-starter__title {
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
    color: var(--color-heading);
    margin: 0 0 var(--space-3);
  }

  .pw-breed-starter__subtitle {
    font-size: var(--text-base);
    color: var(--color-body-soft);
    line-height: var(--leading-normal);
    max-width: 58ch;
    margin: 0;
  }

  .pw-breed-starter__header-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Grid */
  .pw-breed-starter__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Cards */
  .pw-breed-starter__card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: var(--transition-hover);
    height: 100%;
  }

  .pw-breed-starter__card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-3px);
    border-color: var(--color-border-primary);
  }

  .pw-breed-starter__card-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg-soft);
  }

  .pw-breed-starter__card-media--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-soft);
  }

  .pw-breed-starter__card-placeholder {
    font-size: 3rem;
    opacity: 0.4;
  }

  .pw-breed-starter__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .pw-breed-starter__card:hover .pw-breed-starter__card-img {
    transform: scale(1.04);
  }

  .pw-breed-starter__card-body {
    padding: var(--space-4);
  }

  .pw-breed-starter__card-name {
    font-size: var(--text-base);
    font-weight: var(--weight-semi);
    color: var(--color-heading);
    margin: 0 0 var(--space-1);
    line-height: var(--leading-snug);
  }

  .pw-breed-starter__card-tag {
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin: 0;
  }

  /* Footer */
  .pw-breed-starter__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-soft);
  }

  .pw-breed-starter__footer-link {
    font-size: var(--text-sm);
    font-weight: var(--weight-semi);
    color: var(--color-primary);
    text-decoration: none;
  }

  .pw-breed-starter__footer-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .pw-breed-starter__footer-link--secondary {
    color: var(--color-muted);
  }

  /* Responsive */
  @media (min-width: 480px) {
    .pw-breed-starter__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 640px) {
    .pw-breed-starter {
      padding-inline: var(--content-padding);
    }
  }

  @media (min-width: 768px) {
    .pw-breed-starter__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .pw-breed-starter__header {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }

    .pw-breed-starter__header-ctas {
      flex-shrink: 0;
      margin-top: var(--space-8);
    }
  }

  @media (min-width: 1200px) {
    .pw-breed-starter {
      padding-inline: var(--content-padding-wide);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pw-breed-starter__card,
    .pw-breed-starter__card-img {
      transition: none;
    }

    .pw-breed-starter__card:hover {
      transform: none;
    }

    .pw-breed-starter__card:hover .pw-breed-starter__card-img {
      transform: none;
    }
  }
</style>
