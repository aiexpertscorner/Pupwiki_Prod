---
import Icon from '../ui/Icon.astro';
import type { NormalizedBreed } from '../../lib/breeds/normalizeBreed';
import type { BreedHealthProfile } from '../../lib/breeds/breedDataAdapter';

interface Props {
  healthProfile: BreedHealthProfile | null;
  breed: NormalizedBreed;
  slug: string;
}

const { healthProfile, breed, slug } = Astro.props;
const b = breed.raw;
const COST_CALC_HREF = `/cost-calculator/${slug}`;

const SEVERITY_STYLES: Record<string, { className: string; label: string }> = {
  Low:           { className: 'is-low',         label: 'Low' },
  Medium:        { className: 'is-medium',       label: 'Medium' },
  'Medium-High': { className: 'is-medium-high',  label: 'Medium-High' },
  High:          { className: 'is-high',         label: 'High' },
  Critical:      { className: 'is-critical',     label: 'Critical' },
};
---

<section id="breed-health" class="breed-section" aria-labelledby="health-title">
  <div class="breed-section__header">
    <p class="breed-eyebrow breed-eyebrow--danger">Health watch</p>
    <h2 id="health-title">{b.name} Health Context</h2>
  </div>

  <div class="breed-health-note">
    <strong>Veterinary note</strong>
    {healthProfile
      ? <p>This section is general breed information, not veterinary advice. If your dog has symptoms, pain, breathing issues, sudden behavior changes, or urgent concerns, contact a veterinarian.</p>
      : <p>Regular veterinary check-ups, preventive care, and breed-aware monitoring are recommended for all dogs. Consult your vet for guidance specific to your {b.name}.</p>
    }
  </div>

  {healthProfile ? (
    <>
      <div class="breed-health-list">
        {(healthProfile.common_issues as any[]).map((issue) => {
          const severity = SEVERITY_STYLES[issue.severity] ?? SEVERITY_STYLES.Medium;
          return (
            <article class:list={['breed-health-card', severity.className]}>
              <div><span>{severity.label}</span></div>
              <div>
                <h3>{issue.name}</h3>
                {issue.prevalence && <em>{issue.prevalence} prevalence</em>}
                {issue.early_warning && <p><strong>Early signs:</strong> {issue.early_warning}</p>}
              </div>
            </article>
          );
        })}
      </div>
      {healthProfile.care_tips && (
        <div class="breed-callout breed-callout--info">
          <span aria-hidden="true"><Icon name="info" size={16} /></span>
          <p>{healthProfile.care_tips}</p>
        </div>
      )}
      <a href={COST_CALC_HREF} class="breed-cost-link">
        <div>
          <strong>{(healthProfile.common_issues as any[])[0]?.name ?? 'Health considerations'}</strong>
          <p>Breed health context can affect lifetime costs. Estimate food, care, and planning costs for a {b.name}.</p>
        </div>
        <span aria-hidden="true"><Icon name="calculator" size={16} /></span>
      </a>
    </>
  ) : (
    <>
      <p class="breed-muted">
        Breed-specific health data for the {b.name} is being compiled.
        Use the cost calculator to estimate veterinary and care costs.
      </p>
      <a href={COST_CALC_HREF} class="breed-cost-link">
        <div>
          <strong>Estimate care costs</strong>
          <p>Plan food, vet care, and lifetime ownership costs for a {b.name}.</p>
        </div>
        <span aria-hidden="true"><Icon name="calculator" size={16} /></span>
      </a>
    </>
  )}
</section>
