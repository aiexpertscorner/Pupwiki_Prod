---
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/Icon.astro';
import type { NormalizedBreed } from '../../lib/breeds/normalizeBreed';

interface ClusterLinkWithIcon {
  key: string;
  href: string;
  icon: IconName;
  label: string;
}

interface Props {
  breed: NormalizedBreed;
  clusterLinks: ClusterLinkWithIcon[];
  links: Record<string, string | undefined | null>;
}

const { breed, clusterLinks } = Astro.props;
const b = breed.raw;
const slug = breed.slug;
const COST_CALC_HREF = `/cost-calculator/${slug}`;

---

<section id="breed-guides" class="breed-section" aria-labelledby="all-guides-title">
  <div class="breed-section__header">
    <p class="breed-eyebrow">Related guides</p>
    <h2 id="all-guides-title">All {b.name} Guides</h2>
  </div>

  <a href={COST_CALC_HREF} class="breed-feature-link">
    <span aria-hidden="true"><Icon name="calculator" size={20} /></span>
    <div>
      <strong>{b.name} Cost Calculator</strong>
      <p>Puppy price, annual costs, food estimate, and lifetime ownership planning.</p>
    </div>
    <span aria-hidden="true"><Icon name="arrow-right" size={16} /></span>
  </a>

  <div class="breed-guide-grid">
    {clusterLinks.map((item) => (
      <a href={item.href} class="breed-guide-link">
        <span><Icon name={item.icon} size={18} /></span>
        <strong>{item.label}</strong>
        <span aria-hidden="true"><Icon name="arrow-right" size={14} /></span>
      </a>
    ))}
  </div>

</section>
