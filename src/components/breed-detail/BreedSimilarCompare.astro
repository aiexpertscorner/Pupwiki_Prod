---
import type { SimilarBreed } from '../../lib/breeds/breedComparisonSuggestions';

interface Props {
  similarBreeds: SimilarBreed[];
  breedName: string;
}

const { similarBreeds, breedName } = Astro.props;

function titleCase(value?: string | null) {
  if (!value) return '';
  return String(value).replace(/[-_]+/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}
---

{similarBreeds.length > 0 && <section class="breed-section" aria-labelledby="similar-breeds-title">
  <div class="breed-section__header">
    <p class="breed-eyebrow">Compare breeds</p>
    <h2 id="similar-breeds-title">Similar Breeds to the {breedName}</h2>
  </div>
  <div class="breed-similar-grid">
    {similarBreeds.slice(0, 3).map((sb) => (
      <a href={`/breeds/${sb.slug}`} class="breed-similar-card">
        <div class="breed-similar-card__body">
          <strong>{sb.name}</strong>
          <div class="breed-similar-card__pills">
            {sb.raw.size_category && <span>{titleCase(sb.raw.size_category)}</span>}
            {sb.raw.energy_level && <span>{titleCase(sb.raw.energy_level)} energy</span>}
          </div>
          {sb.similarityReason && (
            <p class="breed-similar-card__reason">{sb.similarityReason}</p>
          )}
        </div>
        <em aria-hidden="true">→</em>
      </a>
    ))}
  </div>
  <a href="/tools/compare" class="breed-button breed-button--secondary" style="margin-top: var(--space-4); display: inline-flex;">
    Compare breeds side by side →
  </a>
</section>}
