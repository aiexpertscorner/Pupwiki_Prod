---
import CommercePlacement from '../commerce/CommercePlacement.astro';
import AmazonProductSlot from '../amazon/AmazonProductSlot.astro';

export interface Props {
  topicTags: string[];
  category?: string;
  cluster?: string;
  claimSensitivity?: string;
  breedSize?: string;
  breedEnergy?: string;
  breedTraining?: string;
  breedCoat?: string;
  breedName?: string;
  pageSlug?: string;
  showAmazon?: boolean;
  showAwin?: boolean;
  heading?: string;
  description?: string;
}

const {
  topicTags = [],
  category = '',
  cluster,
  claimSensitivity,
  breedSize,
  breedEnergy,
  breedTraining,
  breedCoat,
  breedName,
  pageSlug = '',
  showAmazon = true,
  showAwin = true,
  heading = 'Helpful picks for this topic',
  description = "Curated for this topic. Always confirm details before buying.",
} = Astro.props;

const awinContext = {
  category: cluster || category,
  tags: topicTags,
  breedSize,
  energyLevel: breedEnergy,
};
---

<section class="article-commerce-suite not-prose" aria-label="Relevant shopping resources">
  <div class="article-commerce-suite__header">
    <p>Shopping resources</p>
    <h2>{heading}</h2>
    <span>{description}</span>
  </div>

  {showAwin && (
    <CommercePlacement
      pageType="guide"
      placement="article-inline"
      context={awinContext}
      limit={2}
      showDisclosure={false}
    />
  )}

  {showAmazon && (
    <div class="article-commerce-suite__amazon">
      <AmazonProductSlot
        topicTags={topicTags}
        pageType="guide"
        pageSlug={pageSlug}
        category={cluster || category}
        cluster={cluster}
        claimSensitivity={claimSensitivity}
        breedSize={breedSize}
        breedEnergy={breedEnergy}
        breedCoat={breedCoat}
        breedName={breedName}
        headline="Amazon picks"
        placement={`article-suite|${cluster || category}`}
      />
    </div>
  )}

  {showAwin && (
    <CommercePlacement
      pageType="guide"
      placement="article-end"
      context={awinContext}
      limit={4}
      eyebrow="More partner picks"
      title="More helpful products"
      showDisclosure={true}
    />
  )}

  <p class="pw-disclosure-note">
    Reader-support note: PupWiki may earn from some product links. Use these as research starting
    points and confirm current details before buying.
  </p>
</section>
