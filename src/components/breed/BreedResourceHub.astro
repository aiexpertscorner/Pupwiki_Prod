---
/**
 * BreedResourceHub.astro
 * High-intent internal linking module for breed detail pages.
 */
import Icon, { type IconName } from '../ui/Icon.astro';

export interface ResourceItem {
  href?: string;
  icon?: string;
  label: string;
  description?: string;
  badge?: string;
  available?: boolean;
  featured?: boolean;
}

export interface Props {
  breedName: string;
  items: ResourceItem[];
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  breedName,
  items = [],
  eyebrow = 'Breed resource hub',
  title = `Plan life with a ${breedName}`,
  description = 'Move from breed research to real decisions: costs, food, training, health context, names, lifecycle hubs and partner resources.',
} = Astro.props;

const enabledItems  = items.filter((item) => item.href);
const disabledItems = items.filter((item) => !item.href && item.available !== false).slice(0, 3);
const visibleItems  = [...enabledItems, ...disabledItems];
---

{visibleItems.length > 0 && (
  <section class="breed-resource-hub" aria-labelledby="breed-resource-hub-title">
    <div class="breed-resource-hub__header">
      <p class="breed-eyebrow">{eyebrow}</p>
      <h2 id="breed-resource-hub-title">{title}</h2>
      <p>{description}</p>
    </div>

    <div class="breed-resource-hub__grid">
      {visibleItems.map((item) => {
        const Tag = item.href ? 'a' : 'div';
        const iconName = (item.icon || 'pawprint') as IconName;
        return (
          <Tag
            href={item.href}
            class:list={['breed-resource-card', item.featured && 'is-featured', !item.href && 'is-disabled']}
            title={!item.href ? 'Content in progress' : undefined}
          >
            <span class="breed-resource-card__icon" aria-hidden="true">
              <Icon name={iconName} size={20} />
            </span>
            <span class="breed-resource-card__body">
              <strong>{item.label}</strong>
              {item.description && <em>{item.description}</em>}
            </span>
            {(item.badge || !item.href) && <span class="breed-resource-card__badge">{item.badge || 'Coming soon'}</span>}
            {item.href && <span class="breed-resource-card__arrow" aria-hidden="true">
              <Icon name="arrow-right" size={16} />
            </span>}
          </Tag>
        );
      })}
    </div>
  </section>
)}
