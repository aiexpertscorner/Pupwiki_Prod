---
import Icon, { type IconName } from '../ui/Icon.astro';

export interface Props {
  ranking_data: {
    intelligence_rank?:      number;
    intelligence_label?:     string;
    intelligence_pct?:       string;
    lifetime_cost_usd?:      number;
    annual_food_cost?:       number;
    purchase_price_usd?:     number;
    longevity_years?:        number;
    genetic_ailments?:       number;
    genetic_ailment_names?:  string;
    children_score?:         number;
    overall_score?:          number;
  };
  breed_name: string;
}

const { ranking_data: r, breed_name } = Astro.props;

if (!r || Object.keys(r).length === 0) return;

const CHILDREN_EXCELLENT = 0.8;
const CHILDREN_GOOD = 0.5;

const fmt = (n: number) =>
  n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

const items: Array<{ icon: IconName; value: string; label: string }> = [
  r.intelligence_rank != null && {
    icon: 'intelligence' as IconName,
    value: `#${r.intelligence_rank}`,
    label: `Intelligence (${r.intelligence_label ?? 'Above average'})`,
  },
  r.longevity_years != null && {
    icon: 'lifespan' as IconName,
    value: `${r.longevity_years}yr`,
    label: 'Average lifespan',
  },
  r.lifetime_cost_usd != null && {
    icon: 'cost' as IconName,
    value: fmt(r.lifetime_cost_usd),
    label: 'Est. lifetime cost',
  },
  r.annual_food_cost != null && {
    icon: 'food' as IconName,
    value: `${fmt(r.annual_food_cost)}/yr`,
    label: 'Annual food cost',
  },
  r.children_score != null && {
    icon: 'kids' as IconName,
    value: r.children_score >= CHILDREN_EXCELLENT ? 'Excellent' : r.children_score >= CHILDREN_GOOD ? 'Good' : 'Careful',
    label: 'Kids compatibility',
  },
  r.genetic_ailments != null && {
    icon: 'health' as IconName,
    value: `${r.genetic_ailments}`,
    label: 'Known genetic conditions',
  },
].filter(Boolean) as Array<{ icon: IconName; value: string; label: string }>;
---

{items.length > 0 && (
  <div class="ranking-panel">
    <p class="ranking-panel__title">Breed at a Glance — {breed_name}</p>
    <div class="ranking-grid">
      {items.map(item => (
        <div class="ranking-item">
          <span class="ranking-item__icon" aria-hidden="true">
            <Icon name={item.icon} size={18} />
          </span>
          <span class="ranking-item__value">{item.value}</span>
          <span class="ranking-item__label">{item.label}</span>
        </div>
      ))}
    </div>
    {r.genetic_ailment_names && r.genetic_ailment_names !== 'none' && (
      <p class="ranking-panel__note">
        Known health concerns: <strong>{r.genetic_ailment_names}</strong>
      </p>
    )}
  </div>
)}

<style>
  .ranking-panel__note {
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-top: var(--space-3);
    margin-bottom: 0;
  }
</style>
