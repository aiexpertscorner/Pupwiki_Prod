---
import CommercePlacement from '../commerce/CommercePlacement.astro';
import AmazonProductSlot from '../amazon/AmazonProductSlot.astro';
import Icon, { type IconName } from '../ui/Icon.astro';

export interface PartnerClusterLink {
  href: string;
  label: string;
  description?: string;
  icon?: string;
  tags?: string[];
}

export interface Props {
  breedName: string;
  breedSlug: string;
  breedSize?: string;
  breedEnergy?: string;
  breedTraining?: string;
  breedCoat?: string;
  topicTags?: string[];
  partnerClusters?: PartnerClusterLink[];
  showAmazon?: boolean;
}

const {
  breedName,
  breedSlug,
  breedSize,
  breedEnergy,
  breedTraining,
  breedCoat,
  topicTags = [],
  partnerClusters = [],
  showAmazon = true,
} = Astro.props;

const breedContext = {
  breedName,
  breedSize,
  coatType: breedCoat,
  groomingNeeds: breedCoat,
  energyLevel: breedEnergy,
  lifeStage: 'adult',
  tags: topicTags,
};
---

<section class="breed-commerce" aria-labelledby="breed-commerce-title">
  <div class="breed-commerce__header">
    <p class="breed-eyebrow">Owner resources & partner picks</p>
    <h2 id="breed-commerce-title">Useful resources for {breedName} owners</h2>
    <p>
      Breed-aware shopping resources matched to PupWiki brand data, Amazon.com product details,
      and practical owner needs.
    </p>
  </div>

  {partnerClusters.length > 0 && (
    <div class="breed-partner-clusters" aria-label="Related PupWiki partner clusters">
      {partnerClusters.slice(0, 5).map((cluster) => (
        <a href={cluster.href} class="breed-partner-cluster-card">
          <span class="breed-partner-cluster-card__icon" aria-hidden="true">
            <Icon name={(cluster.icon || 'heart') as IconName} size={18} />
          </span>
          <span>
            <strong>{cluster.label}</strong>
            {cluster.description && <em>{cluster.description}</em>}
          </span>
          <span aria-hidden="true"><Icon name="arrow-right" size={14} /></span>
        </a>
      ))}
    </div>
  )}

  <CommercePlacement
    pageType="breed"
    placement="breed-care"
    context={breedContext}
    title={`Care picks for ${breedName} owners`}
    eyebrow="Practical options"
    limit={3}
  />

  {showAmazon && (
    <div class="breed-commerce__amazon">
      <AmazonProductSlot
        topicTags={[breedSlug, breedName, ...(breedSize ? [breedSize] : []), ...topicTags]}
        pageType="breed"
        pageSlug={`/breeds/${breedSlug}`}
        category="dog-supplies"
        breedSize={breedSize}
        breedEnergy={breedEnergy}
        breedCoat={breedCoat}
        headline={`Amazon.com resources for ${breedName} owners`}
        note="Use Amazon links as research starting points and confirm size, seller, return policy, formula, and availability on Amazon before buying."
        limit={3}
      />
    </div>
  )}

  <p class="breed-commerce__note">
    Reader-support note: PupWiki may earn from some product links. Product availability, prices,
    terms and policy details can change.
  </p>
</section>
