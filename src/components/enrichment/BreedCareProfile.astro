---
import Icon, { type IconName } from '../ui/Icon.astro';

interface CareProfile {
  summary: string;
  ownerFit: string;
  exerciseNeeds: string;
  trainingNotes: string;
  groomingNotes: string;
  feedingContext: string;
}

interface Props {
  breedName: string;
  careProfile: CareProfile;
}

const { breedName, careProfile } = Astro.props;

const rows: Array<{ icon: IconName; label: string; value: string }> = [
  { icon: 'exercise',  label: 'Exercise', value: careProfile.exerciseNeeds },
  { icon: 'training',  label: 'Training', value: careProfile.trainingNotes },
  { icon: 'grooming',  label: 'Grooming', value: careProfile.groomingNotes },
  { icon: 'feeding',   label: 'Feeding',  value: careProfile.feedingContext },
];
---

<div class="care-profile">
  <div class="care-profile__header">
    <p class="care-profile__eyebrow">Care Profile</p>
    <h3 class="care-profile__title">{breedName} at a Glance</h3>
  </div>
  <div class="care-profile__body">
    <p class="care-profile__owner-fit">{careProfile.ownerFit}</p>
    <div class="care-profile__rows">
      {rows.map(row => (
        <div class="care-profile__row">
          <span class="care-profile__icon-wrap" aria-hidden="true">
            <Icon name={row.icon} size={18} />
          </span>
          <div>
            <span class="care-profile__label">{row.label}</span>
            <p class="care-profile__value">{row.value}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .care-profile {
    border: 1px solid var(--color-border-warm);
    border-radius: var(--radius-2xl);
    background: var(--color-bg-soft);
    overflow: hidden;
  }

  .care-profile__header {
    background: var(--color-surface-warm);
    border-bottom: 1px solid var(--color-border-warm);
    padding: var(--space-4) var(--space-5);
  }

  .care-profile__eyebrow {
    margin: 0 0 var(--space-1);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-label);
    line-height: 1;
    text-transform: uppercase;
  }

  .care-profile__title {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
  }

  .care-profile__body {
    padding: var(--space-4) var(--space-5);
  }

  .care-profile__owner-fit {
    margin: 0 0 var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .care-profile__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .care-profile__row {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .care-profile__icon-wrap {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-lg);
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .care-profile__label {
    display: block;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    line-height: 1;
  }

  .care-profile__value {
    margin: var(--space-1) 0 0;
    color: var(--color-heading);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }
</style>
