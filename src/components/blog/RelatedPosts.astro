---
import { getCollection } from 'astro:content';

export interface Props {
  currentSlug: string;
  category?: string;
  breedSlug?: string;
  max?: number;
}
const { currentSlug, category, breedSlug, max = 3 } = Astro.props;

const allPosts = await getCollection('blog');

function score(post: any): number {
  if (post.slug === currentSlug) return -1;
  if (post.data.noIndex || post.data.generated || post.data.indexInBlog === false) return -1;
  let s = 0;
  if (breedSlug && post.data.breedSlug === breedSlug) s += 3;
  if (category && (post.data.category || '').toLowerCase() === category.toLowerCase()) s += 2;
  return s;
}

const related = allPosts
  .map((p) => ({ post: p, s: score(p) }))
  .filter(({ s }) => s > 0)
  .sort((a, b) => b.s - a.s || new Date(b.post.data.pubDate).getTime() - new Date(a.post.data.pubDate).getTime())
  .slice(0, max)
  .map(({ post }) => post);

function formatDate(d: Date | string) {
  return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(d));
}
---

{related.length > 0 && (
  <section class="related-posts" aria-labelledby="related-heading">
    <h2 id="related-heading" class="related-posts__heading">Related reading</h2>
    <div class="related-posts__grid">
      {related.map((post) => (
        <a href={`/blog/${post.slug}`} class="related-posts__card">
          {post.data.category && (
            <span class="related-posts__tag">{post.data.category}</span>
          )}
          <h3 class="related-posts__title">{post.data.title}</h3>
          {post.data.description && (
            <p class="related-posts__desc">{post.data.description}</p>
          )}
          <time datetime={String(post.data.pubDate)} class="related-posts__date">
            {formatDate(post.data.pubDate)}
          </time>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-posts {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-6);
    border-block-start: 2px solid var(--color-border);
  }
  .related-posts__heading {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-heading);
    margin-block-end: var(--space-4);
  }
  .related-posts__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: var(--space-4);
  }
  .related-posts__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    text-decoration: none;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }
  .related-posts__card:hover {
    border-color: var(--color-accent-light);
    box-shadow: var(--shadow-sm);
  }
  .related-posts__tag {
    font-size: 0.68rem;
    font-weight: var(--weight-semi);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }
  .related-posts__title {
    font-size: var(--text-sm);
    font-weight: var(--weight-semi);
    color: var(--color-heading);
    line-height: 1.4;
    margin: 0;
  }
  .related-posts__desc {
    font-size: var(--text-xs);
    color: var(--color-body-soft);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  .related-posts__date {
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-block-start: auto;
  }
  @media (max-width: 600px) {
    .related-posts__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
