---
import AwinProductSlot from '../affiliate/AwinProductSlot.astro';
import AmazonProductSlot from '../amazon/AmazonProductSlot.astro';

export interface Props {
  topicTags: string[];
  category?: string;
  cluster?: string;
  claimSensitivity?: string;
  breedSize?: string;
  breedEnergy?: string;
  breedTraining?: string;
  breedCoat?: string;
  breedName?: string;
  pageSlug?: string;
  showAmazon?: boolean;
  showAwin?: boolean;
  heading?: string;
  description?: string;
}

const {
  topicTags = [],
  category = '',
  cluster,
  claimSensitivity,
  breedSize,
  breedEnergy,
  breedTraining,
  breedCoat,
  breedName,
  pageSlug = '',
  showAmazon = true,
  showAwin = true,
  heading = 'Top-rated picks for your dog',
  description = 'Curated for this topic and your dog\'s profile. Always check current sizing, formula, and seller details before buying.',
} = Astro.props;
---

<section class="article-commerce-suite not-prose" aria-label="Relevant shopping resources">
  <div class="article-commerce-suite__header">
    <p>Shopping resources</p>
    <h2>{heading}</h2>
    <span>{description}</span>
  </div>

  <div class="article-commerce-suite__grid pw-money-grid pw-money-grid--wide">
    {showAwin && (
      <AwinProductSlot
        topicTags={topicTags}
        pageType="blog"
        category={cluster || category}
        breedSize={breedSize}
        breedEnergy={breedEnergy}
        breedTraining={breedTraining}
        headline="Recommended for this topic"
        monetizationIntent="high"
      />
    )}

    {showAmazon && (
      <AmazonProductSlot
        topicTags={topicTags}
        pageType="blog"
        pageSlug={pageSlug}
        category={cluster || category}
        cluster={cluster}
        claimSensitivity={claimSensitivity}
        breedSize={breedSize}
        breedEnergy={breedEnergy}
        breedCoat={breedCoat}
        breedName={breedName}
        headline="Amazon picks"
        placement={`article-suite|${cluster || category}`}
      />
    )}
  </div>

  <p class="pw-disclosure-note">
    Reader-support note: PupWiki may earn from some product links. Use these as research starting points and confirm current details before buying.
  </p>
</section>
