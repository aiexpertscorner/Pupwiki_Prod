---
export interface Props { faqs: Array<{question:string; answer:string}>; heading?:string; }
const { faqs, heading = "FAQ" } = Astro.props;
const schema = JSON.stringify({ "@context":"https://schema.org","@type":"FAQPage","mainEntity":faqs.map(f=>({ "@type":"Question","name":f.question,"acceptedAnswer":{"@type":"Answer","text":f.answer} })) });
---
<section class="faq">
  <script type="application/ld+json" set:html={schema} />
  <h2 class="faq__heading">{heading}</h2>
  <div class="faq__list">
    {faqs.map((f,i) => (
      <div class="faq__item">
        <button onclick={`toggleFaq(${i})`}
          class="faq__btn"
          id={`faqbtn${i}`} aria-expanded="false">
          <span>{f.question}</span>
          <span class="faq__icon" id={`faqico${i}`}>▼</span>
        </button>
        <div id={`faqbody${i}`} class="faq__body" hidden>{f.answer}</div>
      </div>
    ))}
  </div>
</section>
<script>
  function toggleFaq(i) {
    const b=document.getElementById('faqbody'+i), btn=document.getElementById('faqbtn'+i), ico=document.getElementById('faqico'+i);
    const open=btn.getAttribute('aria-expanded')==='true';
    btn.setAttribute('aria-expanded',String(!open));
    if(b){ b.hidden=open; }
    if(ico)ico.style.transform=open?'':'rotate(180deg)';
  }
</script>

<style>
  .faq {
    margin: 2.5rem 0;
  }

  .faq__heading {
    font-family: var(--font-heading);
    font-size: 2rem;
    text-transform: uppercase;
    color: var(--color-heading);
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .faq__item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    overflow: hidden;
  }

  .faq__btn {
    width: 100%;
    text-align: left;
    padding: 1rem 1.25rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: var(--weight-semi);
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-heading);
    transition: color var(--transition-base);
  }

  .faq__btn:hover {
    color: var(--color-accent);
  }

  .faq__icon {
    color: var(--color-accent);
    transition: transform 0.2s;
    flex-shrink: 0;
    margin-left: 0.5rem;
    font-size: 0.75rem;
  }

  .faq__body {
    padding: 0.25rem 1.25rem 1rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-body-soft);
    line-height: 1.65;
    border-top: 1px solid var(--color-border);
  }

  .faq__body[hidden] {
    display: none;
  }
</style>
