---
---
<style>
  .newsletter {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border-warm);
    border-radius: var(--radius-2xl);
    padding: 2.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .newsletter__bg-text {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    overflow: hidden;
  }

  .newsletter__bg-label {
    font-family: var(--font-impact);
    font-size: 8rem;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.03);
    white-space: nowrap;
    letter-spacing: -0.02em;
  }

  .newsletter__inner {
    position: relative;
    z-index: 1;
  }

  .newsletter__badge {
    display: inline-block;
    margin-bottom: 1rem;
    background: var(--color-accent);
    color: white;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
  }

  .newsletter__heading {
    font-family: var(--font-impact);
    font-size: 2.5rem;
    text-transform: uppercase;
    color: var(--color-heading);
    margin: 0.5rem 0;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .newsletter__heading-accent {
    color: var(--color-accent);
  }

  .newsletter__sub {
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: var(--color-body-soft);
    margin: 0 auto 1.75rem;
    max-width: 400px;
  }

  .newsletter__form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 400px;
    margin: 0 auto;
  }

  .newsletter__input {
    background: var(--color-bg);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xl);
    color: var(--color-body);
    padding: 0.85rem 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    outline: none;
    width: 100%;
    box-sizing: border-box;
    transition: border-color var(--transition-base);
  }

  .newsletter__input::placeholder {
    color: var(--color-placeholder);
  }

  .newsletter__input:focus {
    border-color: var(--color-accent);
    box-shadow: var(--ring-accent, 0 0 0 3px rgba(255,122,0,0.12));
  }

  .newsletter__submit {
    width: 100%;
    padding: 1rem;
    background: var(--color-accent);
    color: white;
    border: none;
    border-radius: var(--radius-xl);
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: background var(--transition-base);
  }

  .newsletter__submit:hover {
    background: var(--color-accent-hover);
  }

  .newsletter__disclaimer {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-muted);
    margin: 0.75rem 0 0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
</style>

<div class="newsletter">
  <div class="newsletter__bg-text">
    <span class="newsletter__bg-label">FREE GUIDE</span>
  </div>
  <div class="newsletter__inner">
    <span class="newsletter__badge">FREE DROP</span>
    <h3 class="newsletter__heading">
      GET THE <span class="newsletter__heading-accent">INSIDER</span> LIST
    </h3>
    <p class="newsletter__sub">
      5,000+ dog owners get our unfiltered picks, deal alerts, and gear drops. No spam. Unsubscribe anytime.
    </p>
    <form action="YOUR_EMAIL_SERVICE_URL" method="POST" class="newsletter__form" onsubmit="return false">
      <input type="email" name="email" placeholder="YOUR@EMAIL.COM" required class="newsletter__input" />
      <button type="submit" class="newsletter__submit">
        JOIN THE LIST — IT'S FREE →
      </button>
    </form>
    <p class="newsletter__disclaimer">
      No spam. No paid promotions. Just dog gear truth.
    </p>
  </div>
</div>
