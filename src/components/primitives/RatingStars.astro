---
export interface Props {
  rating: number;
  max?: number;
  size?: 'sm' | 'md' | 'lg';
  label?: string;
}
const { rating, max = 5, size = 'md', label } = Astro.props;
const clamped = Math.max(0, Math.min(rating, max));
const uid = `stars-${Math.random().toString(36).slice(2, 8)}`;
const ariaLabel = label ?? `${clamped.toFixed(1)} out of ${max} stars`;

const sizeMap = { sm: 12, md: 16, lg: 22 };
const px = sizeMap[size];
const gap = Math.round(px * 0.2);
---

<span
  class={`rating-stars rating-stars--${size}`}
  role="img"
  aria-label={ariaLabel}
  title={ariaLabel}
>
  <svg width="0" height="0" style="position:absolute">
    <defs>
      <clipPath id={`${uid}-clip`}>
        <rect x="0" y="0" width={`${(clamped / max) * 100}%`} height="100%" />
      </clipPath>
    </defs>
  </svg>

  <span class="rating-stars__track" aria-hidden="true">
    {Array.from({ length: max }).map((_, i) => (
      <svg
        class="rating-stars__star"
        viewBox="0 0 24 24"
        width={px}
        height={px}
        style={`margin-right:${i < max - 1 ? gap : 0}px`}
      >
        <polygon
          class="rating-stars__empty"
          points="12,2 15.1,8.3 22,9.3 17,14.1 18.2,21 12,17.8 5.8,21 7,14.1 2,9.3 8.9,8.3"
        />
        <polygon
          class="rating-stars__filled"
          points="12,2 15.1,8.3 22,9.3 17,14.1 18.2,21 12,17.8 5.8,21 7,14.1 2,9.3 8.9,8.3"
          clip-path={clamped > i && clamped < i + 1
            ? `polygon(0 0, ${(clamped - i) * 100}% 0, ${(clamped - i) * 100}% 100%, 0 100%)`
            : undefined}
          style={clamped <= i ? 'opacity:0' : undefined}
        />
      </svg>
    ))}
  </span>
</span>

<style>
  .rating-stars {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }
  .rating-stars__track {
    display: inline-flex;
    align-items: center;
  }
  .rating-stars__star {
    flex-shrink: 0;
    overflow: visible;
  }
  .rating-stars__empty {
    fill: var(--color-placeholder);
  }
  .rating-stars__filled {
    fill: var(--color-star);
  }
</style>
