---
interface Props {
  client: string;
  variant?: 'inline' | 'sidebar';
}
const { client, variant = 'inline' } = Astro.props;
---

<div class:list={['ad-slot', variant === 'sidebar' && 'ad-slot--sidebar']} aria-hidden="true">
  <ins
    class="adsbygoogle"
    style="display:block; min-height:90px; width:100%"
    data-ad-client={client}
    data-ad-slot="auto"
    data-ad-format="auto"
    data-full-width-responsive="true"
  ></ins>
  <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
</div>
