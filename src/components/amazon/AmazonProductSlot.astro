---
/**
 * AmazonProductSlot.astro
 * Smart Amazon product placement driven by product-index.json.
 * Replaces the old amazon-products.json / SiteStripe pipeline.
 */
import { matchValidatedAmazonProducts } from '../../lib/amazon/matchAmazonProducts';
import { mergeAmazonProductsWithFallbacks } from '../../lib/amazon/amazonDeeplink';
import { isCommerceAllowed, getAmazonPageIntent } from '../../lib/commerce/amazon/amazonPageIntent';
import { adaptProductIndex } from '../../lib/amazon/productIndexAdapter';
import { scoreRichProductBonus } from '../../lib/amazon/productIndexAdapter';
import AmazonProductCard from './AmazonProductCard.astro';
import AmazonDisclosure from '../affiliate/AmazonDisclosure.astro';
import AmazonClickTracker from '../affiliate/AmazonClickTracker.astro';
import { ENABLE_AMAZON_BUTTONS } from '../../lib/amazon/amazonConfig';
import type { AmazonCTAContext } from '../../lib/commerce/amazon/amazonGeneratedLinks';
import type { RichAmazonProductRecord } from '../../lib/amazon/productIndexAdapter';

// Load from product-index.json (new engine — real ASINs, rich metadata)
let allProducts: RichAmazonProductRecord[] = [];
try {
  const imported = await import('../../data/product-index.json');
  const raw = imported.default as Record<string, any>;
  allProducts = adaptProductIndex(raw);
} catch {}

export interface Props extends AmazonCTAContext {
  headline?: string;
  eyebrow?: string;
  note?: string;
  variant?: 'rail' | 'compact';
  showDisclosure?: boolean;
  placement?: string;
}

const {
  headline = 'Useful Amazon.com resources for this guide',
  eyebrow = 'Amazon.com',
  note = 'Confirm fit, availability, sizing, ingredients, or materials on Amazon before buying.',
  variant = 'rail',
  showDisclosure = true,
  placement = 'article-slot',
  limit,
  allowMediumRisk = true,
  allowHighRisk = false,
  ...context
} = Astro.props;

const commerceContext = {
  pageType: context.pageType,
  category: context.cluster || context.category,
  topicTags: context.topicTags,
  claimSensitivity: context.claimSensitivity,
};
const intent = getAmazonPageIntent(commerceContext);
const resolvedLimit = limit ?? (variant === 'compact' ? 2 : intent === 'high' ? 3 : intent === 'medium' ? 2 : 1);

const matchContext = { ...context, limit: resolvedLimit, allowMediumRisk, allowHighRisk };

// Score with rich bonus on top of base scorer
const scored = allProducts
  .filter((p) => p.enabled)
  .map((p) => ({
    product: p,
    bonus: scoreRichProductBonus(p, matchContext),
  }));

// Inject bonus into priorityScore for matchValidatedAmazonProducts
const boostedProducts = scored.map(({ product, bonus }) => ({
  ...product,
  priorityScore: (product.priorityScore ?? 50) + bonus,
}));

const products = ENABLE_AMAZON_BUTTONS && isCommerceAllowed(commerceContext)
  ? mergeAmazonProductsWithFallbacks(
      matchValidatedAmazonProducts(boostedProducts, matchContext),
      matchContext
    ) as RichAmazonProductRecord[]
  : [];

const cardVariant = variant === 'compact' ? 'compact' : 'card';
---

{products.length > 0 && (
  <section class:list={['amazon-slot', variant === 'compact' && 'amazon-slot--compact']} aria-label={headline}>
    <div class="amazon-slot__header">
      <p class="amazon-slot__eyebrow">{eyebrow}</p>
      <h2 class="amazon-slot__title">{headline}</h2>
      <span class="amazon-slot__note">{note}</span>
    </div>

    <div class:list={['amazon-slot__grid', variant === 'compact' && 'amazon-slot__grid--compact']}>
      {products.map((product) => (
        <AmazonProductCard
          product={product as RichAmazonProductRecord}
          variant={cardVariant}
          placement={`${placement}|${product.id}`}
        />
      ))}
    </div>

    {showDisclosure && <AmazonDisclosure />}
    <AmazonClickTracker />
  </section>
)}

<style>
  .amazon-slot {
    container-type: inline-size;
  }

  .amazon-slot__header {
    margin-bottom: var(--space-4);
  }

  .amazon-slot__eyebrow {
    font-size: var(--text-xs, 0.75rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin: 0 0 var(--space-1);
  }

  .amazon-slot__title {
    font-size: var(--text-lg, 1.125rem);
    font-weight: 700;
    margin: 0 0 var(--space-1);
    color: var(--color-text-primary);
  }

  .amazon-slot__note {
    font-size: var(--text-xs, 0.75rem);
    color: var(--color-text-muted);
  }

  .amazon-slot__grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @container (min-width: 560px) {
    .amazon-slot__grid:not(.amazon-slot__grid--compact) {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    }
  }
</style>
