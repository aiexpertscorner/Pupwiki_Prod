---
/**
 * AmazonProductCard.astro
 * Mobile-first product card driven by product-index.json.
 * No image (broken sources), no price (Amazon ToS risk).
 * Supports full (default) and compact (sidebar) variants.
 */
import type { RichAmazonProductRecord } from '../../lib/amazon/productIndexAdapter';
import { buildAmazonProductLink } from '../../lib/amazon/amazonDeeplink';
import AmazonBadge from '../ui/AmazonBadge.astro';

export interface Props {
  product: RichAmazonProductRecord;
  variant?: 'card' | 'compact';
  placement?: string;
}

const { product, variant = 'card', placement = 'amazon-card' } = Astro.props;

const href = buildAmazonProductLink(product);
const isCompact = variant === 'compact';

const stars = product.rating ? Math.round(product.rating * 2) / 2 : null;
const fullStars = stars ? Math.floor(stars) : 0;
const halfStar = stars ? stars % 1 >= 0.5 : false;
const emptyStars = stars ? 5 - fullStars - (halfStar ? 1 : 0) : 5;

function formatReviews(n?: number) {
  if (!n) return '';
  if (n >= 1000) return `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}k`;
  return String(n);
}

function scoreVariant(score?: number) {
  if (!score) return 'neutral';
  if (score >= 8) return 'good';
  if (score >= 6) return 'ok';
  return 'caution';
}

const features = (product.features ?? []).slice(0, 2);
const categoryLabel = product.categoryLabel || (product.categoryGroup ?? '').replace(/-/g, ' ');
---

<article
  class:list={['amz-card', isCompact && 'amz-card--compact']}
  data-amazon-product-id={product.id}
  data-amazon-placement={placement}
>
  <div class="amz-card__top">
    {(product.brand || categoryLabel) && (
      <p class="amz-card__meta">
        {product.brand && <strong class="amz-card__brand">{product.brand}</strong>}
        {product.brand && categoryLabel && <span class="amz-card__meta-sep" aria-hidden="true">·</span>}
        {categoryLabel && <span class="amz-card__category">{categoryLabel}</span>}
      </p>
    )}
    <h3 class="amz-card__title">{product.name}</h3>
  </div>

  {stars && (
    <div class="amz-card__rating" aria-label={`${stars} out of 5 stars`}>
      <span class="amz-card__stars" aria-hidden="true">
        {'★'.repeat(fullStars)}{halfStar ? '½' : ''}{'☆'.repeat(emptyStars)}
      </span>
      <span class="amz-card__rating-value">{stars}</span>
      {product.reviewCount && (
        <span class="amz-card__reviews">({formatReviews(product.reviewCount)})</span>
      )}
    </div>
  )}

  {!isCompact && product.verdict && (
    <p class="amz-card__verdict">"{product.verdict}"</p>
  )}

  {!isCompact && features.length > 0 && (
    <ul class="amz-card__features" aria-label="Key features">
      {features.map((f) => <li class="amz-card__feature">{f}</li>)}
    </ul>
  )}

  {!isCompact && product.editorialScore != null && (
    <div class:list={['amz-card__score', `amz-card__score--${scoreVariant(product.editorialScore)}`]}>
      <span>PupWiki score</span>
      <strong>{product.editorialScore.toFixed(1)}<small>/10</small></strong>
    </div>
  )}

  <div class="amz-card__cta">
    <AmazonBadge
      href={href}
      size={isCompact ? 'sm' : 'md'}
      data-amazon-product-id={product.id}
      data-amazon-product-name={product.name}
      data-amazon-placement={placement}
    />
  </div>
</article>

<style>
  .amz-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-4);
    transition: box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .amz-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-card-hover);
  }

  /* ── Top block: meta + title ── */
  .amz-card__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .amz-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex-wrap: wrap;
    font-size: var(--text-xs);
    margin: 0;
  }

  .amz-card__brand {
    color: var(--color-heading);
    font-weight: var(--weight-semi);
  }

  .amz-card__meta-sep {
    color: var(--color-border);
  }

  .amz-card__category {
    color: var(--color-muted);
    text-transform: capitalize;
  }

  .amz-card__title {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-heading);
    margin: 0;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Rating row ── */
  .amz-card__rating {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
  }

  .amz-card__stars {
    color: var(--color-star);
    letter-spacing: 0.5px;
    font-size: 0.82rem;
  }

  .amz-card__rating-value {
    font-weight: var(--weight-semi);
    color: var(--color-heading);
  }

  .amz-card__reviews {
    color: var(--color-muted);
  }

  /* ── Verdict ── */
  .amz-card__verdict {
    font-size: var(--text-xs);
    color: var(--color-body-soft);
    font-style: italic;
    margin: 0;
    border-left: 2px solid var(--color-border-soft);
    padding-left: var(--space-2);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Features as inline chips ── */
  .amz-card__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .amz-card__feature {
    font-size: var(--text-xs);
    color: var(--color-body-soft);
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-full);
    padding: 0.15rem var(--space-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .amz-card__feature::before {
    content: '✓ ';
    color: var(--color-accent);
    font-weight: var(--weight-bold);
  }

  /* ── Score pill ── */
  .amz-card__score {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    width: fit-content;
  }

  .amz-card__score--good    { background: var(--color-success-light); color: var(--color-success-dark); }
  .amz-card__score--ok      { background: var(--color-warning-light); color: var(--color-warning-dark); }
  .amz-card__score--caution { background: var(--color-danger-light);  color: var(--color-danger-dark); }
  .amz-card__score--neutral { background: var(--color-bg-muted); color: var(--color-muted); }

  .amz-card__score strong {
    font-size: var(--text-sm);
    font-weight: var(--weight-black);
  }

  .amz-card__score small {
    font-weight: var(--weight-normal);
    font-size: 0.65rem;
  }

  /* ── CTA ── */
  .amz-card__cta {
    margin-top: auto;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border-soft);
  }

  /* ── Compact variant ── */
  .amz-card--compact {
    padding: var(--space-3);
    gap: var(--space-2);
  }

  .amz-card--compact .amz-card__title {
    font-size: var(--text-xs);
    -webkit-line-clamp: 2;
  }
</style>
