---
interface Topic {
  label: string;
  href: string;
  icon?: string;
  description?: string;
}

interface Props {
  topics: Topic[];
  heading?: string;
}

const { topics, heading } = Astro.props;
---

{topics.length > 0 && (
  <div class="faq-topic-cards">
    {heading && <h3 class="faq-topic-cards__heading">{heading}</h3>}
    <div class="faq-topic-cards__grid">
      {topics.map((topic) => (
        <a href={topic.href} class="faq-topic-cards__card">
          {topic.icon && <span class="faq-topic-cards__icon" aria-hidden="true">{topic.icon}</span>}
          <span class="faq-topic-cards__label">{topic.label}</span>
          {topic.description && <span class="faq-topic-cards__desc">{topic.description}</span>}
        </a>
      ))}
    </div>
  </div>
)}

<style>
.faq-topic-cards {
  margin-top: var(--space-5);
}

.faq-topic-cards__heading {
  font-size: var(--text-sm);
  font-weight: var(--weight-bold);
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: var(--space-3);
}

.faq-topic-cards__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: var(--space-2);
}

.faq-topic-cards__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--space-1);
  padding: var(--space-3) var(--space-2);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  text-decoration: none;
  transition: border-color 0.15s, background 0.15s;
  min-height: 44px;
  justify-content: center;
}

.faq-topic-cards__card:hover {
  border-color: var(--color-accent);
  background: var(--color-surface-alt, var(--color-surface));
}

.faq-topic-cards__icon {
  font-size: 1.25rem;
  line-height: 1;
}

.faq-topic-cards__label {
  font-size: var(--text-xs);
  font-weight: var(--weight-semi);
  color: var(--color-body);
}

.faq-topic-cards__desc {
  font-size: var(--text-xs);
  color: var(--color-muted);
  line-height: 1.3;
  display: none;
}

@media (min-width: 480px) {
  .faq-topic-cards__grid {
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
  }
}
</style>
