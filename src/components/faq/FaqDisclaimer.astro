---
interface Props {
  type: 'health' | 'cost' | 'general';
}

const { type } = Astro.props;

const DISCLAIMER_TEXT = {
  health:  'This is general breed information, not veterinary advice. Contact a veterinarian for guidance specific to your dog.',
  cost:    'Planning estimates only. Actual costs vary by location, provider, health, lifestyle, and care choices.',
  general: 'This page provides general guidance and does not replace professional veterinary, behavioural, or financial advice. Individual dogs vary significantly within any breed.',
};

const text = DISCLAIMER_TEXT[type];
---

<p class:list={['faq-disclaimer', `faq-disclaimer--${type}`]}>{text}</p>

<style>
.faq-disclaimer {
  font-size: var(--text-xs);
  color: var(--color-muted);
  line-height: 1.55;
  font-style: italic;
  margin: 0;
  padding: var(--space-3) var(--space-4);
  border-left: 3px solid var(--color-border);
  background: var(--color-surface);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}

.faq-disclaimer--health {
  border-left-color: var(--color-warning);
}

.faq-disclaimer--cost {
  border-left-color: var(--color-accent);
}

.faq-disclaimer--general {
  border-left-color: var(--color-border);
}
</style>
