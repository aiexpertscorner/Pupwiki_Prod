---
export interface Props {
  name: string; asin: string; price?: number;
  rating?: number; reviewCount?: number; ourScore?: number;
  verdict?: string; pros?: string[]; cons?: string[];
  badge?: string; features?: string[];
  image?: string; local_image?: string;
  brand_logo?: string; brand_slug?: string; brand_name?: string;
  tag?: string;
}
const {
  name, asin, price, rating = 4.5,
  reviewCount, ourScore, verdict, pros = [], cons = [],
  badge, features = [], image, local_image,
  brand_logo, brand_slug, brand_name, tag = 'aiexpertscorn-20',
} = Astro.props;

const amazonUrl = `https://www.amazon.com/dp/${asin}/?tag=${tag}`;
const stars = Math.round(rating);
const scoreColor = ourScore ? (ourScore >= 9 ? 'var(--color-score-good)' : ourScore >= 7 ? 'var(--color-score-caution)' : 'var(--color-score-danger)') : 'var(--color-score-muted)';
const imgSrc = local_image || (image?.includes('media-amazon') ? image : null);
---

<div class="not-prose rounded-2xl border overflow-hidden shadow-sm hover:shadow-md transition-shadow" style="background:var(--color-bg);border-color:var(--color-surface-warm)">
  {badge && <div class="font-sans text-xs font-bold uppercase tracking-wider text-center py-1.5" style="background:var(--color-score-caution);color:var(--color-text-inverse)">{badge}</div>}
  <div class="p-5">
    <div class="flex items-start gap-4 mb-4">
      <!-- Image -->
      <div class="flex-shrink-0 w-20 h-20 rounded-xl flex items-center justify-center overflow-hidden" style="background:linear-gradient(135deg,var(--color-surface-warm),var(--color-pill-food-bg))">
        {imgSrc ? (
          <img src={imgSrc} alt={name} width="80" height="80" loading="lazy" class="w-full h-full object-contain"
            onerror="this.style.display='none';this.nextSibling.style.display='block'" />
        ) : null}
        {brand_logo ? (
          <img src={brand_logo} alt={brand_name||''} width="60" height="60" loading="lazy"
            class="object-contain max-h-14 opacity-80"
            style={imgSrc ? 'display:none' : ''}
            onerror="this.style.display='none'" />
        ) : null}
        {!imgSrc && !brand_logo && <span style="font-size:2rem">🐾</span>}
      </div>
      <!-- Meta -->
      <div class="flex-1 min-w-0">
        <h3 class="font-display font-semibold leading-snug mb-1" style={`font-family:'Playfair Display',Georgia,serif;color:var(--color-surface-dark);font-size:0.95rem`}>{name}</h3>
        {brand_slug && brand_name && (
          <a href={`/brands/${brand_slug}`} class="font-sans text-xs hover:underline mb-1 block" style="color:var(--color-accent)">by {brand_name} →</a>
        )}
        <div class="flex flex-wrap items-center gap-2 font-sans text-sm">
          <span style="color:var(--color-score-caution)">{'★'.repeat(stars)}{'☆'.repeat(5-stars)}</span>
          <span style="color:var(--color-muted)">{rating.toFixed(1)}{reviewCount ? ` (${reviewCount.toLocaleString()})` : ''}</span>
        </div>
      </div>
      {ourScore && (
        <div class="text-center flex-shrink-0">
          <div class="font-sans font-black text-2xl leading-none" style={`color:${scoreColor}`}>{ourScore}<span class="text-xs font-normal" style="color:var(--color-subtle)">/10</span></div>
          <div class="font-sans text-xs mt-0.5" style="color:var(--color-subtle)">Score</div>
        </div>
      )}
    </div>

    {verdict && <p class="font-sans text-sm italic mb-3 pl-3" style="color:var(--color-body);border-left:3px solid var(--color-score-caution)">{verdict}</p>}

    {features.length > 0 && (
      <ul class="mb-3 space-y-1">
        {features.slice(0,3).map(f => <li class="font-sans text-sm flex items-start gap-2" style="color:var(--color-body)"><span style="color:var(--color-score-caution);flex-shrink:0">✓</span>{f}</li>)}
      </ul>
    )}

    {(pros.length > 0 || cons.length > 0) && (
      <div class="grid grid-cols-2 gap-2 mb-3 font-sans text-xs">
        {pros.length > 0 && <div class="rounded-xl p-3" style="background:var(--color-score-good-light)"><p class="font-bold mb-1" style="color:var(--color-score-good)">✅ Pros</p>{pros.slice(0,3).map(p=><p style="color:var(--color-score-good)" class="mb-0.5">{p}</p>)}</div>}
        {cons.length > 0 && <div class="rounded-xl p-3" style="background:var(--color-score-danger-light)"><p class="font-bold mb-1" style="color:var(--color-score-danger)">❌ Cons</p>{cons.slice(0,3).map(c=><p style="color:var(--color-score-danger)" class="mb-0.5">{c}</p>)}</div>}
      </div>
    )}

    {price && (
      <div class="flex items-center justify-around mb-3 p-2.5 rounded-xl" style="background:var(--color-bg-soft);border:1px solid var(--color-surface-warm)">
        <div class="text-center">
          <p class="font-sans text-xs" style="color:var(--color-subtle)">Amazon</p>
          <p class="font-sans font-black text-lg" style="color:var(--color-heading)">${price.toFixed(2)}</p>
        </div>
      </div>
    )}

    {asin && asin !== 'SUBSCRIPTION' && (
      <a href={amazonUrl} rel="nofollow sponsored" target="_blank"
        class="block text-center font-sans font-bold text-sm py-2.5 rounded-xl transition-all"
        style="background:linear-gradient(135deg,var(--color-affiliate-amazon),var(--color-affiliate-amazon-dark));color:var(--color-text-inverse)">
        🟡 View on Amazon →
      </a>
    )}
    {asin === 'SUBSCRIPTION' && (
      <a href={amazonUrl} rel="nofollow sponsored" target="_blank"
        class="block text-center font-sans font-bold text-sm py-2.5 rounded-xl"
        style="background:linear-gradient(135deg,var(--color-accent),var(--color-accent-hover));color:var(--color-text-inverse)">
        View subscription →
      </a>
    )}
  </div>
</div>
