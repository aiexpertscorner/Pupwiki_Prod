---
// Importeer je breed data zodat we deze client-side beschikbaar kunnen maken
import masterBreeds from '../data/master-breeds.json';

// We mappen alleen de benodigde velden om de payload klein te houden
const quizData = masterBreeds.map(b => ({
  slug: b.slug,
  name: b.name,
  size: b.size_category,
  energy: b.energy_level,
  grooming: b.traits?.grooming_value || 0.5,
  children: b.ranking_data?.children_score || 0.5,
  trainability: b.traits?.trainability_value || 0.5,
  image: b.image_url
}));
---

<style>
  .quiz-container {
    max-width: 600px;
    margin: 0 auto;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
  }
  .quiz-step { display: none; }
  .quiz-step.active { display: block; animation: fadeIn 0.3s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .quiz-question {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-heading);
    margin-bottom: 1.5rem;
  }
  .quiz-btn {
    display: block;
    width: 100%;
    padding: 1rem;
    margin-bottom: 0.75rem;
    background: var(--color-bg-muted);
    border: 2px solid var(--color-border);
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-body-soft);
    cursor: pointer;
    transition: all 0.2s;
    text-align: left;
  }
  .quiz-btn:hover {
    background: var(--color-surface-warm);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .match-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    margin-bottom: 1rem;
  }
  .match-card img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
  }
  .match-card__name { display: block; font-size: 1.1rem; color: var(--color-heading); }
  .match-card__meta { font-size: 0.8rem; color: var(--color-muted); text-transform: capitalize; }
  .match-card__link { padding: 0.5rem 1rem; background: var(--color-bg-muted); color: var(--color-primary); border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 0.85rem; }
</style>

<div class="quiz-container" id="breed-quiz">

  <!-- Step 0: resume prompt (hidden by default; shown by JS when saved answers exist) -->
  <div class="quiz-step" data-step="resume" id="quiz-resume-step">
    <div style="text-align: center; padding: 1rem 0;">
      <h3 class="quiz-question" style="font-size:1.25rem;">Continue where you left off?</h3>
      <p style="color: var(--color-muted); margin-bottom: 1.5rem;">You have saved quiz answers from a previous visit.</p>
      <button id="quiz-resume-btn" style="width:100%;padding:1rem;border-radius:8px;background:var(--color-accent);color:white;font-weight:bold;border:none;cursor:pointer;margin-bottom:0.75rem;">Resume quiz →</button>
      <button id="quiz-restart-btn" style="background: none; border: none; color: var(--color-subtle); font-size: 0.85rem; cursor: pointer; text-decoration: underline;">Start over</button>
    </div>
  </div>

  <!-- Steps 1–4: questions -->
  <div class="quiz-step" data-step="1">
    <span style="color:var(--color-accent);font-weight:700;font-size:0.85rem;text-transform:uppercase;">Question 1 of 4</span>
    <h3 class="quiz-question">How big is your living space?</h3>
    <button class="quiz-btn" data-answer="size" data-value="small">Apartment / Small home without yard</button>
    <button class="quiz-btn" data-answer="size" data-value="medium">House with a small/fenced yard</button>
    <button class="quiz-btn" data-answer="size" data-value="large">Large house with plenty of land</button>
  </div>

  <div class="quiz-step" data-step="2">
    <span style="color:var(--color-accent);font-weight:700;font-size:0.85rem;text-transform:uppercase;">Question 2 of 4</span>
    <h3 class="quiz-question">How much daily exercise can you provide?</h3>
    <button class="quiz-btn" data-answer="energy" data-value="calm">Short walks (0-30 mins)</button>
    <button class="quiz-btn" data-answer="energy" data-value="regular">Regular activity (30-60 mins)</button>
    <button class="quiz-btn" data-answer="energy" data-value="active">Very active (60+ mins, running/hiking)</button>
  </div>

  <div class="quiz-step" data-step="3">
    <span style="color:var(--color-accent);font-weight:700;font-size:0.85rem;text-transform:uppercase;">Question 3 of 4</span>
    <h3 class="quiz-question">Do you have young children in the home?</h3>
    <button class="quiz-btn" data-answer="children" data-value="yes">Yes, I need a very kid-friendly dog</button>
    <button class="quiz-btn" data-answer="children" data-value="no">No, standard temperament is fine</button>
  </div>

  <div class="quiz-step" data-step="4">
    <span style="color:var(--color-accent);font-weight:700;font-size:0.85rem;text-transform:uppercase;">Question 4 of 4</span>
    <h3 class="quiz-question">How much grooming are you willing to do?</h3>
    <button class="quiz-btn" data-answer="grooming" data-value="low">Low maintenance (occasional brushing)</button>
    <button class="quiz-btn" data-answer="grooming" data-value="high">I don't mind regular brushing or groomer visits</button>
  </div>

  <!-- Step 5: email capture -->
  <div class="quiz-step" data-step="capture">
    <div style="text-align: center;">
      <h3 class="quiz-question">We found your matches!</h3>
      <p style="color: var(--color-muted); margin-bottom: 1.5rem;">Enter your email to reveal your top 3 dog breeds and get our free Puppy Prep Guide.</p>
      <input type="email" id="quiz-email" placeholder="your@email.com" style="width: 100%; padding: 1rem; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 1rem;" />
      <button id="show-results-btn" style="width:100%;padding:1rem;border-radius:8px;background:var(--color-accent);color:white;font-weight:bold;border:none;cursor:pointer;">Reveal My Matches →</button>
      <button id="skip-email-btn" style="background: none; border: none; color: var(--color-subtle); font-size: 0.85rem; margin-top: 1rem; cursor: pointer; text-decoration: underline;">Skip and just show my results</button>
    </div>
  </div>

  <div class="quiz-step" data-step="results">
    <span style="color:var(--color-accent);font-weight:700;font-size:0.85rem;text-transform:uppercase;">Your Matches</span>
    <h3 class="quiz-question">Meet Your Perfect Companions</h3>
    <div id="results-container"></div>
    <div style="margin-top:1rem">
      <button id="quiz-save-shortlist" style="width:100%;padding:0.75rem;border-radius:8px;background:transparent;border:1px solid var(--color-primary,var(--color-accent));color:var(--color-primary,var(--color-accent));font-weight:600;cursor:pointer;margin-bottom:1rem;">♡ Save these breeds to shortlist</button>
    </div>
    <div style="margin-top:1rem;padding:1rem;background:var(--color-surface-warm);border-radius:12px;border:1px solid var(--color-border-strong)">
      <p style="font-weight:600;color:var(--color-accent);margin-bottom:0.5rem">Next Step: Prepare Your Budget</p>
      <p style="font-size: 0.9rem; color: var(--color-body); margin-bottom: 1rem;">Use our calculator to see the exact lifetime costs for these breeds.</p>
      <a href="/cost-calculator" style="display: block; text-align: center; background: var(--color-surface-navy); color: var(--color-text-inverse); padding: 0.75rem; border-radius: 8px; text-decoration: none; font-weight: bold;">Go to Cost Calculator</a>
    </div>
    <button id="quiz-restart-results" style="display:block;margin-top:1rem;background:none;border:none;color:var(--color-subtle);font-size:0.85rem;cursor:pointer;text-decoration:underline;width:100%;text-align:center;">Start quiz over</button>
  </div>

</div>

<script define:vars={{ quizData }}>
  const ANSWERS_KEY = 'pupwiki:quiz-answers:v1';
  const SHORTLIST_KEY = 'pupwiki:breed-shortlist:v1';

  const state = { size: null, energy: null, children: null, grooming: null };
  let lastMatches = [];

  const container = document.getElementById('breed-quiz');
  // DOM order: 0=resume, 1=Q1, 2=Q2, 3=Q3, 4=Q4, 5=capture, 6=results
  const steps = Array.from(container.querySelectorAll('.quiz-step'));
  const buttons = container.querySelectorAll('.quiz-btn');
  const resultsContainer = document.getElementById('results-container');
  let currentStep = 1;

  const STEP_CAPTURE = 5;
  const STEP_RESULTS = 6;

  function showStep(index) {
    steps.forEach((step, i) => step.classList.toggle('active', i === index));
    currentStep = index;
  }

  function saveAnswers() {
    try { localStorage.setItem(ANSWERS_KEY, JSON.stringify({ ...state, ts: Date.now() })); } catch {}
  }

  function clearAnswers() {
    try { localStorage.removeItem(ANSWERS_KEY); } catch {}
  }

  function loadAnswers() {
    try {
      const s = JSON.parse(localStorage.getItem(ANSWERS_KEY) || 'null');
      if (s && Date.now() - s.ts < 86_400_000) return s;
    } catch {}
    return null;
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      state[e.target.dataset.answer] = e.target.dataset.value;
      saveAnswers();
      showStep(currentStep + 1);
    });
  });

  document.getElementById('show-results-btn').addEventListener('click', calculateMatches);
  document.getElementById('skip-email-btn').addEventListener('click', calculateMatches);

  document.getElementById('quiz-resume-btn')?.addEventListener('click', () => {
    const answered = ['size', 'energy', 'children', 'grooming'].filter(k => state[k] !== null).length;
    showStep(Math.min(answered + 1, STEP_CAPTURE));
  });

  function doRestart() {
    Object.keys(state).forEach(k => (state[k] = null));
    clearAnswers();
    lastMatches = [];
    showStep(1);
  }

  document.getElementById('quiz-restart-btn')?.addEventListener('click', doRestart);
  document.getElementById('quiz-restart-results')?.addEventListener('click', doRestart);

  function calculateMatches() {
    let matches = quizData;

    if (state.size === 'small') {
      matches = matches.filter(b => b.size === 'small' || b.size === 'medium');
    } else if (state.size === 'medium') {
      matches = matches.filter(b => b.size !== 'giant');
    }

    if (state.energy === 'calm') {
      matches = matches.filter(b => b.energy === 'calm');
    } else if (state.energy === 'regular') {
      matches = matches.filter(b => b.energy === 'regular' || b.energy === 'calm');
    } else if (state.energy === 'active') {
      matches = matches.filter(b => b.energy === 'active' || b.energy === 'regular');
    }

    if (state.children === 'yes') matches = matches.filter(b => b.children >= 0.7);
    if (state.grooming === 'low') matches = matches.filter(b => b.grooming <= 0.5);

    lastMatches = matches.slice(0, 3);
    renderResults(lastMatches);
    clearAnswers();
    showStep(STEP_RESULTS);
  }

  function renderResults(matches) {
    if (!matches.length) {
      resultsContainer.innerHTML = '<p>We couldn\'t find a perfect match. Try different answers!</p>';
      return;
    }
    resultsContainer.innerHTML = matches.map((b, i) => `
      <div class="match-card">
        <img src="${b.image || '/fallback-dog.jpg'}" alt="${b.name}">
        <div style="flex-grow:1">
          <strong class="match-card__name">#${i + 1} Match: ${b.name}</strong>
          <span class="match-card__meta">${b.size} Size · ${b.energy} Energy</span>
        </div>
        <a href="/breeds/${b.slug}" class="match-card__link">View Profile</a>
      </div>
    `).join('');
  }

  document.getElementById('quiz-save-shortlist')?.addEventListener('click', function() {
    if (!lastMatches.length) return;
    try {
      const list = JSON.parse(localStorage.getItem(SHORTLIST_KEY) || '[]');
      lastMatches.forEach(m => { if (!list.find(x => x.slug === m.slug)) list.push({ slug: m.slug, name: m.name }); });
      localStorage.setItem(SHORTLIST_KEY, JSON.stringify(list));
      this.textContent = '✓ Saved — view at /breeds';
      this.style.borderColor = 'var(--color-success,#16a34a)';
      this.style.color = 'var(--color-success,#16a34a)';
    } catch {}
  });

  // Mount: check for saved answers
  const saved = loadAnswers();
  if (saved && ['size', 'energy', 'children', 'grooming'].some(k => saved[k] !== null)) {
    Object.assign(state, { size: saved.size, energy: saved.energy, children: saved.children, grooming: saved.grooming });
    showStep(0); // resume prompt
  } else {
    showStep(1); // first question
  }
</script>
