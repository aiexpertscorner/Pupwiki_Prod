---
const navLinks = [
  { label: 'Dog Food',    href: '/categories/dog-food' },
  { label: 'Toys',        href: '/categories/toys' },
  { label: 'Health',      href: '/categories/health' },
  { label: 'Training',    href: '/categories/training' },
  { label: 'Supplements', href: '/categories/supplements' },
  { label: 'All Breeds',  href: '/breeds' },
  { label: 'Dog Names',   href: '/dog-names' },
];

const secondaryLinks = [
  { label: 'Puppy Guide',  href: '/categories/puppy' },
  { label: 'Insurance',    href: '/categories/insurance' },
  { label: 'Senior Dogs',  href: '/categories/senior-dogs' },
];
---

<header class="pw-header">
  <div class="pw-header__inner">
    <div class="pw-header__bar">

      <!-- Logo -->
      <a href="/" class="pw-header__logo group">
        <span class="text-2xl">🐾</span>
        <span class="pw-header__logo-text">PupWiki</span>
      </a>

      <!-- Desktop Nav -->
      <nav class="pw-header__nav" aria-label="Main navigation">
        {navLinks.map(link => (
          <a href={link.href} class="pw-header__nav-link">{link.label}</a>
        ))}
      </nav>

      <!-- Desktop CTA -->
      <div class="pw-header__cta">
        <a href="/how-we-test" class="pw-header__how-we-test">How we test</a>
        <a href="/blog" class="pw-header__cta-btn">All Reviews →</a>
      </div>

      <!-- Mobile toggle -->
      <button id="menu-toggle" class="pw-header__mobile-toggle lg:hidden"
        aria-label="Toggle menu" aria-expanded="false">
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-nav" class="pw-header__mobile hidden lg:hidden">
    <div class="pw-header__mobile-links">
      {navLinks.map(link => (
        <a href={link.href} class="pw-header__mobile-link">{link.label}</a>
      ))}
    </div>
    <div class="pw-header__mobile-secondary">
      {secondaryLinks.map(link => (
        <a href={link.href} class="pw-header__mobile-link pw-header__mobile-link--secondary">{link.label}</a>
      ))}
    </div>
    <div class="pw-header__mobile-footer">
      <a href="/blog" class="pw-header__cta-btn pw-header__cta-btn--block">All Reviews →</a>
      <div class="pw-header__mobile-meta">
        <a href="/about" class="pw-header__meta-link">About</a>
        <a href="/how-we-test" class="pw-header__meta-link">How we test</a>
        <a href="/disclosure" class="pw-header__meta-link">Disclosure</a>
      </div>
    </div>
  </div>
</header>

<style>
  .pw-header {
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    box-shadow: var(--shadow-xs);
    border-bottom: 1px solid var(--color-surface-warm);
  }

  .pw-header__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
  }

  .pw-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  /* Logo */
  .pw-header__logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
    text-decoration: none;
  }

  .pw-header__logo-text {
    font-family: var(--font-serif);
    font-weight: var(--weight-bold);
    font-size: var(--text-xl);
    color: var(--color-heading);
    transition: color var(--transition-base);
  }

  .pw-header__logo:hover .pw-header__logo-text {
    color: var(--color-accent);
  }

  /* Desktop nav */
  .pw-header__nav {
    display: none;
    align-items: center;
    gap: var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  @media (min-width: 1024px) {
    .pw-header__nav { display: flex; }
  }

  .pw-header__nav-link {
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .pw-header__nav-link:hover {
    color: var(--color-link-hover);
  }

  /* Desktop CTA */
  .pw-header__cta {
    display: none;
    align-items: center;
    gap: var(--space-3);
  }

  @media (min-width: 1024px) {
    .pw-header__cta { display: flex; }
  }

  .pw-header__how-we-test {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-subtle);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .pw-header__how-we-test:hover {
    color: var(--color-muted);
    text-decoration: underline;
  }

  .pw-header__cta-btn {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-text-inverse);
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-hover));
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-xl);
    text-decoration: none;
    transition: opacity var(--transition-base);
  }

  .pw-header__cta-btn:hover {
    opacity: 0.9;
  }

  .pw-header__cta-btn--block {
    display: block;
    text-align: center;
    padding: var(--space-3) var(--space-4);
  }

  /* Mobile toggle */
  .pw-header__mobile-toggle {
    padding: var(--space-2);
    border-radius: var(--radius-lg);
    color: var(--color-muted);
    background: none;
    border: none;
    cursor: pointer;
    transition: color var(--transition-base);
  }

  .pw-header__mobile-toggle:hover {
    color: var(--color-heading);
  }

  /* Mobile menu */
  .pw-header__mobile {
    background: var(--color-bg);
    padding: 0 var(--content-padding) var(--space-5);
    border-top: 1px solid var(--color-surface-warm);
  }

  .pw-header__mobile-links {
    padding-top: var(--space-3);
  }

  .pw-header__mobile-secondary {
    padding: var(--space-2) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .pw-header__mobile-link--secondary {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-muted) !important;
    border-bottom: none !important;
  }

  .pw-header__mobile-link--secondary:hover {
    background: var(--color-bg-muted);
    color: var(--color-body-soft) !important;
  }

  .pw-header__mobile-link {
    display: block;
    padding: var(--space-3) 0;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-body-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--color-bg-paper);
    transition: color var(--transition-base);
  }

  .pw-header__mobile-link:hover {
    color: var(--color-link-hover);
  }

  .pw-header__mobile-footer {
    padding-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .pw-header__mobile-meta {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .pw-header__meta-link {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-subtle);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .pw-header__meta-link:hover {
    color: var(--color-muted);
  }
</style>

<script>
  const toggle   = document.getElementById('menu-toggle')!;
  const nav      = document.getElementById('mobile-nav')!;
  const iconOpen = document.getElementById('icon-open')!;
  const iconClose= document.getElementById('icon-close')!;

  toggle.addEventListener('click', () => {
    const isOpen = !nav.classList.contains('hidden');
    nav.classList.toggle('hidden');
    iconOpen.classList.toggle('hidden', !isOpen);
    iconClose.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
