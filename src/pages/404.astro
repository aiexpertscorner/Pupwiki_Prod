---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/static-pages.css';
---

<BaseLayout
  title="Page not found — PupWiki"
  description="The page you were looking for doesn't exist. Browse our breed guides, or use the links below to find what you need."
  canonicalUrl="https://pupwiki.com/404"
>
  <div class="not-found">
    <div class="not-found__inner">
      <p class="not-found__eyebrow">404</p>
      <h1 class="not-found__heading">Page not found</h1>
      <p class="not-found__sub">
        That URL doesn't exist on PupWiki. It may have moved or been removed.
      </p>

      <nav class="not-found__links" aria-label="Helpful navigation">
        <a href="/" class="not-found__btn not-found__btn--primary">← Home</a>
        <a href="/breeds/" class="not-found__btn">Browse breeds</a>
        <a href="/guides/" class="not-found__btn">Dog care guides</a>
        <a href="/cost-calculator/" class="not-found__btn">Cost calculator</a>
      </nav>
    </div>
  </div>
</BaseLayout>
