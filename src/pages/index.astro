---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/home.css';

import HomeHeroDecision from '../components/home/HomeHeroDecision.astro';
import HomeDecisionPaths from '../components/home/HomeDecisionPaths.astro';
import HomeToolsPreview from '../components/home/HomeToolsPreview.astro';
import HomeBreedStarter from '../components/home/HomeBreedStarter.astro';
import HomeCostPlanning from '../components/home/HomeCostPlanning.astro';
import HomeCareHubs from '../components/home/HomeCareHubs.astro';
import HomeFeaturedGuides from '../components/home/HomeFeaturedGuides.astro';
import HomeMethodologyCompact from '../components/home/HomeMethodologyCompact.astro';
import HomeFinalCta from '../components/home/HomeFinalCta.astro';
import HomeAwinShowcase from '../components/home/HomeAwinShowcase.astro';

import getHomepageData from '../lib/homepage/getHomepageData';

const homepage = await getHomepageData();

const {
  seo,
  featureFlags,
  hero,
  decisionPaths,
  toolsPreview,
  breedStarter,
  costPlanning,
  careHubs,
  featuredGuides,
  methodology,
  finalCta,
} = homepage;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: seo.title,
    description: seo.description,
    url: seo.canonicalUrl,
    about: [
      { '@type': 'Thing', name: 'Dog Breeds' },
      { '@type': 'Thing', name: 'Dog Breed Comparison' },
      { '@type': 'Thing', name: 'Dog Ownership Costs' },
      { '@type': 'Thing', name: 'Puppy Planning' },
      { '@type': 'Thing', name: 'Dog Care' },
      { '@type': 'Thing', name: 'Dog Decision Tools' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'PupWiki dog planning tools',
    itemListElement: toolsPreview.live.map((tool: any, index: number) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: tool.name,
      url: new URL(tool.href, seo.canonicalUrl).toString(),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How can PupWiki help me choose a dog breed?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'PupWiki helps you compare breed traits, care needs, size, activity level, grooming, and cost-planning factors so you can narrow down options that may fit your lifestyle. The breed match tool and breed comparison tool are good starting points.',
        },
      },
      {
        '@type': 'Question',
        name: 'Are PupWiki cost estimates accurate quotes?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. PupWiki cost tools provide planning estimates only. Actual costs vary by location, provider, breed, health, lifestyle, and care choices. Use them as a budgeting starting point, not a precise forecast.',
        },
      },
      {
        '@type': 'Question',
        name: 'Does PupWiki replace veterinary advice?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. PupWiki provides educational dog-care information and planning tools, not veterinary diagnosis, treatment, or professional advice. Always consult a qualified veterinarian for your dog\'s health decisions.',
        },
      },
    ],
  },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalUrl={seo.canonicalUrl}
  ogImage={seo.ogImage}
  ogImageAlt={seo.ogImageAlt}
  pageType="website"
  bodyClass="homepage pw-page"
  structuredData={structuredData}
>
  <div class="overflow-x-clip">

    {/* 1 — Decision-first hero */}
    {featureFlags.showHeroDecision && (
      <HomeHeroDecision
        eyebrow={hero.eyebrow}
        title={hero.title}
        subtitle={hero.subtitle}
        primaryCta={hero.primaryCta}
        secondaryCta={hero.secondaryCta}
        goalCard={hero.goalCard}
        trustItems={hero.trustItems}
      />
    )}

    {/* 2 — Self-selection decision paths */}
    {featureFlags.showDecisionPaths && (
      <HomeDecisionPaths
        eyebrow={decisionPaths.eyebrow}
        title={decisionPaths.title}
        items={decisionPaths.items}
      />
    )}

    {/* 3 — Tools preview */}
    {featureFlags.showToolsPreview && (
      <HomeToolsPreview
        eyebrow={toolsPreview.eyebrow}
        title={toolsPreview.title}
        subtitle={toolsPreview.subtitle}
        live={toolsPreview.live}
        comingSoon={toolsPreview.comingSoon}
        ctaHref={toolsPreview.ctaHref}
        ctaLabel={toolsPreview.ctaLabel}
      />
    )}

    {/* 4 — Compact breed starter */}
    {featureFlags.showBreedStarter && (
      <HomeBreedStarter
        eyebrow={breedStarter.eyebrow}
        title={breedStarter.title}
        subtitle={breedStarter.subtitle}
        breeds={breedStarter.breeds}
        primaryCta={breedStarter.primaryCta}
        secondaryCta={breedStarter.secondaryCta}
        mixedBreedsLink={breedStarter.mixedBreedsLink}
      />
    )}

    {/* 5 — Cost and puppy planning */}
    {featureFlags.showCostPlanning && (
      <HomeCostPlanning
        eyebrow={costPlanning.eyebrow}
        title={costPlanning.title}
        subtitle={costPlanning.subtitle}
        disclaimer={costPlanning.disclaimer}
        items={costPlanning.items}
      />
    )}

    {/* 6 — Care hubs */}
    {featureFlags.showCareHubs && (
      <HomeCareHubs
        eyebrow={careHubs.eyebrow}
        title={careHubs.title}
        items={careHubs.items}
      />
    )}

    {/* 6b — AWIN partner showcase */}
    {featureFlags.showAwinSpotlight && (
      <HomeAwinShowcase />
    )}

    {/* 7 — Curated featured guides */}
    {featureFlags.showFeaturedGuides && (
      <HomeFeaturedGuides
        eyebrow={featuredGuides.eyebrow}
        title={featuredGuides.title}
        items={featuredGuides.items}
        viewAllHref={featuredGuides.viewAllHref}
        viewAllLabel={featuredGuides.viewAllLabel}
      />
    )}

    {/* 8 — Methodology compact */}
    {featureFlags.showMethodologyCompact && (
      <HomeMethodologyCompact
        eyebrow={methodology.eyebrow}
        title={methodology.title}
        bullets={methodology.bullets}
        links={methodology.links}
      />
    )}

    {/* 9 — Final CTA */}
    {featureFlags.showFinalCta && (
      <HomeFinalCta
        title={finalCta.title}
        subtitle={finalCta.subtitle}
        primaryCta={finalCta.primaryCta}
        secondaryCta={finalCta.secondaryCta}
        disclaimer={finalCta.disclaimer}
      />
    )}

  </div>
</BaseLayout>
