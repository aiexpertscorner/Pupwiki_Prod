---
import BaseLayout from '../layouts/BaseLayout.astro';

import HomeHero from '../components/home/HomeHeroClean.astro';
import HomeTrustStrip from '../components/home/HomeTrustStrip.astro';
import HomePrimaryJourneys from '../components/home/HomePrimaryJourneys.astro';
import HomeBreedDiscovery from '../components/home/HomeBreedDiscovery.astro';
import HomeLifestyleFilter from '../components/home/HomeLifestyleFilter.astro';
import HomeMixedBreedDiscovery from '../components/home/HomeMixedBreedDiscovery.astro';
import HomeQuickCostTeaser from '../components/home/HomeQuickCostTeaser.astro';
import HomeCareDecisionLayer from '../components/home/HomeCareDecisionLayer.astro';
import HomeEditorialHighlights from '../components/home/HomeEditorialHighlights.astro';
import HomeAwinSpotlight from '../components/home/HomeAwinSpotlight.astro';
import HomeMethodologyTeaser from '../components/home/HomeMethodologyTeaser.astro';
import HomeLeadCapture from '../components/home/HomeLeadCapture.astro';
import HomeBreedExplorer from '../components/home/HomeBreedExplorer.astro';

import getHomepageData from '../lib/homepage/getHomepageData';

const homepage = await getHomepageData();

const {
  seo,
  featureFlags,
  hero,
  primaryJourneys,
  trustStrip,
  breedDiscovery,
  lifestyleFilters,
  quickCostTeaser,
  mixedBreedDiscovery,
  careDecisionLayer,
  editorialHighlights,
  methodologyTeaser,
  leadCapture,
} = homepage;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: seo.title,
    description: seo.description,
    url: seo.canonicalUrl,
    about: [
      { '@type': 'Thing', name: 'Dog Breeds' },
      { '@type': 'Thing', name: 'Mixed Breeds' },
      { '@type': 'Thing', name: 'Dog Care' },
      { '@type': 'Thing', name: 'Dog Costs' },
      { '@type': 'Thing', name: 'Dog Training' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'PupWiki homepage journeys',
    itemListElement: primaryJourneys.items.map((item: any, index: number) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.title,
      url: new URL(item.href, seo.canonicalUrl).toString(),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How do I choose the right dog breed for my lifestyle?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Match breed energy level, size, grooming needs and temperament to your living situation, activity level and experience. PupWiki\'s breed quiz compares your lifestyle with 277+ breed profiles to suggest the best fit.',
        },
      },
      {
        '@type': 'Question',
        name: 'How much does it cost to own a dog per year?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Annual dog ownership costs typically range from $1,200 to $3,500+ depending on breed size, location and care choices. PupWiki\'s cost calculator provides breed-specific, state-adjusted estimates covering food, vet care, grooming and supplies.',
        },
      },
      {
        '@type': 'Question',
        name: 'What is the difference between purebred and mixed breed dogs?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Purebred dogs have predictable size, temperament and coat traits documented over generations. Mixed breeds (crossbreeds) often blend traits from two or more breeds. PupWiki covers 277 purebred profiles and 75 popular crossbreeds including Goldendoodles, Labradoodles and Cockapoos.',
        },
      },
      {
        '@type': 'Question',
        name: 'What are the best names for a new puppy?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Short names with 1–2 syllables ending in a vowel (Bella, Milo, Luna) work best for training. PupWiki\'s dog name generator filters 7,000+ names by breed temperament, style and inspiration — breed-matched for better fit.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is pet insurance worth it for dogs?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Pet insurance is most valuable for breeds with known health risks, puppies (lower premiums, no pre-existing conditions), and owners without a dedicated emergency fund. Use PupWiki\'s cost calculator for breed-specific insurance cost estimates.',
        },
      },
    ],
  },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalUrl={seo.canonicalUrl}
  ogImage={seo.ogImage}
  ogImageAlt={seo.ogImageAlt}
  pageType="website"
  bodyClass="homepage pw-page"
  structuredData={structuredData}
>
  <div class="overflow-x-clip">

    {/* 1 — Hero */}
    {featureFlags.showHero && <HomeHero {...hero} />}

    {/* 2 — Trust strip */}
    {featureFlags.showTrustStrip && <HomeTrustStrip {...trustStrip} />}

    {/* 3 — Primary journeys */}
    {featureFlags.showPrimaryJourneys && <HomePrimaryJourneys {...primaryJourneys} />}

    {/* 4 — Popular breed discovery */}
    {featureFlags.showBreedDiscovery && <HomeBreedDiscovery {...breedDiscovery} />}

    {/* 5 — Lifestyle filter */}
    {(featureFlags as any).showLifestyleFilter && (
      <HomeLifestyleFilter {...lifestyleFilters} />
    )}

    {/* 6 — Mixed breed discovery */}
    {featureFlags.showMixedBreedDiscovery && (
      <HomeMixedBreedDiscovery {...mixedBreedDiscovery} />
    )}

    {/* 7 — Quick cost teaser */}
    {(featureFlags as any).showQuickCostTeaser && (
      <HomeQuickCostTeaser {...quickCostTeaser} />
    )}

    {/* 8 — Care decision layer */}
    {featureFlags.showCareDecisionLayer && <HomeCareDecisionLayer {...careDecisionLayer} />}

    {/* 9 — Editorial highlights */}
    {featureFlags.showEditorialHighlights && (
      <HomeEditorialHighlights
        id="home-editorial-highlights"
        eyebrow={editorialHighlights.eyebrow}
        title={editorialHighlights.title}
        subtitle={editorialHighlights.subtitle}
        viewAllHref={editorialHighlights.viewAllHref}
        viewAllLabel={editorialHighlights.viewAllLabel}
        items={editorialHighlights.items}
      />
    )}

    {/* 10 — AWIN partner spotlight */}
    {(featureFlags as any).showAwinSpotlight && <HomeAwinSpotlight />}

    {/* 11 — Methodology teaser */}
    {featureFlags.showMethodologyTeaser && <HomeMethodologyTeaser {...methodologyTeaser} />}

    {/* 12 — Lead capture / CTA close */}
    {featureFlags.showLeadCapture && <HomeLeadCapture {...leadCapture} />}

    {/* 13 — Full breed explorer (power tool, below fold) */}
    {(featureFlags as any).showBreedExplorer && (
      <div id="full-breed-finder">
        <div class="mx-auto max-w-7xl px-4 pb-2 pt-10 sm:px-5 lg:px-6">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-primary)]">Full breed finder</p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-[var(--color-heading)] sm:text-3xl">Search and filter all 352 breeds &amp; mixes</h2>
        </div>
        <HomeBreedExplorer id="home-breed-explorer" />
      </div>
    )}

  </div>
</BaseLayout>
