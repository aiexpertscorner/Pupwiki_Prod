---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

const REVIEW_CATEGORIES = [
  { key: 'dog-food',    label: 'Dog Food',       icon: '🍖', href: '/categories/dog-food' },
  { key: 'training',   label: 'Training & Gear', icon: '🦮', href: '/categories/training' },
  { key: 'beds',       label: 'Beds & Comfort',  icon: '🛏️', href: '/categories/beds' },
  { key: 'grooming',   label: 'Grooming',        icon: '✂️', href: '/categories/grooming' },
  { key: 'toys',       label: 'Toys',            icon: '🎾', href: '/categories/toys' },
  { key: 'health',     label: 'Health',          icon: '🩺', href: '/categories/health' },
  { key: 'supplements',label: 'Supplements',     icon: '💊', href: '/categories/supplements' },
  { key: 'lifestyle',  label: 'Lifestyle',       icon: '🎁', href: '/categories/lifestyle' },
];

const REVIEW_POST_TYPES = new Set(['product-roundup', 'comparison', 'review']);

function isReviewPost(post: any): boolean {
  if (post.data.noIndex || post.data.noRoute) return false;
  if (post.data.generated === true) return false;
  if (post.data.indexInBlog === false) return false;
  const postType = (post.data.postType || '').toLowerCase();
  return REVIEW_POST_TYPES.has(postType);
}

function isGuidePost(post: any): boolean {
  if (post.data.noIndex || post.data.noRoute) return false;
  if (post.data.generated === true) return false;
  if (post.data.indexInBlog === false) return false;
  const postType = (post.data.postType || '').toLowerCase();
  return postType === 'general' || postType === 'how-to';
}

const reviewPosts = allPosts
  .filter(isReviewPost)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const featuredPost = reviewPosts[0] ?? null;
const latestReviews = reviewPosts.slice(1, 13);

const guidePosts = allPosts.filter(isGuidePost)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 4);

function formatDate(d: Date | string) {
  return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(d));
}

function getCategoryLabel(cat: string | undefined): string {
  if (!cat) return 'Product Review';
  const match = REVIEW_CATEGORIES.find(c => cat.toLowerCase().includes(c.key) || c.key.includes(cat.toLowerCase()));
  return match?.label ?? cat;
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pupwiki.com/' },
    { '@type': 'ListItem', position: 2, name: 'Reviews', item: 'https://pupwiki.com/reviews' },
  ],
};

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Dog Product Reviews — PupWiki',
  description: 'Honest product comparisons and buying guides for dog food, gear, beds, grooming, toys and supplements.',
  url: 'https://pupwiki.com/reviews',
  publisher: { '@type': 'Organization', name: 'PupWiki', url: 'https://pupwiki.com' },
};
---

<BaseLayout
  title="Dog Product Reviews & Comparisons — PupWiki"
  description="Honest dog product reviews and buying comparisons across food, gear, beds, grooming, toys and supplements. Research-backed picks for every breed and budget."
  canonicalUrl="https://pupwiki.com/reviews"
  pageType="collection"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(collectionLd)} slot="head" />

  <div class="reviews-hub">
    <div class="container">

      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item">
            <a href="/" class="breadcrumb__link">Home</a>
            <span class="breadcrumb__sep" aria-hidden="true">›</span>
          </li>
          <li class="breadcrumb__item">
            <span class="breadcrumb__current" aria-current="page">Reviews</span>
          </li>
        </ol>
      </nav>

      <header class="reviews-hub__header">
        <div class="content-type-badge content-type-badge--review">Product Reviews</div>
        <h1 class="reviews-hub__title">Dog Product Reviews & Comparisons</h1>
        <p class="reviews-hub__lead">
          Honest product comparisons, buying guides, and breed-matched picks — across food, gear, beds,
          grooming, toys and supplements. No hype, just practical context for your dog.
        </p>
      </header>

      <!-- Browse by category -->
      <section aria-labelledby="reviews-categories-title">
        <h2 id="reviews-categories-title" class="reviews-hub__section-heading">Browse by Category</h2>
        <div class="reviews-hub__cat-grid">
          {REVIEW_CATEGORIES.map((cat) => (
            <a href={cat.href} class="reviews-hub__cat-card">
              <span class="reviews-hub__cat-icon" aria-hidden="true">{cat.icon}</span>
              <span class="reviews-hub__cat-label">{cat.label}</span>
              <span class="reviews-hub__cat-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Featured review -->
      {featuredPost && (
        <section aria-labelledby="reviews-featured-title" class="reviews-hub__section">
          <h2 id="reviews-featured-title" class="reviews-hub__section-heading">Featured Review</h2>
          <a href={`/blog/${featuredPost.slug}`} class="reviews-hub__featured">
            <div class="reviews-hub__featured-body">
              <div class="reviews-hub__featured-meta">
                <span class="content-type-badge content-type-badge--review">
                  {getCategoryLabel(featuredPost.data.category)}
                </span>
                <time datetime={String(featuredPost.data.pubDate)} class="reviews-hub__date">
                  {formatDate(featuredPost.data.pubDate)}
                </time>
              </div>
              <h3 class="reviews-hub__featured-title">{featuredPost.data.title}</h3>
              {featuredPost.data.description && (
                <p class="reviews-hub__featured-desc">{featuredPost.data.description}</p>
              )}
              <span class="reviews-hub__read-link">Read review →</span>
            </div>
          </a>
        </section>
      )}

      <!-- Latest reviews grid -->
      {latestReviews.length > 0 && (
        <section aria-labelledby="reviews-latest-title" class="reviews-hub__section">
          <h2 id="reviews-latest-title" class="reviews-hub__section-heading">Latest Reviews</h2>
          <div class="reviews-hub__grid">
            {latestReviews.map((post) => (
              <a href={`/blog/${post.slug}`} class="reviews-hub__card">
                <div class="reviews-hub__card-meta">
                  <span class="content-type-badge content-type-badge--review">
                    {getCategoryLabel(post.data.category)}
                  </span>
                  <time datetime={String(post.data.pubDate)} class="reviews-hub__date">
                    {formatDate(post.data.pubDate)}
                  </time>
                </div>
                <h3 class="reviews-hub__card-title">{post.data.title}</h3>
                {post.data.description && (
                  <p class="reviews-hub__card-desc">{post.data.description}</p>
                )}
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Buying guides crosslink -->
      {guidePosts.length > 0 && (
        <section aria-labelledby="reviews-guides-title" class="reviews-hub__section">
          <h2 id="reviews-guides-title" class="reviews-hub__section-heading">Buying Guides</h2>
          <div class="reviews-hub__guides">
            {guidePosts.map((post) => (
              <a href={`/blog/${post.slug}`} class="reviews-hub__guide-card">
                <span class="content-type-badge content-type-badge--guide">Guide</span>
                <h3 class="reviews-hub__guide-title">{post.data.title}</h3>
                {post.data.description && (
                  <p class="reviews-hub__guide-desc">{post.data.description}</p>
                )}
              </a>
            ))}
          </div>
          <div class="reviews-hub__more-link-wrap">
            <a href="/guides" class="reviews-hub__more-link">Browse all guides →</a>
          </div>
        </section>
      )}

      <!-- Methodology note -->
      <aside class="reviews-hub__methodology">
        <p class="reviews-hub__methodology-text">
          <strong>How we review:</strong> PupWiki combines structured product research, breed-matched
          needs, user review data, and editorial standards to surface practical picks. We do not accept
          payment for placement. <a href="/how-we-test">Read our methodology →</a>
        </p>
      </aside>

    </div>
  </div>
</BaseLayout>

<style>
  .reviews-hub {
    padding-block: var(--space-10);
  }

  .reviews-hub .container {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: var(--space-4);
  }

  .reviews-hub__header {
    margin-block: var(--space-4) var(--space-8);
  }

  .reviews-hub__title {
    font-family: var(--font-display);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    color: var(--color-heading);
    margin-block: var(--space-3);
  }

  .reviews-hub__lead {
    max-width: 64ch;
    color: var(--color-body-soft);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .reviews-hub__section {
    margin-block-start: var(--space-10);
  }

  .reviews-hub__section-heading {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-heading);
    margin-block-end: var(--space-5);
    padding-block-end: var(--space-2);
    border-block-end: 2px solid var(--color-border);
  }

  /* ── Category grid ── */
  .reviews-hub__cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-3);
    margin-block-start: var(--space-5);
  }

  .reviews-hub__cat-card {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    text-decoration: none;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .reviews-hub__cat-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-sm);
  }

  .reviews-hub__cat-icon {
    font-size: 1.3rem;
    flex-shrink: 0;
  }

  .reviews-hub__cat-label {
    flex: 1;
    font-size: var(--text-sm);
    font-weight: var(--weight-semi);
    color: var(--color-heading);
  }

  .reviews-hub__cat-arrow {
    color: var(--color-accent);
    font-size: var(--text-sm);
  }

  /* ── Featured review ── */
  .reviews-hub__featured {
    display: block;
    padding: var(--space-6);
    border: 2px solid var(--color-accent-light);
    border-radius: var(--radius-xl);
    background: var(--color-accent-subtle);
    text-decoration: none;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .reviews-hub__featured:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-card);
  }

  .reviews-hub__featured-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-3);
  }

  .reviews-hub__date {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .reviews-hub__featured-title {
    font-size: clamp(var(--text-xl), 2.5vw, var(--text-2xl));
    font-weight: var(--weight-bold);
    color: var(--color-heading);
    margin-block-end: var(--space-3);
    line-height: 1.3;
  }

  .reviews-hub__featured-desc {
    font-size: var(--text-base);
    color: var(--color-body-soft);
    line-height: 1.6;
    margin-block-end: var(--space-4);
    max-width: 60ch;
  }

  .reviews-hub__read-link {
    font-size: var(--text-sm);
    font-weight: var(--weight-semi);
    color: var(--color-accent);
  }

  /* ── Reviews grid ── */
  .reviews-hub__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--space-4);
  }

  .reviews-hub__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    text-decoration: none;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .reviews-hub__card:hover {
    border-color: var(--color-accent-light);
    box-shadow: var(--shadow-sm);
  }

  .reviews-hub__card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .reviews-hub__card-title {
    font-size: var(--text-base);
    font-weight: var(--weight-semi);
    color: var(--color-heading);
    line-height: 1.35;
    margin: 0;
  }

  .reviews-hub__card-desc {
    font-size: var(--text-sm);
    color: var(--color-body-soft);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Buying guides ── */
  .reviews-hub__guides {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: var(--space-4);
  }

  .reviews-hub__guide-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-primary-subtle);
    text-decoration: none;
    transition: border-color var(--transition-base);
  }

  .reviews-hub__guide-card:hover {
    border-color: var(--color-primary);
  }

  .reviews-hub__guide-title {
    font-size: var(--text-base);
    font-weight: var(--weight-semi);
    color: var(--color-heading);
    line-height: 1.35;
    margin: 0;
  }

  .reviews-hub__guide-desc {
    font-size: var(--text-sm);
    color: var(--color-body-soft);
    line-height: 1.5;
    margin: 0;
  }

  .reviews-hub__more-link-wrap {
    margin-block-start: var(--space-4);
    text-align: right;
  }

  .reviews-hub__more-link {
    font-size: var(--text-sm);
    font-weight: var(--weight-semi);
    color: var(--color-accent);
    text-decoration: none;
  }

  .reviews-hub__more-link:hover {
    text-decoration: underline;
  }

  /* ── Methodology aside ── */
  .reviews-hub__methodology {
    margin-block-start: var(--space-10);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-muted);
  }

  .reviews-hub__methodology-text {
    font-size: var(--text-sm);
    color: var(--color-body-soft);
    line-height: 1.65;
    margin: 0;
  }

  .reviews-hub__methodology-text a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* Breadcrumb */
  .breadcrumb { padding-block: var(--space-3); }
  .breadcrumb__list { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1); list-style: none; padding: 0; margin: 0; }
  .breadcrumb__item { display: inline-flex; align-items: center; gap: var(--space-1); }
  .breadcrumb__link { font-size: var(--text-sm); color: var(--color-muted); text-decoration: none; transition: color var(--transition-base); }
  .breadcrumb__link:hover { color: var(--color-heading); }
  .breadcrumb__current { font-size: var(--text-sm); color: var(--color-body-soft); font-weight: var(--weight-medium); }
  .breadcrumb__sep { color: var(--color-placeholder); font-size: var(--text-sm); }

  @media (max-width: 768px) {
    .reviews-hub__cat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .reviews-hub__grid,
    .reviews-hub__guides {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .reviews-hub__cat-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
