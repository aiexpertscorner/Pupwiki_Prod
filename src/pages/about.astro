---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/about.css';

const SITE = 'https://pupwiki.com';
const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',  item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'About', item: `${SITE}/about` },
  ],
});
---

<BaseLayout
  title="About PupWiki — The Dog Wiki Built by Dog Owners"
  description="PupWiki is the authoritative dog knowledge platform covering 277 breeds with breed-specific guides, cost data, and expert gear reviews."
  canonicalUrl={`${SITE}/about`}
>
  <script type="application/ld+json" set:html={breadcrumbLd} />

  <!-- Hero -->
  <div class="about-hero">
    <div class="max-w-4xl mx-auto px-4 py-14 sm:py-20 text-center">
      <nav class="about-breadcrumb font-sans text-sm mb-6 flex items-center justify-center gap-1.5">
        <a href="/" class="about-breadcrumb-link hover:underline">Home</a>
        <span>›</span>
        <span class="about-breadcrumb-current">About</span>
      </nav>
      <span class="about-badge inline-block font-sans text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-5">
        Est. 2024
      </span>
      <h1 class="about-serif-heading font-display text-4xl sm:text-5xl font-bold mb-4 leading-tight">
        About PupWiki
      </h1>
      <p class="about-lead font-sans text-lg max-w-2xl mx-auto leading-relaxed">
        We built the dog product resource we always wished existed — honest, breed-specific, and backed by real data rather than brand deals.
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-14 space-y-16">

    <!-- Origin story -->
    <section class="grid md:grid-cols-2 gap-10 items-center">
      <div>
        <p class="about-accent font-sans text-xs font-bold uppercase tracking-widest mb-2">Our story</p>
        <h2 class="about-serif-heading font-display text-3xl font-bold mb-5">
          Built out of frustration
        </h2>
        <div class="about-body space-y-4 font-sans text-base leading-relaxed">
          <p>As dog owners, we kept running into the same problem: product review sites that were either paid by brands, riddled with fake five-star reviews, or so generic they were useless for our specific breeds.</p>
          <p>A recommendation for a "large breed dog food" that works for a Labrador isn't necessarily right for a Great Dane. Grooming advice for a double-coated breed is completely different from a short-coat breed. The internet treated all dogs the same.</p>
          <p>So we built something different. PupWiki covers <strong class="about-heading-color">277 dog breeds</strong> with product picks, care guides, and health information matched specifically to each breed's size, energy level, coat type, and known health risks.</p>
        </div>
      </div>
      <div class="about-stats-panel rounded-3xl overflow-hidden">
        <div class="about-emoji-xl">🐾</div>
        <div class="grid grid-cols-2 gap-4">
          {[
            ['277', 'Breeds covered'],
            ['2,360+', 'Expert guides'],
            ['125+', 'Products reviewed'],
            ['7,000+', 'Names curated'],
          ].map(([num, label]) => (
            <div class="about-stat-box rounded-2xl p-3">
              <div class="about-stat-value font-display text-2xl font-black">{num}</div>
              <div class="about-lead font-sans text-xs mt-0.5">{label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- What makes us different -->
    <section>
      <p class="about-accent font-sans text-xs font-bold uppercase tracking-widest mb-2">Our approach</p>
      <h2 class="about-serif-heading font-display text-3xl font-bold mb-8">
        What makes us different
      </h2>
      <div class="grid sm:grid-cols-2 gap-5">
        {[
          {
            icon: '🧬',
            title: 'Breed-specific recommendations',
            body: 'Every product pick is matched to a breed\'s actual characteristics: size, energy level, coat type, shedding level, and known health vulnerabilities. We don\'t give generic advice.',
          },
          {
            icon: '📊',
            title: 'Data-driven scoring',
            body: 'Our product scores combine verified buyer reviews, ingredient analysis, brand reputation data, and veterinary guidance — not brand sponsorships or commission rates.',
          },
          {
            icon: '🩺',
            title: 'Health-first editorial policy',
            body: 'For food, supplements, and health products, we reference peer-reviewed veterinary research. We flag known risks, ongoing FDA investigations, and ingredient concerns.',
          },
          {
            icon: '💬',
            title: 'Real pros and cons',
            body: 'Every review includes genuine cons, not just pros. If a product has a recurring issue in 15% of verified reviews, we tell you — even if it\'s our top pick overall.',
          },
          {
            icon: '🔄',
            title: 'Regularly updated',
            body: 'Products change. Formulas get updated. New options enter the market. We review and update our recommendations regularly rather than publishing once and forgetting.',
          },
          {
            icon: '🚫',
            title: 'No paid placements',
            body: 'Brands cannot pay to appear in our recommendations. Our top picks are determined by our scoring methodology. Full stop.',
          },
        ].map(item => (
          <div class="about-card rounded-2xl p-5">
            <div class="about-emoji-lg">{item.icon}</div>
            <h3 class="about-heading-color font-sans font-bold text-base mb-2">{item.title}</h3>
            <p class="about-lead font-sans text-sm leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- What we cover -->
    <section class="about-section-card rounded-3xl p-8">
      <p class="about-accent font-sans text-xs font-bold uppercase tracking-widest mb-2">Coverage</p>
      <h2 class="about-serif-heading font-display text-3xl font-bold mb-6">
        What we cover
      </h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
        {[
          ['🍖', 'Dog Food', 'Dry, wet, raw, fresh, and breed-specific formulas'],
          ['🎾', 'Toys & Enrichment', 'Chew toys, puzzles, fetch, enrichment feeders'],
          ['🛏️', 'Beds & Sleep', 'Orthopedic, calming, elevated, travel beds'],
          ['✂️', 'Grooming', 'Brushes, shampoos, nail care, deshedding tools'],
          ['🩺', 'Health & Prevention', 'DNA tests, flea & tick, dental, wound care'],
          ['💊', 'Supplements', 'Joint, probiotic, omega-3, calming, multivitamins'],
          ['🦮', 'Training & Gear', 'Harnesses, leashes, GPS trackers, collars'],
          ['✍️', 'Dog Names', '7,000+ curated names matched to breed personality'],
          ['📊', 'Breed Guides', 'Complete care hubs for every recognised breed'],
        ].map(([icon, title, desc]) => (
          <div class="flex gap-3 items-start">
            <span class="about-emoji-sm">{icon}</span>
            <div>
              <p class="about-heading-color font-sans font-bold text-sm">{title}</p>
              <p class="about-lead font-sans text-xs mt-0.5">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Reader support transparency -->
    <section class="about-transparency rounded-3xl p-8">
      <div class="flex gap-4 items-start">
        <span class="about-emoji-disclosure">⚖️</span>
        <div>
          <h2 class="about-serif-heading font-display text-2xl font-bold mb-3">
            How we make money — transparently
          </h2>
          <div class="about-body space-y-3 font-sans text-sm leading-relaxed">
            <p>PupWiki works with selected dog-care brands, including ChefPaw, Raw Wild, JugBow, and Crown & Paw, and may earn a small commission when readers buy through some links. We keep product recommendations separate from payment arrangements.</p>
            <p>Reader-supported income helps keep the site free and updated. It does not influence which products or brands we recommend. Our top picks are determined by dog relevance, safety notes, owner fit, and product quality signals.</p>
            <p>We also never accept payment from brands in exchange for favorable coverage. If a brand wants to appear in our recommendations, the only way is to make a genuinely excellent product.</p>
          </div>
          <a href="/disclosure" class="about-accent inline-block mt-4 font-sans text-sm font-bold hover:underline">
            Read our full reader-support policy →
          </a>
        </div>
      </div>
    </section>

    <!-- Explore PupWiki -->
    <section>
      <p class="about-primary-color font-sans text-xs font-bold uppercase tracking-widest mb-2">Explore</p>
      <h2 class="about-serif-heading font-display text-2xl font-bold mb-6">
        Dig into PupWiki
      </h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
        {[
          { icon: '🐾', label: 'Breed Explorer', desc: 'Browse and filter 277+ recognised breeds by size, energy, coat, and group', href: '/breeds' },
          { icon: '💰', label: 'Cost Calculator', desc: 'Get breed-specific annual and lifetime dog ownership cost breakdowns', href: '/cost-calculator' },
          { icon: '✍️', label: 'Dog Name Guides', desc: '7,000+ curated names filtered by breed personality and style', href: '/dog-names' },
          { icon: '🐕', label: 'First Dog Guide', desc: 'Step-by-step planning guide for first-time dog owners', href: '/guides/first-dog' },
          { icon: '🏥', label: 'Pet Insurance', desc: 'Understand coverage types, breed risks, and what to look for in a policy', href: '/pet-insurance' },
          { icon: '📖', label: 'Breed Guides', desc: 'Deep-dive care hubs covering health, feeding, training, and products per breed', href: '/breeds' },
        ].map(item => (
          <a href={item.href} class="about-explore-card rounded-2xl p-5 hover:shadow-md transition-shadow">
            <span class="about-emoji-md">{item.icon}</span>
            <p class="about-heading-color font-sans font-bold text-sm mb-1">{item.label}</p>
            <p class="about-lead font-sans text-xs leading-relaxed">{item.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Contact CTA -->
    <section class="text-center">
      <h2 class="about-serif-heading font-display text-2xl font-bold mb-3">
        Questions or feedback?
      </h2>
      <p class="about-lead font-sans text-base mb-6">
        We read every message. If you've spotted an error, have a product suggestion, or want to tell us about your dog, we'd love to hear from you.
      </p>
      <a href="/contact" class="about-cta-btn inline-block font-sans font-bold text-sm px-8 py-3 rounded-xl text-white btn-bark">
        Get in touch →
      </a>
    </section>

  </div>
</BaseLayout>
