---
/**
 * src/pages/categories/training.astro
 *
 * Static override for /categories/training — adds a custom training
 * methodology context section above the breed guide grid.
 * Overrides the dynamic [category].astro route for this slug.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

import CategoryHero from '../../components/category/CategoryHero.astro';
import CategoryQuickNav from '../../components/category/CategoryQuickNav.astro';
import CategoryPartnerBlock from '../../components/category/CategoryPartnerBlock.astro';
import CategoryAmazonBlock from '../../components/category/CategoryAmazonBlock.astro';
import CategoryBreedGuides from '../../components/category/CategoryBreedGuides.astro';
import CategoryOwnerResources from '../../components/category/CategoryOwnerResources.astro';
import CategoryArticleGrid from '../../components/category/CategoryArticleGrid.astro';
import CategoryRelatedTopics from '../../components/category/CategoryRelatedTopics.astro';
import CategoryEmptyState from '../../components/category/CategoryEmptyState.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

import masterBreeds from '../../data/master-breeds.json';
import masterCrossbreeds from '../../data/master-crossbreeds.json';
import breedLinkMap from '../../data/breed-link-map.json';
import contentStatus from '../../data/content-status.json';

import {
  buildBreadcrumbLd,
  buildCollectionPageLd,
  buildItemListLd,
  getAwinTags,
  getCategoryBreedGuides,
  getCategoryLinks,
  getCategoryMeta,
  getCategoryPosts,
  getRelatedCategoryCards,
} from '../../lib/categories/categoryHelpers';

import '../../styles/pages/category-hub.css';

const SITE = 'https://pupwiki.com';
const categorySlug = 'training';

const meta = getCategoryMeta(categorySlug)!;
const allPosts = await getCollection('guides');
const catPosts = getCategoryPosts(allPosts as any, categorySlug, meta);
const featuredPosts = catPosts.slice(0, 9);
const supportingPosts = catPosts.slice(9, 21);

const allBreedRecords = [...(masterBreeds as any[]), ...(masterCrossbreeds as any[])];
const breedGuides = getCategoryBreedGuides({
  categorySlug,
  allBreeds: allBreedRecords,
  breedLinkMap: breedLinkMap as any,
  contentStatus: contentStatus as any,
});

const featuredBreedGuides = breedGuides;
const breedChips = breedGuides.slice(0, 10);
const categoryLinks = getCategoryLinks(categorySlug);
const relatedCards = getRelatedCategoryCards(categorySlug);
const awinTags = getAwinTags(categorySlug, meta);

const breadcrumbLd = buildBreadcrumbLd(meta, categorySlug);
const collectionPageLd = buildCollectionPageLd(meta, categorySlug);
const itemListLd = buildItemListLd({ meta, breedGuides: featuredBreedGuides, posts: featuredPosts as any });
---

<BaseLayout
  title={meta.seoTitle}
  description={meta.seoDescription}
  canonicalUrl={`${SITE}/categories/${categorySlug}`}
  pageType="collection"
>
  <script type="application/ld+json" set:html={breadcrumbLd} />
  <script type="application/ld+json" set:html={collectionPageLd} />
  {itemListLd && <script type="application/ld+json" set:html={itemListLd} />}

  <div class:list={['category-hub', `category-hub--${meta.theme}`]}>
    <div class="category-hub__container">
      <Breadcrumb
        items={[
          { label: 'Home', href: '/' },
          { label: meta.title, current: true },
        ]}
      />
    </div>

    <CategoryHero meta={meta} />

    <CategoryQuickNav
      hasPosts={featuredPosts.length > 0}
      hasBreedGuides={featuredBreedGuides.length > 0}
    />

    <!-- Custom: Training methodology callout -->
    <section class="category-hub__section category-hub__section--soft">
      <div class="category-hub__container">
        <div class="category-hub__section-header">
          <p class="category-hub__eyebrow">What the research says</p>
          <h2>Breed temperament shapes training approach</h2>
          <p>
            Positive reinforcement — rewarding wanted behaviour rather than punishing unwanted
            behaviour — is the approach consistently supported by canine behaviour science.
            How quickly it works, and what specific techniques are most effective, depends heavily
            on the individual dog's breed background, age and prior experience.
          </p>
        </div>
        <div class="training-method-grid">
          <div class="category-hub__link-card">
            <span aria-hidden="true">🏆</span>
            <strong>Easiest to train</strong>
            <p>Border Collies, Poodles, Golden Retrievers and German Shepherds rank highest for trainability — they pick up cues quickly and work for praise.</p>
          </div>
          <div class="category-hub__link-card">
            <span aria-hidden="true">⏱️</span>
            <strong>Harder to train</strong>
            <p>Hounds, terriers and independent northern breeds have strong instincts that compete with owner cues. They aren't less intelligent — just less motivated by compliance.</p>
          </div>
          <div class="category-hub__link-card">
            <span aria-hidden="true">📍</span>
            <strong>Walking gear matters</strong>
            <p>The right harness and leash reduce pulling and allow consistent reinforcement. No-pull harnesses clip to the front ring — they redirect, not restrict.</p>
          </div>
          <div class="category-hub__link-card">
            <span aria-hidden="true">🐶</span>
            <strong>Puppy vs adult training</strong>
            <p>Puppies form habits during critical windows. Adult dogs can still learn — but require more patience and consistency. Age shapes the approach, not the outcome.</p>
          </div>
        </div>
        <div class="training-method-cta">
          <a href="/breeds">Compare trainability across breeds →</a>
        </div>
      </div>
    </section>

    <!-- Resource strip: quick links -->
    <section class="training-resource-strip">
      <div class="category-hub__container">
        <div class="training-resource-grid">
          <a href="/tools/breed-match" class="training-resource-card">
            <p class="training-resource-card__eyebrow">Find your match</p>
            <strong>Breed Quiz</strong>
            <p>Answer a few questions and get matched to breeds that fit your lifestyle and training expectations.</p>
            <span aria-hidden="true">→</span>
          </a>
          <a href="/guides/first-dog" class="training-resource-card">
            <p class="training-resource-card__eyebrow">New owners</p>
            <strong>First Dog Guide</strong>
            <p>Everything first-time owners need — from choosing a breed to training fundamentals and daily care.</p>
            <span aria-hidden="true">→</span>
          </a>
          <a href="/categories/lifestyle" class="training-resource-card">
            <p class="training-resource-card__eyebrow">Mental stimulation</p>
            <strong>Toys &amp; Enrichment</strong>
            <p>Mental stimulation reduces problem behaviours. Browse toys, puzzle feeders, and gear by breed size.</p>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    {breedChips.length >= 3 && (
      <section class="category-hub__strip" aria-label={`${meta.title} breed shortcuts`}>
        <div class="category-hub__container">
          <div class="category-hub__strip-header">
            <p>{meta.title} by breed</p>
            <a href="/breeds">All breeds →</a>
          </div>
          <div class="category-hub__chip-row">
            {breedChips.map((breed) => (
              <a href={breed.href}>{breed.name}</a>
            ))}
          </div>
        </div>
      </section>
    )}

    <CategoryBreedGuides
      meta={meta}
      guides={featuredBreedGuides}
      contextDesc="Browse breeds by trainability — from highly responsive to more independent. Each card links to the full breed profile with traits, energy, and owner-difficulty ratings."
    />

    <CategoryOwnerResources
      meta={meta}
      categorySlug={categorySlug}
      links={categoryLinks}
      tags={awinTags.secondary}
    />

    {featuredPosts.length > 0 && (
      <CategoryArticleGrid
        meta={meta}
        posts={featuredPosts}
        supportingPosts={supportingPosts}
        totalCount={catPosts.length}
      />
    )}

    <CategoryPartnerBlock meta={meta} categorySlug={categorySlug} tags={awinTags.primary} />
    <CategoryAmazonBlock meta={meta} categorySlug={categorySlug} />

    <!-- Also worth reading: real training guides -->
    <section class="training-reads">
      <div class="category-hub__container">
        <div class="training-reads__header">
          <p class="category-hub__eyebrow">Also worth reading</p>
          <h2>Training guides worth bookmarking</h2>
        </div>
        <div class="training-reads__grid">
          <a href="/guides/puppy-crate-training-guide" class="training-reads__card">
            <p class="training-reads__card-eyebrow">Puppy training</p>
            <strong>The Ultimate Guide to Puppy Crate Training</strong>
            <span aria-hidden="true">Read more →</span>
          </a>
          <a href="/guides/best-training-tools-stubborn-dogs-2026" class="training-reads__card">
            <p class="training-reads__card-eyebrow">Gear roundup</p>
            <strong>Training Gear for Dogs That Don't Listen</strong>
            <span aria-hidden="true">Read more →</span>
          </a>
          <a href="/guides/best-dog-training-collars" class="training-reads__card">
            <p class="training-reads__card-eyebrow">Product comparison</p>
            <strong>Best Dog Training Collars 2026</strong>
            <span aria-hidden="true">Read more →</span>
          </a>
          <a href="/guides/training-an-adult-dog" class="training-reads__card">
            <p class="training-reads__card-eyebrow">Adult dogs</p>
            <strong>How to Train an Adult Dog: Is It Ever Too Late?</strong>
            <span aria-hidden="true">Read more →</span>
          </a>
        </div>
      </div>
    </section>

    <CategoryRelatedTopics meta={meta} cards={relatedCards} />

    {featuredPosts.length === 0 && featuredBreedGuides.length === 0 && (
      <CategoryEmptyState meta={meta} />
    )}
  </div>
</BaseLayout>
