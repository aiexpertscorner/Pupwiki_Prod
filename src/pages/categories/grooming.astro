---
/**
 * src/pages/categories/grooming.astro
 *
 * Static override for /categories/grooming — adds a custom coat-care
 * methodology section and resource strip above the breed guide grid.
 * Overrides the dynamic [category].astro route for this slug.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

import CategoryHero from '../../components/category/CategoryHero.astro';
import CategoryQuickNav from '../../components/category/CategoryQuickNav.astro';
import CategoryPartnerBlock from '../../components/category/CategoryPartnerBlock.astro';
import CategoryAmazonBlock from '../../components/category/CategoryAmazonBlock.astro';
import CategoryBreedGuides from '../../components/category/CategoryBreedGuides.astro';
import CategoryOwnerResources from '../../components/category/CategoryOwnerResources.astro';
import CategoryArticleGrid from '../../components/category/CategoryArticleGrid.astro';
import CategoryRelatedTopics from '../../components/category/CategoryRelatedTopics.astro';
import CategoryEmptyState from '../../components/category/CategoryEmptyState.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

import masterBreeds from '../../data/master-breeds.json';
import masterCrossbreeds from '../../data/master-crossbreeds.json';
import breedLinkMap from '../../data/breed-link-map.json';
import contentStatus from '../../data/content-status.json';

import {
  buildBreadcrumbLd,
  buildCollectionPageLd,
  buildItemListLd,
  getAwinTags,
  getCategoryBreedGuides,
  getCategoryLinks,
  getCategoryMeta,
  getCategoryPosts,
  getRelatedCategoryCards,
} from '../../lib/categories/categoryHelpers';

import '../../styles/pages/category-hub.css';

const SITE = 'https://pupwiki.com';
const categorySlug = 'grooming';

const meta = getCategoryMeta(categorySlug)!;
const allPosts = await getCollection('guides');
const catPosts = getCategoryPosts(allPosts as any, categorySlug, meta);
const featuredPosts = catPosts.slice(0, 9);
const supportingPosts = catPosts.slice(9, 21);

const allBreedRecords = [...(masterBreeds as any[]), ...(masterCrossbreeds as any[])];
const breedGuides = getCategoryBreedGuides({
  categorySlug,
  allBreeds: allBreedRecords,
  breedLinkMap: breedLinkMap as any,
  contentStatus: contentStatus as any,
});

const featuredBreedGuides = breedGuides;
const breedChips = breedGuides.slice(0, 10);
const categoryLinks = getCategoryLinks(categorySlug);
const relatedCards = getRelatedCategoryCards(categorySlug);
const awinTags = getAwinTags(categorySlug, meta);

const breadcrumbLd = buildBreadcrumbLd(meta, categorySlug);
const collectionPageLd = buildCollectionPageLd(meta, categorySlug);
const itemListLd = buildItemListLd({ meta, breedGuides: featuredBreedGuides, posts: featuredPosts as any });
---

<BaseLayout
  title={meta.seoTitle}
  description={meta.seoDescription}
  canonicalUrl={`${SITE}/categories/${categorySlug}`}
  pageType="collection"
>
  <script type="application/ld+json" set:html={breadcrumbLd} />
  <script type="application/ld+json" set:html={collectionPageLd} />
  {itemListLd && <script type="application/ld+json" set:html={itemListLd} />}

  <div class:list={['category-hub', `category-hub--${meta.theme}`]}>
    <div class="category-hub__container">
      <Breadcrumb
        items={[
          { label: 'Home', href: '/' },
          { label: meta.title, current: true },
        ]}
      />
    </div>

    <CategoryHero meta={meta} />

    <CategoryQuickNav
      hasPosts={featuredPosts.length > 0}
      hasBreedGuides={featuredBreedGuides.length > 0}
    />

    <!-- Custom: Coat care methodology callout -->
    <section class="category-hub__section category-hub__section--soft">
      <div class="category-hub__container">
        <div class="category-hub__section-header">
          <p class="category-hub__eyebrow">Coat care context</p>
          <h2>Coat type sets the schedule</h2>
          <p>
            Grooming needs are determined by coat type, not breed size. A consistent routine —
            matched to your specific dog's coat — prevents matting, manages shedding, and
            keeps skin healthy between baths. Know your coat type first.
          </p>
        </div>
        <div class="grooming-method-grid">
          <div class="category-hub__link-card">
            <span aria-hidden="true">✂️</span>
            <strong>Coat type determines everything</strong>
            <p>Short coats need weekly brushing, double coats need seasonal deshedding, and curly or wool coats require near-daily combing to prevent matting. The breed sets the schedule.</p>
          </div>
          <div class="category-hub__link-card">
            <span aria-hidden="true">🛁</span>
            <strong>Bathing frequency varies</strong>
            <p>Most dogs need bathing every 4–8 weeks. Too often strips natural oils; too rarely allows odour and debris to build. Active dogs and heavy coats may need more.</p>
          </div>
          <div class="category-hub__link-card">
            <span aria-hidden="true">🪮</span>
            <strong>Tools need to match coat</strong>
            <p>A slicker brush, metal comb, undercoat rake and high-velocity dryer each serve different purposes. Using the wrong tool on the wrong coat adds time and risks coat damage.</p>
          </div>
          <div class="category-hub__link-card">
            <span aria-hidden="true">💇</span>
            <strong>Professional vs DIY decision</strong>
            <p>Doodles, Poodles and long-coated breeds benefit from professional grooming every 6–8 weeks. Short-coated breeds can be maintained entirely at home with basic tools.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Resource strip: quick links -->
    <section class="grooming-resource-strip">
      <div class="category-hub__container">
        <div class="grooming-resource-grid">
          <a href="/breeds" class="grooming-resource-card">
            <p class="grooming-resource-card__eyebrow">By breed</p>
            <strong>Breed Profiles</strong>
            <p>Every breed page includes coat type, shedding level, grooming difficulty, and professional care frequency.</p>
            <span aria-hidden="true">→</span>
          </a>
          <a href="/cost-calculator" class="grooming-resource-card">
            <p class="grooming-resource-card__eyebrow">Grooming budget</p>
            <strong>Cost Calculator</strong>
            <p>Estimate annual grooming costs — including professional sessions — by breed coat type.</p>
            <span aria-hidden="true">→</span>
          </a>
          <a href="/categories/training" class="grooming-resource-card">
            <p class="grooming-resource-card__eyebrow">Handling training</p>
            <strong>Training basics</strong>
            <p>Dogs that tolerate grooming tools and bathing need early handling training — a foundation skill for all breeds.</p>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    {breedChips.length >= 3 && (
      <section class="category-hub__strip" aria-label={`${meta.title} breed shortcuts`}>
        <div class="category-hub__container">
          <div class="category-hub__strip-header">
            <p>{meta.title} by breed</p>
            <a href="/breeds">All breeds →</a>
          </div>
          <div class="category-hub__chip-row">
            {breedChips.map((breed) => (
              <a href={breed.href}>{breed.name}</a>
            ))}
          </div>
        </div>
      </section>
    )}

    <CategoryBreedGuides
      meta={meta}
      guides={featuredBreedGuides}
      contextDesc="Browse breed grooming profiles — each card links to coat type, shedding level, grooming frequency, and recommended tool guidance for your specific breed."
    />

    <CategoryOwnerResources
      meta={meta}
      categorySlug={categorySlug}
      links={categoryLinks}
      tags={awinTags.secondary}
    />

    {featuredPosts.length > 0 && (
      <CategoryArticleGrid
        meta={meta}
        posts={featuredPosts}
        supportingPosts={supportingPosts}
        totalCount={catPosts.length}
      />
    )}

    <CategoryPartnerBlock meta={meta} categorySlug={categorySlug} tags={awinTags.primary} />
    <CategoryAmazonBlock meta={meta} categorySlug={categorySlug} />

    <CategoryRelatedTopics meta={meta} cards={relatedCards} />

    {featuredPosts.length === 0 && featuredBreedGuides.length === 0 && (
      <CategoryEmptyState meta={meta} />
    )}
  </div>
</BaseLayout>
