---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

const editorialPosts = allPosts
  .filter((p) => !p.data.generated && p.data.indexInBlog !== false)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 6);

const topicCards = [
  { slug: 'dog-food',   title: 'Food & Nutrition',   icon: '🍖', desc: 'Feeding guides, ingredient comparisons and food decisions by breed size and life stage.',    href: '/categories/dog-food' },
  { slug: 'training',   title: 'Training & Behaviour',icon: '🦮', desc: 'Reward-based training, recall, socialisation and gear matched to breed temperament.',        href: '/categories/training' },
  { slug: 'grooming',   title: 'Grooming',            icon: '✂️', desc: 'Brush schedules, deshedding, coat care tools and bathing routines by coat type.',            href: '/categories/grooming' },
  { slug: 'beds',       title: 'Beds & Comfort',      icon: '🛏️', desc: 'Bed sizing, orthopedic foam, washable covers and sleep setup for every breed size.',         href: '/categories/beds' },
  { slug: 'health',     title: 'Health & Vet Care',   icon: '🩺', desc: 'Preventive care, breed health concerns, wellness planning and vet cost guidance.',           href: '/categories/health' },
  { slug: 'insurance',  title: 'Pet Insurance',       icon: '🛡️', desc: 'Insurance timing, breed exclusions, waiting periods and plan comparison by cover type.',    href: '/pet-insurance' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pupwiki.com/' },
    { '@type': 'ListItem', position: 2, name: 'Guides' },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How do I choose the right dog for my home?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Start with energy level and space: high-energy breeds like Border Collies and Siberian Huskies need 60–90 minutes of daily exercise and do best with outdoor access. Lower-energy breeds like Bulldogs or Basset Hounds suit apartment living better. Use the PupWiki Breed Suitability Quiz to match a breed to your specific situation.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the monthly cost of owning a dog?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Monthly dog ownership costs range from $150 to $500+ depending on breed size, health, and lifestyle. Food for a large breed costs $60–$90/month; vet care averages $50–$100/month when budgeted annually; grooming adds $30–$80 for coated breeds. Use the PupWiki Breed Cost Calculator for breed-specific estimates.',
      },
    },
    {
      '@type': 'Question',
      name: 'When should I start training my puppy?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Start training from the day your puppy arrives home, typically at 8 weeks. The 8–16 week window is the most sensitive socialisation period — enrol in a puppy class within the first two weeks for structured exposure to people, dogs, and environments. Basic cues (sit, stay, come) can be introduced from 8 weeks using reward-based methods.',
      },
    },
  ],
};
---

<BaseLayout
  title="Dog Care Guides — PupWiki In-Depth Resources"
  description="In-depth dog care guides on food, training, grooming, beds, health and insurance. Matched to breed size, energy level and life stage."
  canonicalUrl="https://pupwiki.com/guides"
  pageType="collection"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} slot="head" />

  <div class="guides-index">
    <div class="container">

      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item">
            <a href="/" class="breadcrumb__link">Home</a>
            <span class="breadcrumb__sep" aria-hidden="true">›</span>
          </li>
          <li class="breadcrumb__item">
            <span class="breadcrumb__current" aria-current="page">Guides</span>
          </li>
        </ol>
      </nav>

      <header class="guides-index__header">
        <h1 class="guides-index__title">Dog Care Guides</h1>
        <p class="guides-index__lead">
          In-depth guides on food, training, grooming, beds, health and insurance — matched to breed
          size, energy level and life stage. Research-backed and updated regularly.
        </p>
      </header>

      <section aria-labelledby="guides-topics-title">
        <h2 id="guides-topics-title" class="guides-index__section-heading">Browse by Topic</h2>
        <div class="guides-index__grid">
          {topicCards.map((card) => (
            <a href={card.href} class="guides-index__card">
              <span class="guides-index__card-icon" aria-hidden="true">{card.icon}</span>
              <div class="guides-index__card-body">
                <h3 class="guides-index__card-title">{card.title}</h3>
                <p class="guides-index__card-desc">{card.desc}</p>
              </div>
              <span class="guides-index__card-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>

      {editorialPosts.length > 0 && (
        <section aria-labelledby="guides-featured-title" class="guides-index__section">
          <h2 id="guides-featured-title" class="guides-index__section-heading">Featured Guides</h2>
          <div class="guides-index__article-grid">
            {editorialPosts.map((post) => (
              <a href={`/blog/${post.slug}`} class="guides-index__article-card">
                <div class="guides-index__article-body">
                  {post.data.category && (
                    <span class="guides-index__article-tag">{post.data.category}</span>
                  )}
                  <h3 class="guides-index__article-title">{post.data.title}</h3>
                  {post.data.description && (
                    <p class="guides-index__article-desc">{post.data.description}</p>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section aria-labelledby="guides-tools-title" class="guides-index__section">
        <h2 id="guides-tools-title" class="guides-index__section-heading">Planning Tools</h2>
        <div class="guides-index__tools-grid">
          <a href="/breeds" class="guides-index__tool-card">
            <span class="guides-index__tool-icon" aria-hidden="true">🐾</span>
            <div>
              <strong class="guides-index__tool-title">Browse All Breeds</strong>
              <p class="guides-index__tool-desc">Compare 277 breed profiles with care requirements, costs and trait data.</p>
            </div>
          </a>
          <a href="/cost-calculator" class="guides-index__tool-card">
            <span class="guides-index__tool-icon" aria-hidden="true">💰</span>
            <div>
              <strong class="guides-index__tool-title">Breed Cost Calculator</strong>
              <p class="guides-index__tool-desc">Estimate monthly and annual ownership costs by breed, size, age and state.</p>
            </div>
          </a>
          <a href="/dog-names" class="guides-index__tool-card">
            <span class="guides-index__tool-icon" aria-hidden="true">✍️</span>
            <div>
              <strong class="guides-index__tool-title">Dog Name Generator</strong>
              <p class="guides-index__tool-desc">Find breed-matched name ideas across 352 breed guides and 5,000+ entries.</p>
            </div>
          </a>
          <a href="/breed-quiz" class="guides-index__tool-card">
            <span class="guides-index__tool-icon" aria-hidden="true">🧩</span>
            <div>
              <strong class="guides-index__tool-title">Breed Suitability Quiz</strong>
              <p class="guides-index__tool-desc">Answer 8 questions about your home and lifestyle to get matched breeds.</p>
            </div>
          </a>
        </div>
      </section>

      <section aria-labelledby="guides-faq-title" class="guides-index__section">
        <h2 id="guides-faq-title" class="guides-index__section-heading">Common Dog Ownership Questions</h2>
        <div class="guides-index__faq">
          <details class="guides-index__faq-item">
            <summary class="guides-index__faq-q">How do I choose the right dog for my home?</summary>
            <p class="guides-index__faq-a">Start with energy level and space: high-energy breeds like Border Collies and Siberian Huskies need 60–90 minutes of daily exercise and do best with outdoor access. Lower-energy breeds like Bulldogs or Basset Hounds suit apartment living better. Use the <a href="/breed-quiz">Breed Suitability Quiz</a> to match a breed to your specific situation.</p>
          </details>
          <details class="guides-index__faq-item">
            <summary class="guides-index__faq-q">What is the monthly cost of owning a dog?</summary>
            <p class="guides-index__faq-a">Monthly costs range from $150 to $500+ depending on breed size, health, and lifestyle. Food for a large breed costs $60–$90/month; vet care averages $50–$100/month when budgeted annually; grooming adds $30–$80 for coated breeds. Use the <a href="/cost-calculator">Breed Cost Calculator</a> for breed-specific estimates.</p>
          </details>
          <details class="guides-index__faq-item">
            <summary class="guides-index__faq-q">When should I start training my puppy?</summary>
            <p class="guides-index__faq-a">Start from the day your puppy arrives home, typically at 8 weeks. The 8–16 week window is the most sensitive socialisation period — enrol in a puppy class within the first two weeks for structured exposure to people, dogs, and environments. Basic cues (sit, stay, come) can begin at 8 weeks using reward-based methods.</p>
          </details>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>

<style>
.guides-index {
  padding-block: var(--space-10);
}

.guides-index .container {
  max-width: 1100px;
  margin-inline: auto;
  padding-inline: var(--space-4);
}

.guides-index__header {
  margin-block: var(--space-6) var(--space-8);
}

.guides-index__title {
  font-family: var(--font-display);
  font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
  color: var(--color-heading);
  margin-block-end: var(--space-3);
}

.guides-index__lead {
  max-width: 62ch;
  color: var(--color-body-soft);
  font-size: var(--text-base);
  line-height: 1.65;
}

.guides-index__section {
  margin-block-start: var(--space-10);
}

.guides-index__section-heading {
  font-family: var(--font-heading);
  font-size: var(--text-xl);
  color: var(--color-heading);
  margin-block-end: var(--space-4);
  padding-block-end: var(--space-2);
  border-block-end: 2px solid var(--color-border);
}

.guides-index__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: var(--space-4);
}

.guides-index__card {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  padding: var(--space-4);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  text-decoration: none;
  transition: border-color var(--transition-base), box-shadow var(--transition-base);
}

.guides-index__card:hover {
  border-color: var(--color-accent);
  box-shadow: var(--shadow-md);
}

.guides-index__card-icon {
  font-size: 1.75rem;
  line-height: 1;
  flex-shrink: 0;
}

.guides-index__card-body {
  flex: 1;
  min-width: 0;
}

.guides-index__card-title {
  font-family: var(--font-heading);
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  color: var(--color-heading);
  margin-block-end: var(--space-1);
}

.guides-index__card-desc {
  font-size: var(--text-sm);
  color: var(--color-body-soft);
  line-height: 1.55;
}

.guides-index__card-arrow {
  color: var(--color-accent);
  font-size: var(--text-lg);
  flex-shrink: 0;
  align-self: center;
}

.guides-index__article-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: var(--space-4);
}

.guides-index__article-card {
  display: block;
  padding: var(--space-4);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  text-decoration: none;
  transition: border-color var(--transition-base), box-shadow var(--transition-base);
}

.guides-index__article-card:hover {
  border-color: var(--color-accent);
  box-shadow: var(--shadow-md);
}

.guides-index__article-tag {
  display: inline-block;
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-accent);
  margin-block-end: var(--space-1);
}

.guides-index__article-title {
  font-family: var(--font-heading);
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  color: var(--color-heading);
  margin-block-end: var(--space-1);
  line-height: 1.4;
}

.guides-index__article-desc {
  font-size: var(--text-sm);
  color: var(--color-body-soft);
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.guides-index__tools-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: var(--space-4);
}

.guides-index__tool-card {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  padding: var(--space-4);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  text-decoration: none;
  transition: border-color var(--transition-base), box-shadow var(--transition-base);
}

.guides-index__tool-card:hover {
  border-color: var(--color-accent);
  box-shadow: var(--shadow-md);
}

.guides-index__tool-icon {
  font-size: 1.5rem;
  line-height: 1;
  flex-shrink: 0;
}

.guides-index__tool-title {
  display: block;
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-heading);
  margin-block-end: var(--space-1);
}

.guides-index__tool-desc {
  font-size: var(--text-sm);
  color: var(--color-body-soft);
  line-height: 1.55;
  margin: 0;
}

.guides-index__faq {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.guides-index__faq-item {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}

.guides-index__faq-q {
  display: block;
  padding: var(--space-4);
  font-family: var(--font-heading);
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  color: var(--color-heading);
  cursor: pointer;
  list-style: none;
}

.guides-index__faq-q::-webkit-details-marker {
  display: none;
}

.guides-index__faq-q::before {
  content: '+';
  display: inline-block;
  width: 1.2em;
  color: var(--color-accent);
  font-weight: var(--weight-bold);
}

details[open] .guides-index__faq-q::before {
  content: '−';
}

.guides-index__faq-a {
  padding: 0 var(--space-4) var(--space-4);
  font-size: var(--text-sm);
  color: var(--color-body-soft);
  line-height: 1.65;
  margin: 0;
}

.guides-index__faq-a a {
  color: var(--color-accent);
  text-decoration: underline;
}

@media (max-width: 768px) {
  .guides-index__grid,
  .guides-index__article-grid,
  .guides-index__tools-grid {
    grid-template-columns: 1fr;
  }
}

.breadcrumb {
  padding-block: var(--space-3);
}
.breadcrumb__list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-1);
  list-style: none;
  padding: 0;
  margin: 0;
}
.breadcrumb__item {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
}
.breadcrumb__link {
  font-size: var(--text-sm);
  color: var(--color-muted);
  text-decoration: none;
  transition: color var(--transition-base);
}
.breadcrumb__link:hover {
  color: var(--color-heading);
}
.breadcrumb__current {
  font-size: var(--text-sm);
  color: var(--color-body-soft);
  font-weight: var(--weight-medium);
}
.breadcrumb__sep {
  color: var(--color-placeholder);
  font-size: var(--text-sm);
}
</style>
