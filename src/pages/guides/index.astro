---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('guides');

const editorialPosts = allPosts
  .filter((p) => !p.data.generated && p.data.indexInGuides !== false)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 12);

const [featuredPost, ...gridPosts] = editorialPosts;

function getCatColor(category: string): string {
  const map: Record<string, string> = {
    'Dog Food': 'food', 'Food': 'food',
    'Grooming': 'grooming',
    'Health': 'health', 'Pet Insurance': 'health', 'Insurance': 'health', 'Supplements': 'supplements',
    'Training': 'training', 'Gear': 'training',
    'Toys': 'toys',
    'Beds': 'beds', 'Lifestyle': 'lifestyle',
  };
  return map[category] || 'default';
}

const topicCards = [
  { title: 'Food & Nutrition',     icon: '🍖', desc: 'Feeding guides and breed-matched nutrition advice.',       href: '/categories/dog-food',  color: 'food'     },
  { title: 'Training & Behaviour', icon: '🦮', desc: 'Reward-based training and gear matched to temperament.',  href: '/categories/training',  color: 'training' },
  { title: 'Grooming',             icon: '✂️', desc: 'Coat care tools and bathing routines by coat type.',      href: '/categories/grooming',  color: 'grooming' },
  { title: 'Beds & Comfort',       icon: '🛏️', desc: 'Bed sizing and sleep setup for every breed size.',        href: '/categories/beds',      color: 'beds'     },
  { title: 'Health & Vet Care',    icon: '🩺', desc: 'Preventive care, breed health and wellness planning.',    href: '/categories/health',    color: 'health'   },
  { title: 'Pet Insurance',        icon: '🛡️', desc: 'Insurance timing, exclusions and plan comparison.',       href: '/pet-insurance',        color: 'health'   },
  { title: 'Toys & Enrichment',    icon: '🎾', desc: 'Interactive toys and enrichment matched to breed drive.', href: '/categories/toys',      color: 'toys'     },
  { title: 'Lifestyle & Gear',     icon: '🎒', desc: 'Harnesses, travel gear and everyday accessories.',        href: '/categories/lifestyle', color: 'lifestyle'},
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pupwiki.com/' },
    { '@type': 'ListItem', position: 2, name: 'Guides' },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How do I choose the right dog for my home?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Start with energy level and space: high-energy breeds like Border Collies and Siberian Huskies need 60–90 minutes of daily exercise and do best with outdoor access. Lower-energy breeds like Bulldogs or Basset Hounds suit apartment living better. Use the PupWiki Breed Suitability Quiz to match a breed to your specific situation.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the monthly cost of owning a dog?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Monthly dog ownership costs range from $150 to $500+ depending on breed size, health, and lifestyle. Food for a large breed costs $60–$90/month; vet care averages $50–$100/month when budgeted annually; grooming adds $30–$80 for coated breeds. Use the PupWiki Breed Cost Calculator for breed-specific estimates.',
      },
    },
    {
      '@type': 'Question',
      name: 'When should I start training my puppy?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Start training from the day your puppy arrives home, typically at 8 weeks. The 8–16 week window is the most sensitive socialisation period — enrol in a puppy class within the first two weeks for structured exposure to people, dogs, and environments. Basic cues (sit, stay, come) can be introduced from 8 weeks using reward-based methods.',
      },
    },
  ],
};
import '../../styles/pages/guides-hub.css';
---

<BaseLayout
  title="Dog Care Guides — PupWiki In-Depth Resources"
  description="In-depth dog care guides on food, training, grooming, beds, health and insurance. Matched to breed size, energy level and life stage."
  canonicalUrl="https://pupwiki.com/guides"
  pageType="collection"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} slot="head" />

  <div class="gp">

    <!-- ── HERO ── -->
    <header class="gp-hero">
      <div class="gp-container">
        <nav aria-label="Breadcrumb" class="gp-breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-hidden="true">›</li>
            <li><span aria-current="page">Guides</span></li>
          </ol>
        </nav>
        <div class="gp-hero__body">
          <h1 class="gp-hero__title"><em>Dog Care</em> Guides</h1>
          <p class="gp-hero__lead">
            In-depth guides on food, training, grooming, beds, health and insurance —
            matched to breed size, energy level and life stage.
          </p>
          <div class="gp-hero__ctas">
            <a href="/guides/first-dog" class="gp-btn gp-btn--primary">Your first dog →</a>
            <a href="/breeds" class="gp-btn gp-btn--outline">Browse all breeds</a>
          </div>
        </div>
      </div>
    </header>

    <!-- ── TOPIC CATEGORIES ── -->
    <section class="gp-section gp-topics" aria-labelledby="gp-topics-title">
      <div class="gp-container">
        <h2 id="gp-topics-title" class="gp-section-title">Browse by Topic</h2>
        <div class="gp-topics__grid">
          {topicCards.map((card) => (
            <a href={card.href} class={`gp-topic-card gp-topic-card--${card.color}`}>
              <span class="gp-topic-card__icon" aria-hidden="true">{card.icon}</span>
              <div class="gp-topic-card__body">
                <strong class="gp-topic-card__title">{card.title}</strong>
                <p class="gp-topic-card__desc">{card.desc}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ── FEATURED GUIDES ── -->
    <section class="gp-section gp-editorial" aria-labelledby="gp-editorial-title">
      <div class="gp-container">
        <div class="gp-editorial__header">
          <h2 id="gp-editorial-title" class="gp-section-title">Featured Guides</h2>
          <a href="/guides/first-dog" class="gp-section-link">First dog guide →</a>
        </div>

        <!-- First Dog callout -->
        <a href="/guides/first-dog" class="gp-firstdog">
          <div class="gp-firstdog__body">
            <span class="gp-firstdog__label">Getting started</span>
            <strong class="gp-firstdog__title">New to dogs? Start here →</strong>
            <p class="gp-firstdog__desc">
              Find the right breed, plan real costs, prepare your home and train from day one —
              a complete first-dog walkthrough.
            </p>
          </div>
          <div class="gp-firstdog__icon" aria-hidden="true">🐶</div>
        </a>

        <!-- Hero editorial card (first/newest editorial post) -->
        {featuredPost && (
          <a href={`/guides/${featuredPost.slug}`} class="gp-hero-card">
            <div class={`gp-hero-card__image-wrap gp-hero-card__image-wrap--${getCatColor(featuredPost.data.category ?? '')}`}>
              {featuredPost.data.heroImage && (
                <img
                  src={featuredPost.data.heroImage}
                  alt={featuredPost.data.heroImageAlt || featuredPost.data.title}
                  loading="lazy"
                  decoding="async"
                  class="gp-hero-card__image"
                />
              )}
            </div>
            <div class="gp-hero-card__body">
              {featuredPost.data.category && (
                <span class="gp-tag">{featuredPost.data.category}</span>
              )}
              <h3 class="gp-hero-card__title">{featuredPost.data.title}</h3>
              {featuredPost.data.description && (
                <p class="gp-hero-card__desc">{featuredPost.data.description}</p>
              )}
              <span class="gp-read-more">Read guide →</span>
            </div>
          </a>
        )}

        <!-- Grid of remaining editorial posts -->
        {gridPosts.length > 0 && (
          <div class="gp-article-grid">
            {gridPosts.map((post) => (
              <a href={`/guides/${post.slug}`} class="gp-article-card">
                <div class={`gp-article-card__image-wrap gp-article-card__image-wrap--${getCatColor(post.data.category ?? '')}`}>
                  {post.data.heroImage && (
                    <img
                      src={post.data.heroImage}
                      alt={post.data.heroImageAlt || post.data.title}
                      loading="lazy"
                      decoding="async"
                      class="gp-article-card__image"
                    />
                  )}
                </div>
                <div class="gp-article-card__body">
                  {post.data.category && (
                    <span class="gp-tag">{post.data.category}</span>
                  )}
                  <h3 class="gp-article-card__title">{post.data.title}</h3>
                  {post.data.description && (
                    <p class="gp-article-card__desc">{post.data.description}</p>
                  )}
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- ── PLANNING TOOLS (dark band) ── -->
    <section class="gp-section gp-tools" aria-labelledby="gp-tools-title">
      <div class="gp-container">
        <h2 id="gp-tools-title" class="gp-section-title gp-section-title--light">Planning Tools</h2>
        <div class="gp-tools__grid">
          <a href="/breeds" class="gp-tool-card">
            <span class="gp-tool-card__icon" aria-hidden="true">🐾</span>
            <div>
              <strong class="gp-tool-card__title">Browse All Breeds</strong>
              <p class="gp-tool-card__desc">Compare 277 breed profiles with care requirements, costs and trait data.</p>
            </div>
          </a>
          <a href="/cost-calculator" class="gp-tool-card">
            <span class="gp-tool-card__icon" aria-hidden="true">💰</span>
            <div>
              <strong class="gp-tool-card__title">Breed Cost Calculator</strong>
              <p class="gp-tool-card__desc">Estimate monthly and annual ownership costs by breed, size, age and state.</p>
            </div>
          </a>
          <a href="/dog-names" class="gp-tool-card">
            <span class="gp-tool-card__icon" aria-hidden="true">✍️</span>
            <div>
              <strong class="gp-tool-card__title">Dog Name Generator</strong>
              <p class="gp-tool-card__desc">Breed-matched name ideas across 352 breed guides and 5,000+ entries.</p>
            </div>
          </a>
          <a href="/tools/breed-match" class="gp-tool-card">
            <span class="gp-tool-card__icon" aria-hidden="true">🧩</span>
            <div>
              <strong class="gp-tool-card__title">Breed Suitability Quiz</strong>
              <p class="gp-tool-card__desc">Answer 8 questions about your home and lifestyle to get matched breeds.</p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- ── FAQ ── -->
    <section class="gp-section gp-faq" aria-labelledby="gp-faq-title">
      <div class="gp-container">
        <h2 id="gp-faq-title" class="gp-section-title">Common Dog Ownership Questions</h2>
        <div class="gp-faq__list">
          <details class="gp-faq__item">
            <summary class="gp-faq__q">How do I choose the right dog for my home?</summary>
            <p class="gp-faq__a">Start with energy level and space: high-energy breeds like Border Collies and Siberian Huskies need 60–90 minutes of daily exercise and do best with outdoor access. Lower-energy breeds like Bulldogs or Basset Hounds suit apartment living better. Use the <a href="/tools/breed-match">Breed Suitability Quiz</a> to match a breed to your specific situation.</p>
          </details>
          <details class="gp-faq__item">
            <summary class="gp-faq__q">What is the monthly cost of owning a dog?</summary>
            <p class="gp-faq__a">Monthly costs range from $150 to $500+ depending on breed size, health, and lifestyle. Food for a large breed costs $60–$90/month; vet care averages $50–$100/month when budgeted annually; grooming adds $30–$80 for coated breeds. Use the <a href="/cost-calculator">Breed Cost Calculator</a> for breed-specific estimates.</p>
          </details>
          <details class="gp-faq__item">
            <summary class="gp-faq__q">When should I start training my puppy?</summary>
            <p class="gp-faq__a">Start from the day your puppy arrives home, typically at 8 weeks. The 8–16 week window is the most sensitive socialisation period — enrol in a puppy class within the first two weeks for structured exposure. Basic cues (sit, stay, come) can begin at 8 weeks using reward-based methods.</p>
          </details>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
