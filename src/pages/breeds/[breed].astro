---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildBreedPageModel } from '../../lib/breeds/breedPageData';
import { getBreedStaticPaths } from '../../lib/breeds/breedDataAdapter';
import type { IconName } from '../../components/ui/Icon.astro';

import BreedHero from '../../components/breed-detail/BreedHero.astro';
import BreedQuickVerdict from '../../components/breed-detail/BreedQuickVerdict.astro';
import BreedAtAGlance from '../../components/breed-detail/BreedAtAGlance.astro';
import BreedBestFor from '../../components/breed-detail/BreedBestFor.astro';
import BreedOwnerFitCards from '../../components/breed-detail/BreedOwnerFitCards.astro';
import BreedCostSnapshot from '../../components/breed-detail/BreedCostSnapshot.astro';
import BreedTraitDeepDive from '../../components/breed-detail/BreedTraitDeepDive.astro';
import BreedHealthWatch from '../../components/breed-detail/BreedHealthWatch.astro';
import BreedCareOverview from '../../components/breed-detail/BreedCareOverview.astro';
import BreedTrainingBehavior from '../../components/breed-detail/BreedTrainingBehavior.astro';
import BreedFeedingGrooming from '../../components/breed-detail/BreedFeedingGrooming.astro';
import BreedToolsCta from '../../components/breed-detail/BreedToolsCta.astro';
import BreedFaqSection from '../../components/breed-detail/BreedFaqSection.astro';
import BreedSimilarCompare from '../../components/breed-detail/BreedSimilarCompare.astro';
import BreedRelatedGuides from '../../components/breed-detail/BreedRelatedGuides.astro';
import BreedSidebar from '../../components/breed-detail/BreedSidebar.astro';
import BreedCommerceSuite from '../../components/breed/BreedCommerceSuite.astro';

export function getStaticPaths() {
  return getBreedStaticPaths();
}

const { breed: slug } = Astro.params;
const model = buildBreedPageModel(slug);
if (!model) return Astro.redirect('/breeds');

const {
  breed, signals, verdict, bestFor, ownerFitCards, seo, schema,
  healthProfile, enrichmentData, faqItems, similarBreeds,
  resourceItems, partnerClusterLinks, links, safeLifespanYears,
} = model;

const b = breed.raw;
const isCrossbreed = breed.isCrossbreed;

const CLUSTER_LINKS: Array<{ key: string; href: string; icon: IconName; label: string }> = [
  { key: 'food_post',       href: links.food_post       ?? '/categories/dog-food',  icon: 'food',        label: `${b.name} food & nutrition guide` },
  { key: 'toy_post',        href: links.toy_post        ?? '/categories/lifestyle', icon: 'toys',        label: `${b.name} toy & enrichment ideas` },
  { key: 'names_page',      href: links.names_page      ?? `/dog-names/${slug}`,    icon: 'names',       label: `${b.name} names` },
  { key: 'bed_post',        href: links.bed_post        ?? '/categories/lifestyle', icon: 'beds',        label: `${b.name} bed & sleep guide` },
  { key: 'grooming_post',   href: links.grooming_post   ?? '/categories/grooming',  icon: 'grooming',    label: `${b.name} grooming guide` },
  { key: 'health_post',     href: links.health_post     ?? '/categories/health',    icon: 'health',      label: `${b.name} health concerns` },
  { key: 'puppy_post',      href: `/breeds/${slug}/puppy`,                          icon: 'puppy',       label: `${b.name} puppy guide` },
  { key: 'supplement_post', href: links.supplement_post ?? '/categories/health',    icon: 'supplements', label: `${b.name} supplement considerations` },
  { key: 'training_post',   href: links.training_post   ?? '/categories/training',  icon: 'training',    label: `${b.name} training guide` },
];

const awinBaseTags = [
  b.size_category, b.energy_level, b.training_level, b.coat_type, b.akc_group,
  isCrossbreed ? 'mixed-breed' : 'purebred',
  breed.flags.isWorkingHeritage ? 'working-dog' : null,
  breed.flags.isApartmentFriendly ? 'apartment' : 'outdoor-space',
  'breed', 'dog-owners',
].filter(Boolean) as string[];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalUrl={seo.canonicalUrl}
  pageType="profile"
  ogImage={breed.primaryImage || undefined}
  ogImageAlt={`${b.name} dog breed guide`}
>
  <script type="application/ld+json" set:html={schema.articleLd} />
  <script type="application/ld+json" set:html={schema.breadcrumbLd} />
  {schema.faqLd && <script type="application/ld+json" set:html={schema.faqLd} />}

  <main class="breed-page">
    <BreedHero breed={breed} signals={signals} links={links} safeLifespanYears={safeLifespanYears} slug={slug} />

    <nav class="breed-page-nav" aria-label="Jump to section">
      <div class="breed-container">
        <div class="breed-page-nav__links">
          <a href="#breed-overview" class="breed-page-nav__link">Overview</a>
          {b.description && <a href="#breed-about" class="breed-page-nav__link">About</a>}
          <a href="#breed-traits" class="breed-page-nav__link">Traits</a>
          <a href="#breed-health" class="breed-page-nav__link">Health</a>
          {Array.isArray(b.care_tips) && b.care_tips.length > 0 && (
            <a href="#breed-care" class="breed-page-nav__link">Care</a>
          )}
          <a href="#breed-guides" class="breed-page-nav__link">Guides</a>
        </div>
      </div>
    </nav>

    <div class="breed-container" aria-hidden="true">
      <div class="ad-slot">
        <ins class="adsbygoogle"
          style="display:block; min-height:90px; width:100%"
          data-ad-client="ca-pub-4011000703937954"
          data-ad-slot="auto"
          data-ad-format="auto"
          data-full-width-responsive="true"
        ></ins>
        <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
      </div>
    </div>

    <BreedQuickVerdict verdict={verdict} />

    <div class="breed-container breed-main">
      <div class="breed-layout">
        <div class="breed-content">
          <BreedAtAGlance breed={breed} safeLifespanYears={safeLifespanYears} />
          <BreedBestFor bestFor={bestFor} breedName={breed.name} />
          <BreedOwnerFitCards cards={ownerFitCards} />
          <BreedCostSnapshot breed={breed} signals={signals} slug={slug} />
          <BreedTraitDeepDive breed={breed} />
          <BreedHealthWatch healthProfile={healthProfile} breed={breed} slug={slug} />
          <BreedCareOverview breed={breed} signals={signals} enrichmentData={enrichmentData} />
          <BreedTrainingBehavior breed={breed} signals={signals} />
          <BreedFeedingGrooming breed={breed} signals={signals} />
          <BreedToolsCta breed={breed} slug={slug} />
          <BreedFaqSection faqItems={faqItems} breed={breed} slug={slug} />
          <BreedSimilarCompare similarBreeds={similarBreeds} breedName={breed.name} />
          <BreedRelatedGuides breed={breed} clusterLinks={CLUSTER_LINKS} links={links} />
          <div id="breed-products">
            <BreedCommerceSuite
              breedName={b.name}
              breedSlug={slug}
              breedSize={b.size_category}
              breedEnergy={b.energy_level}
              breedTraining={b.training_level}
              breedCoat={b.coat_type}
              topicTags={awinBaseTags}
              partnerClusters={partnerClusterLinks}
            />
          </div>
        </div>
        <BreedSidebar
          breed={breed}
          resourceItems={resourceItems}
          partnerClusterLinks={partnerClusterLinks}
          safeLifespanYears={safeLifespanYears}
          clusterLinks={CLUSTER_LINKS}
          slug={slug}
        />
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  (() => {
    const KEY = 'pupwiki:breed-shortlist:v1';
    function readList(): { slug: string; name: string }[] {
      try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; }
    }
    function writeList(list: { slug: string; name: string }[]) {
      try { localStorage.setItem(KEY, JSON.stringify(list)); } catch {}
    }
    const btn = document.querySelector<HTMLButtonElement>('.js-shortlist-btn');
    if (!btn) return;
    const slug = btn.dataset.slug!;
    const name = btn.dataset.name!;
    function syncBtn() {
      const saved = readList().some(x => x.slug === slug);
      btn.textContent = saved ? '✓ Saved' : '♡ Save breed';
      btn.classList.toggle('is-saved', saved);
    }
    syncBtn();
    btn.addEventListener('click', () => {
      let list = readList();
      const idx = list.findIndex(x => x.slug === slug);
      if (idx === -1) { list.push({ slug, name }); } else { list.splice(idx, 1); }
      writeList(list);
      syncBtn();
    });
  })();

  (() => {
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.breed-page-nav__link');
    if (!navLinks.length) return;
    const sectionIds = ['breed-overview', 'breed-about', 'breed-care', 'breed-traits', 'breed-health', 'breed-guides', 'breed-products'];
    const sections = sectionIds.map(id => document.getElementById(id)).filter((el): el is HTMLElement => el !== null);
    if (!sections.length) return;
    const setActive = (id: string) => {
      navLinks.forEach(link => link.classList.toggle('is-active', link.getAttribute('href') === `#${id}`));
    };
    if (sections[0]) setActive(sections[0].id);
    const observer = new IntersectionObserver(
      (entries) => { for (const entry of entries) { if (entry.isIntersecting) setActive(entry.target.id); } },
      { rootMargin: '-15% 0px -75% 0px', threshold: 0 },
    );
    sections.forEach(s => observer.observe(s));
  })();
</script>
